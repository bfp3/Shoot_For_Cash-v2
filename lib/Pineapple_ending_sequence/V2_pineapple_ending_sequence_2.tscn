[sub_resource type="GDScript" id="GDScript_sr0ha"]
script/source = "extends Control

const SFX_DOT_1 = preload(\"res://sfx/sfx_dot_1.wav\")
const SFX_DOT_2 = preload(\"res://sfx/sfx_dot_2.wav\")
const SFX_DOT_3 = preload(\"res://sfx/sfx_dot_3.wav\")

@onready var sfx: Node = $\"../SFX\"

@onready var dot: Control = $Dot
@onready var dot_2: Control = $Dot2
@onready var dot_3: Control = $Dot3

func colour_outline() -> void:
	var colour = Color('f5e10a82')
	
	$Dot/Outline.modulate = colour
	$Dot2/Outline.modulate = colour
	$Dot3/Outline.modulate = colour

func _ready() -> void:
	#
	#colour_outline()
	#
	#modulate = Color('FFFFFF00')
	dot.modulate = Color('FFFFFF00')
	dot_2.modulate = Color('FFFFFF00')
	dot_3.modulate = Color('FFFFFF00')
	#
	dot.scale = Vector2.ONE * 3
	dot_2.scale = Vector2.ONE * 3
	dot_3.scale = Vector2.ONE * 3

	$Smoke_sprite.hide()

func first_phase() -> void:
	modulate = Color('FFFFFF')
	
	await get_tree().create_timer(0.6).timeout
	#$\"../SFX/Telegraph_sound\".play()
	
	fade_in_tween(dot_2)
	sfx.play_sound(SFX_DOT_2)
	await get_tree().create_timer(1.0).timeout
	$Smoke_sprite.show()
	$Smoke_sprite.play(\"default\")
	separate_tween_left()
	sfx.play_sound(SFX_DOT_1)
	separate_tween_right()
	sfx.play_sound(SFX_DOT_3)
	
	#await get_tree().create_timer(1.1).timeout
	

func separate_tween_left() -> void:
	
	var new_dot = dot_2.duplicate()
	add_child(new_dot)
	var tween = create_tween().set_trans(Tween.TRANS_CUBIC)
	tween.tween_property(new_dot, \"modulate\", Color('FFFFFF'), 0.25)
	tween.parallel().tween_property(new_dot, \"position\", dot.position, 0.5)
	await tween.finished
	$Smoke_sprite2.show()
	$Smoke_sprite2.play(\"default\")
	
func fade_out_tween() -> void:
	var tween = create_tween().set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT)
	tween.tween_property(self, \"modulate\", Color('FFFFFF00'), 0.5)
	await tween.finished
	#finished()

func separate_tween_right() -> void:
	
	var new_dot = dot_2.duplicate()
	add_child(new_dot)
	var tween = create_tween().set_trans(Tween.TRANS_CUBIC)
	tween.tween_property(new_dot, \"modulate\", Color('FFFFFF'), 0.25)
	tween.parallel().tween_property(new_dot, \"position\", dot_3.position, 0.5)
	await tween.finished
	$Smoke_sprite3.show()
	$Smoke_sprite3.play(\"default\")
	finished()
	
func fade_in_tween(current_dot : Control) -> void:
	
	var tween = create_tween().set_trans(Tween.TRANS_CUBIC)
	tween.tween_property(current_dot, \"modulate\", Color('FFFFFF'), 0.25)
	tween.parallel().tween_property(current_dot, \"scale\", Vector2.ONE * 1.0, 0.25)

	await tween.finished


func finished() -> void:
	$\"..\".first_phase()
	await get_tree().create_timer(0.5).timeout
	fade_out_tween()
"

