[sub_resource type="GDScript" id="GDScript_smwuq"]
script/source = "extends Node

func play_sound(audio : AudioStream) -> void:
	#return
	CommonCode.play_sound_instance(audio, -40.0)
"

[sub_resource type="GDScript" id="GDScript_qq3yi"]
resource_name = "text_box"
script/source = "extends Control
@onready var label: Label = $PanelContainer/MarginContainer/Control/Label
@onready var sfx: AudioStreamPlayer = $PanelContainer/MarginContainer/Control/SFX
@onready var sfx_2: AudioStreamPlayer = $PanelContainer/MarginContainer/Control/SFX2

func _ready() -> void:
	modulate = Color.TRANSPARENT
	label.scale = Vector2.ZERO
	
func display_text() -> void:
	
	var dur : float = 0.25
	
	#sfx.play()
	var tween = create_tween().set_trans(Tween.TRANS_CUBIC)
	tween.tween_property(self, \"modulate\", Color('FFFFFF'), dur)
	tween.parallel().tween_property(label, \"scale\", Vector2.ONE * 1.15, dur)
	tween.tween_property(label, \"scale\", Vector2.ONE, dur)
	tween.tween_interval(dur)
	await tween.finished
	hide_text()
	
func hide_text() -> void:
	var dur : float = 0.5
	
	#sfx_2.play()
	
	var tween = create_tween().set_trans(Tween.TRANS_CUBIC)
	tween.tween_property(label, \"scale\", Vector2.ONE * 1.15, dur)
	tween.tween_property($PanelContainer, \"modulate\", Color('FFFFFF00'), dur)
	tween.parallel().tween_property(label, \"scale\", Vector2.ZERO, dur)
	tween.parallel().tween_callback(smoke_particles)
	tween.tween_interval(0.25)
	await tween.finished
	
func smoke_particles() -> void:
	$Smoke_sprite.show()
	$Smoke_sprite.play('default')
	#await $Smoke_sprite.animation_finished
	var tween = create_tween().set_trans(Tween.TRANS_CUBIC)
	tween.tween_property($Smoke_sprite, \"scale\", Vector2.ONE * 6, 5.0)
	tween.parallel().tween_property($Smoke_sprite, \"modulate\", Color.TRANSPARENT, 5.0)
	#tween.tween_interval(0.75)
	#tween.tween_property($Smoke_sprite, \"modulate\", Color.TRANSPARENT, 1.0)
	await tween.finished
	if self != null:
		self.queue_free()
"

