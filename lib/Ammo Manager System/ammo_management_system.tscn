"

[sub_resource type="GDScript" id="GDScript_47osj"]
script/source = "extends Panel

signal drag_stopped

var dropped_successfully := false

func _gui_input(event):
	if event is InputEventMouseButton and event.button_index == MOUSE_BUTTON_LEFT and event.pressed:
		start_drag()

func start_drag():
	set_drag_preview(self)
	set_process(true)

func _process(delta):
	if Input.is_mouse_button_pressed(MOUSE_BUTTON_LEFT):
		global_position = get_viewport().get_mouse_position()
	else:
		emit_signal(\"drag_stopped\", self)
		set_process(false)

func was_dropped_successfully() -> bool:
	return dropped_successfully

func set_dropped_successfully(val: bool):
	dropped_successfully = val
"

