[sub_resource type="GDScript" id="GDScript_xeubq"]
script/source = "extends Panel

var bullet_inside = null

func make_empty_outline():
	# Show crawling ants effect, or a dashed outline
	modulate = Color(0, 0, 0, 0.5)

func drop_bullet(bullet):
	if bullet_inside:
		return
	bullet_inside = bullet
	bullet.set_parent(self)
	bullet.rect_position = Vector2.ZERO
	bullet.set_dropped_successfully(true)

func has_bullet() -> void:
	pass
"

