[sub_resource type="GDScript" id="GDScript_qhbtx"]
script/source = "extends Decal

@export var dur := 2.5

func activate() -> void:
	
	var tween = create_tween().set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_CUBIC)
	tween.tween_property(self, \"scale\", Vector3.ONE, 0.01)
	tween.tween_property(self, \"modulate\", Color('FFFFFF50'), 0.25)
	tween.tween_property(self, \"size\", Vector3(1,1,1), dur)
	tween.parallel().tween_property(self, \"modulate\", Color.TRANSPARENT, dur)
	await tween.finished
	self.queue_free()
"

