[sub_resource type="GDScript" id="GDScript_rq41w"]
script/source = "extends Node

@onready var loading_screen: Control = $'..'

@export var do_not_move_on := false

var button_pushed := false
var next_scene : String
var amount_of_pineapples_collected := 0
var switching_scenes := false

func texture_expand() -> void:
	
	var dur : float = 1.0
	var ring : TextureRect = $'../Main_control/exit_ring'
	ring.show()
	var tween = create_tween().set_trans(Tween.TRANS_LINEAR)
	tween.tween_property(ring, \"modulate\", Color('ffbb0000'), dur).set_ease(Tween.EASE_OUT)
	tween.parallel().tween_property(ring, \"scale\", Vector2.ONE * 4.0, dur /2 ).set_ease(Tween.EASE_IN_OUT)

	await tween.finished

#func _input(event: InputEvent) -> void:
	##if Input.is_action_just_pressed('shootWeapon') or Input.is_action_just_pressed('shoot_weapon_2'):
	#if Input.is_action_just_pressed('shoot_weapon_2'):
		#switch_scene()
		
		
func switch_scene() -> void:
	if switching_scenes:
		return
		
	EventBus.instance.button_pushed_in_level_select.emit()
	switching_scenes = true
	texture_expand()
	loading_screen.fast_forward()
	$'../SFX/Press_continue_sound'.play()

func _on_new_loading_screen_finished_fade_out() -> void:
	#loading_screen.prepare_for_transition()
	prepare_for_transition()

func prepare_for_transition() -> void:
	
	BackgroundForTransition.fade_in()
	if button_pushed:
		await get_tree().create_timer(0.15).timeout
		get_tree().change_scene_to_file(next_scene) #Strangely I need to get_parent for this to work
	
	else:
		await get_tree().create_timer(0.15).timeout
		next_scene = await GameManager.next_level_directory()
	
"

