[sub_resource type="GDScript" id="GDScript_hxb21"]
script/source = "
extends Node2D
@onready var container: Node2D = $Node2D

@onready var uncollected: Sprite2D = $Uncollected
@onready var collected: Sprite2D = $Collected

#@onready var uncollected: Sprite2D = $Node2D/Uncollected
#@onready var collected: Sprite2D = $Node2D/Collected

@export var radius := 400.0
@export var count := 10
@export var rotation_spec := -4.7
var amount_of_pineapples_collected := 0

func _ready():
	uncollected.hide()
	collected.hide()
	amount_of_pineapples_collected = GameManager.total_number_of_pineapples_collected

#func _process(delta: float) -> void:
	for i in range(count):
		var icon: Sprite2D
		if i < amount_of_pineapples_collected:
			icon = collected.duplicate()
		else:
			icon = uncollected.duplicate()

		var angle = i * TAU / count - rotation_spec
		icon.position = Vector2(cos(angle), sin(angle)) * radius
		icon.rotation = angle
		icon.show()
		container.add_child(icon)
		if i <= 4:
			icon.hide()
		
	set_process(false)
"

