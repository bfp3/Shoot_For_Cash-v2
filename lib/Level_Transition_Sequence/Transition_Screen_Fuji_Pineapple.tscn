[sub_resource type="GDScript" id="GDScript_n7qer"]
script/source = "extends Control

@onready var line_2d: Line2D = $Line2D
var current_angle: float = 0.0
@export var rotation_speed: float = 15.0  # Higher = faster rotation

func _ready() -> void:
	line_2d.self_modulate = Color.TRANSPARENT
	var tween = create_tween().set_trans(Tween.TRANS_LINEAR)
	tween.tween_interval(1.0)
	tween.tween_property(line_2d, \"self_modulate\", Color.WHITE, 0.5)


func _process(delta: float) -> void:
	var center = get_global_position() + size / 2.0
	var mouse_pos = get_global_mouse_position()
	var target_angle = (mouse_pos - center).angle()
	
	# Interpolate towards target angle
	current_angle = lerp_angle(current_angle, target_angle, delta * rotation_speed)
	
	# Update the line's rotation by setting its points
	update_hand_rotation(current_angle)

func update_hand_rotation(angle: float) -> void:
	var length = 400.0  # Length of the clock hand
	var end_point = Vector2(cos(angle), sin(angle)) * length
	line_2d.clear_points()
	line_2d.add_point(Vector2.ZERO)
	line_2d.add_point(end_point)
"

