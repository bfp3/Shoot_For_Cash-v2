[sub_resource type="GDScript" id="GDScript_pgkd0"]
script/source = "extends TextureRect

var collected := false
var bounce_time := 0.0
@export var bounce_height := 10.0
@export var bounce_speed := 4.0
var original_y := 0.0

func _ready():
	await get_tree().create_timer(0.1).timeout
	original_y = position.y

func _process(delta: float) -> void:

	rotation -= delta * 0.1
	if collected:
		bounce_time += delta
		position.y = original_y + sin(bounce_time * bounce_speed) * bounce_height
	#else:
		#set_process(false)
"

