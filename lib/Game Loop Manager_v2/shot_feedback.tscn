[sub_resource type="GDScript" id="GDScript_dfvms"]
script/source = "extends Control

const HUD_ON_CLICK = preload(\"res://400_sounds/HUD Sfx/HUD on click.wav\")

#@onready var hud_light_control: Control = $HUD_Light_Control
@onready var hud_light_control: Control = $Round_tally

func _ready() -> void:
	hud_light_control.modulate = Color('FFFFFF00')
	await get_tree().create_timer(0.4).timeout
	
	blink_HUD_light()

func blink_HUD_light() -> void:
	var tween = create_tween()
	#tween.tween_interval(0.5)
	#play_click_sound()
	tween.tween_property(hud_light_control, \"modulate\", Color('FFFFFF'), 0.1 * 4)
	tween.tween_property(hud_light_control, \"modulate\", Color('FFFFFF00'), 0.125 * 10)
	await tween.finished
	self.queue_free()

#func play_click_sound() -> void:
	#await get_tree().create_timer(0.2).timeout
	#CommonCode.play_sound_instance_pitch_adjusted(HUD_ON_CLICK, -32.0, 2.1)
	#await get_tree().create_timer(0.1).timeout
		#
	
"

