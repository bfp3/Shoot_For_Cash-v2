[sub_resource type="GDScript" id="GDScript_r61dx"]
script/source = "extends Control

@export var move_direction: Vector2 = Vector2.LEFT
@export var move_speed: float = 50.0

@onready var cut_off_marker: Marker2D = $Cut_off_marker
@onready var restart_marker: Marker2D = $Restart_marker

@onready var texture_rects: Array = [
	$TextureRect,
	$TextureRect2,
	$TextureRect3,
	$TextureRect4,
	$TextureRect5
]

func _ready() -> void:
	move_direction = move_direction.normalized()

func _process(delta: float) -> void:
	for rect in texture_rects:
		rect.position += move_direction * move_speed * delta

		# Handle horizontal movement
		if move_direction.x != 0:
			if (move_direction.x < 0 and rect.position.x <= cut_off_marker.position.x) or \\
			   (move_direction.x > 0 and rect.position.x >= cut_off_marker.position.x):
				rect.position.x = restart_marker.position.x

		# Handle vertical movement
		if move_direction.y != 0:
			if (move_direction.y < 0 and rect.position.y <= cut_off_marker.position.y) or \\
			   (move_direction.y > 0 and rect.position.y >= cut_off_marker.position.y):
				rect.position.y = restart_marker.position.y
"

