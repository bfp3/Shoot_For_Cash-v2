[sub_resource type="GDScript" id="GDScript_r0xha"]
script/source = "extends Control

@onready var circle_spawn_container: Control = $Control
@onready var circle_polygon_template: Polygon2D = $Control/Circle_polygon

const TOTAL_CIRCLES := 100

func _ready() -> void:
	circle_polygon_template.hide()
	spawn_circle_explosion()

func spawn_circle_explosion() -> void:
	randomize()
	for i in TOTAL_CIRCLES:
		var circle_instance : Polygon2D = circle_polygon_template.duplicate()
		circle_instance.show()
		circle_instance.scale = Vector2.ZERO
		circle_instance.modulate = Color(1, 1, 1, 0.6)  # Optional: faded white

		# Random position offset from center (optional, tweak for effect)
		var offset = Vector2(randi_range(0, 1920), randi_range(0, 1080))
		circle_instance.position += offset
		
		circle_spawn_container.add_child(circle_instance)
		var rand_scale = randf_range(1.0, 3.0)
		
		var target_scale = Vector2(rand_scale, rand_scale)
		var delay = randf_range(0.0, 1.0)

		var tween = create_tween().set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_CUBIC)
		tween.tween_property(circle_instance, \"scale\", target_scale, delay * 6).set_delay(delay)
		tween.tween_property(circle_instance, \"scale\", Vector2.ZERO, delay * 6)
"

