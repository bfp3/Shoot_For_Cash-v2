[sub_resource type="GDScript" id="GDScript_uvyjf"]
script/source = "extends Control

var orig_modulate := modulate

func _ready() -> void:
	modulate = Color.TRANSPARENT
	fade_in()
	
func fade_in() -> void:
	var tween = create_tween().set_ease(Tween.EASE_IN).set_trans(Tween.TRANS_LINEAR)
	tween.tween_interval(1.0)
	tween.tween_property(self, \"modulate\", orig_modulate, 1.5)

func fade_out() -> void:
	var tween = create_tween().set_ease(Tween.EASE_IN).set_trans(Tween.TRANS_LINEAR)
	#tween.tween_interval(1.0)
	tween.tween_property(self, \"modulate\", Color.TRANSPARENT, 0.25)
"

