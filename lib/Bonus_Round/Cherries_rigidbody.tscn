[sub_resource type="GDScript" id="GDScript_nahdr"]
script/source = "extends GPUParticles3D

var duplicate_particles := false

func _ready():
	one_shot = true
	finished.connect(_on_finished)

func _on_finished() -> void:
	if duplicate_particles:
		self.queue_free()
"

