[sub_resource type="GDScript" id="GDScript_rjmb3"]
script/source = "extends RigidBody3D

@onready var smoke_quick: GPUParticles3D = $Particles/Smoke_quick
@onready var timer: Timer = $Timer

func _ready() -> void:
	timer.wait_time = randi_range(5,10)
	timer.start()
	scale_tween()
	
func scale_tween() -> void:
	scale = Vector3.ONE / 10

	var tween = create_tween().set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_CUBIC)
	tween.tween_property(self, \"scale\", Vector3.ONE, 0.15)
	await tween.finished


func _on_timer_timeout() -> void:
	var tween = create_tween().set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_CUBIC)
	tween.tween_property($Mesh, \"scale\", Vector3.ZERO, 0.25)
	await tween.finished
	smoke_particles()

func smoke_particles() -> void:
	var new_particles = $Particles/Smoke_quick
	if new_particles != null:
		new_particles.emitting = true
		new_particles.duplicate_particles = true
		new_particles.show()
		new_particles.reparent(get_tree().get_current_scene(), true)
		new_particles.global_position = global_position
	self.queue_free()
	
"

