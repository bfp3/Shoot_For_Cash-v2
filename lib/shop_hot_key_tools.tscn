[sub_resource type="GDScript" id="GDScript_vxate"]
resource_name = "Shop_hot_keys"
script/source = "# SHOP SCRIPT
extends Node

@onready var menu_node: Control = $Control
@onready var grid_container := $\"Control/GridContainer\"

var last_selected_panel: Control = null

var key_actions : Dictionary = {
	KEY_KP_9: {\"panel\": \"9\", \"action\": _buy_radar_power_pack},
	KEY_KP_8: {\"panel\": \"8\", \"action\": _buy_hostage_health},
	KEY_KP_7: {\"panel\": \"7\", \"action\": _buy_bullets},
	KEY_KP_2: {\"panel\": \"2\", \"action\": _close_shop},
}

func _ready():
	menu_node.hide()

func show():
	menu_node.show()
	GlobalsPlayerStats.is_shop_open = true
	Input.mouse_mode = Input.MOUSE_MODE_VISIBLE



func _input(event: InputEvent) -> void:
	if not GlobalsPlayerStats.is_shop_open:
		return  # Ignore input if shop isn't open

	for key in key_actions.keys():
		if Input.is_key_pressed(key):
			var info = key_actions[key]
			_highlight_panel(info.panel)
			info.action.call()
			break

# Close shop manually (you might call this from a close button or timer)
func _close_shop():
	menu_node.hide()
	GlobalsPlayerStats.is_shop_open = false
	#Input.mouse_mode = Input.MOUSE_MODE_CAPTURED

# Buying actions (still empty for now)
func _buy_bullets() -> void:
	var ammo = get_tree().get_first_node_in_group(\"Ammo_management_system\")
	var bullet_cost : int = 1
	if GlobalsPlayerStats.player_gold >= bullet_cost:
		GlobalsPlayerStats.player_gold -= bullet_cost
		ammo.current_amount_of_cartridges_remaining = clamp(ammo.current_amount_of_cartridges_remaining + 1, 0, ammo.max_number_of_cartridges)
		ammo.current_amount_of_ammo_remaining = clamp(ammo.current_amount_of_ammo_remaining + 6, 0, ammo.total_bullets)
		ammo.reload()
		
	else:
		pass
		
func _buy_hostage_health(): pass
func _buy_radar_power_pack(): pass

func _highlight_panel(panel_name: String) -> void:
	if last_selected_panel:
		last_selected_panel.modulate = Color(\"ffffff\")
	last_selected_panel = grid_container.get_node(panel_name)
	last_selected_panel.modulate = Color(\"ffffff80\")
"

