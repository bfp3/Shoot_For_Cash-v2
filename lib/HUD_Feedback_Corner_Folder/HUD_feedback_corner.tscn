[sub_resource type="GDScript" id="GDScript_uywbt"]
script/source = "extends Control

@onready var pineapple_emoji: TextureRect = $Pineapple_emoji
@onready var silhouette: TextureRect = $Silhouette

func _ready() -> void:
	modulate = Color('00000000')

func show_pineapple() -> void:
	var tween = create_tween().set_ease(Tween.EASE_IN)
	tween.tween_interval(0.4)
	tween.tween_property(self, \"modulate\", Color('FFFFFF'), 0.6)
	await tween.finished
	if GameManager.pineapples_hit > 1:
		display_pineapple()
	else:
		pass
	
func fade_pineapple() -> void:
	var tween = create_tween().set_ease(Tween.EASE_IN)
	tween.tween_interval(0.4)
	tween.tween_property(self, \"modulate\", Color('FFFFFF00'), 0.4)

func display_pineapple() -> void:
	var tween = create_tween().set_ease(Tween.EASE_IN)
	tween.tween_interval(0.4)
	tween.tween_property(silhouette, \"modulate\", Color('FFFFFF'), 0.2)
	await tween.finished
	var tween_2 = create_tween().set_ease(Tween.EASE_IN).set_trans(Tween.TRANS_CUBIC)
	tween_2.tween_property(silhouette, \"rotation\", -0.1, 0.1)
	tween_2.tween_property(silhouette, \"rotation\", 0.1, 0.1)
	tween_2.tween_property(silhouette, \"rotation\", -0.1, 0.1)
	tween_2.tween_property(silhouette, \"rotation\", 0.1, 0.1)
	tween_2.tween_property(silhouette, \"rotation\", -0.1, 0.1)
	tween_2.tween_property(silhouette, \"rotation\", 0.1, 0.1)
	tween_2.tween_property(silhouette, \"rotation\", 0.0, 0.15)
	await tween_2.finished

func fade_out_pineapple() -> void:
	var tween = create_tween().set_ease(Tween.EASE_IN)
	tween.tween_interval(0.4)
	tween.tween_property(silhouette, \"modulate\", Color('000000'), 1.0)
	await tween.finished
	fade_pineapple()

func hit_pineapple() -> void:
	$\"../Main_score_Tally\".hit_pineapple()
"

[sub_resource type="GDScript" id="GDScript_61ou1"]
script/source = "extends Control

#scoring points is going to reduce the number further

@onready var coins_label: Label = $Countdown/Coins_label
@onready var texture_rect: TextureRect = $Countdown/TextureRect

@export var countdown_speed: float = 1.0

var countdown_value: int = 0
@onready var countdown_timer: Timer = $Timer

func _ready() -> void:
	if GameManager.in_retry_world:
		show()
		start_countdown()
		#EventBus.instance.cannonball_destroyed.connect(_reduce_score)
		EventBus.instance.red_cannonball_destroyed.connect(_reduce_score.bind(ScoreGl.red_dots))
		EventBus.instance.standard_cannonball_destroyed.connect(_reduce_score.bind(ScoreGl.grey_dots))
		EventBus.instance.standard_cannonball_destroyed_astray.connect(_reduce_score.bind(ScoreGl.grey_dots_astray))
		EventBus.instance.special_cannonball_destroyed_astray.connect(_reduce_score.bind(ScoreGl.special_bonus_bomb))
	else:
		hide()
		
func _reduce_score(_score : float) -> void:
	countdown_value -= _score
	
func start_countdown() -> void:
	countdown_value = ScoreGl.winning_score
	coins_label.text = str(countdown_value)
	
	# Set up the countdown timer
	countdown_timer.wait_time = countdown_speed
	countdown_timer.one_shot = false
	countdown_timer.timeout.connect(_on_countdown_tick)
	add_child(countdown_timer)
	countdown_timer.start()
	
func _on_countdown_tick() -> void:
	countdown_value = clamp(countdown_value - 1, 0, ScoreGl.winning_score)
	coins_label.text = str(countdown_value)

	if countdown_value <= 0:
		countdown_timer.stop()
		timer_finished()
	
func timer_finished() -> void:
	EventBus.instance.player_has_hit_winning_score.emit()
	EventBus.instance.game_won.emit()

	print('timer ran out')
"

