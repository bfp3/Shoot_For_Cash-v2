[sub_resource type="GDScript" id="GDScript_s022b"]
script/source = "extends TextureRect


@export var lamp_off : Color = Color('84461b15')
@export var lamp_on_brightest : Color = Color('84461b')

var hud_light_on := false

func silence_phase_blinking() -> void:
	
	var tween = create_tween()
	tween.tween_interval(0.5)
	tween.tween_property(self, \"modulate\", lamp_on_brightest, 0.1)
	tween.tween_property(self, \"modulate\", lamp_off, 0.075)
	tween.tween_property(self, \"modulate\", lamp_on_brightest, 0.3)
	tween.tween_property(self, \"modulate\", lamp_off, 0.075 * 3)
	tween.tween_property(self, \"modulate\", Color('84461b00'), 0.075 * 3)
	await tween.finished

func hud_lamp_on_phase():

	hud_light_on = true
	var tween = create_tween()
	tween.tween_interval(0.5)
	tween.tween_property(self, \"modulate\", lamp_on_brightest, 0.1)
	tween.tween_property(self, \"modulate\", lamp_off, 0.075)
	tween.tween_property(self, \"modulate\", lamp_on_brightest, 0.3)
	tween.tween_property(self, \"modulate\", lamp_off, 0.075 * 3)
	tween.tween_property(self, \"modulate\", lamp_on_brightest, 0.5)
	tween.tween_property(self, \"modulate\", Color('84461b00'), 0.075 * 3)
	await tween.finished
	
	return
"

[sub_resource type="GDScript" id="GDScript_yuqy6"]
script/source = "extends TextureRect

@export var lamp_off : Color = Color('84461b15')
@export var lamp_on_brightest : Color = Color('84461b')


func shot_hit_blinking() -> void:
	show()
	var tween = create_tween()
	tween.tween_property(self, \"modulate\", lamp_on_brightest, 0.1)
	tween.tween_property(self, \"modulate\", lamp_off, 0.075)
	tween.tween_interval(0.1)

	tween.tween_property(self, \"modulate\", lamp_on_brightest, 0.1)
	tween.tween_property(self, \"modulate\", lamp_off, 0.075)
	tween.tween_interval(0.1)

	tween.tween_property(self, \"modulate\", lamp_on_brightest, 0.3)
	tween.tween_property(self, \"modulate\", lamp_off, 0.075 * 3)
	await tween.finished
	hide()
"

