[sub_resource type="GDScript" id="GDScript_j6j30"]
script/source = "extends Control

@onready var sub_control: Control = $Sub_root_control
@export var scale_amount := 5

@export var panel_border_colour := Color('FFFFFF')

var expanding := false
var orig_scale : Vector2
var orig_pos : Vector2

var radar_off := false

var radar_power_meter := 0.0


@export var await_time := 2.5
@export var fade_in_dur := 1.0


func fade_in_tween() -> void:
	modulate = Color.TRANSPARENT
	await get_tree().create_timer(await_time).timeout
	
	var tween = create_tween()
	tween.tween_property(self, \"modulate\", Color.WHITE, fade_in_dur)
	#tween.tween_property(self, \"modulate\", Color('ffffff77'), fade_in_dur)
	

func _ready() -> void:
	fade_in_tween()
	if $Control/Panel:
		$Control/Panel.modulate = panel_border_colour
	
	orig_scale = sub_control.scale
	orig_pos = sub_control.global_position

func expand_shrink() -> void:
	if radar_off:
		turn_on()
	else:
		turn_off()
	#
	#if expanding:
		#var dur : float = 0.25
		#var tween = create_tween().set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_LINEAR)
		#tween.tween_property(sub_control, \"scale\", Vector2.ONE, dur)
		#await tween.finished
		#expanding = false
	#
	#else:
		#var dur : float = 0.25
		#var tween = create_tween().set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_LINEAR)
		#tween.tween_property(sub_control, \"scale\", sub_control.scale * scale_amount, dur)
		#expanding = true 

func turn_off() -> void:
	var dur : float = 0.2
	var tween = create_tween().set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_CUBIC)
	tween.tween_property(self, \"modulate\", Color('80808080'), dur)
	await tween.finished
	radar_off = true
	#%Radar_power_system.set_process(false)
	$Sub_root_control/Radar.set_process(false)
	
func turn_on() -> void:
	var dur : float = 0.2
	var tween = create_tween().set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_CUBIC)
	tween.tween_property(self, \"modulate\", Color('FFFFFF'), dur)
	await tween.finished
	radar_off = false
	#%Radar_power_system.set_process(true)
	$Sub_root_control/Radar.set_process(true)
	
#func _on_button_pressed() -> void:
	#if expanding:
		#return
	#expanding = true
	#
	#var dur : float = 0.5
	#var tween = create_tween().set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_LINEAR)
	#tween.tween_property(sub_control, \"scale\", sub_control.scale * scale_amount, dur)
	#tween.tween_interval(1.0)
	#tween.tween_property(sub_control, \"scale\", Vector2.ONE, dur)
	#await tween.finished
	#expanding = false
"

