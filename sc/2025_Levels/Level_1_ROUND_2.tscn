[sub_resource type="GDScript" id="GDScript_bxqlr"]
script/source = "extends Node
@onready var player: Node3D = %Player

func _ready() -> void:
	%\"April 14\".intro_finished.connect(_on_intro_finished)
	#$\"../../decoration\".process_mode = Node.PROCESS_MODE_DISABLED
	%Start_birds.process_mode = Node.PROCESS_MODE_DISABLED

func prepare_intro_sequence() -> void:
	#%Target_launcher_operator.process_mode = Node.PROCESS_MODE_DISABLED
	player.crosshair.hide()
	player.process_mode = Node.PROCESS_MODE_DISABLED
	GlobalMusic.play_blue_danude()
	%\"April 14\".play_intro()
	await get_tree().create_timer(13.0).timeout
	%Intro_anim.play(\"camera_zoom_in\")
	await %Intro_anim.animation_finished
	%Intro_anim.play(\"camera_wobble\")
	#await get_tree().create_timer(6.0).timeout
	player.crosshair.cross_hair_fade_in()
	#%Hostage_side_panel.process_mode = Node.PROCESS_MODE_DISABLED
	
func _on_intro_finished() -> void:
	%Hostage_side_panel.init_sequence_intro()
	player.process_mode = Node.PROCESS_MODE_INHERIT
	
	
	
	#$\"April 14\".queue_free()
	#%Hostage_side_panel.show()
	#$Radar_view_panel.show()
	await get_tree().create_timer(5.0).timeout
	var ammo_system = get_tree().get_first_node_in_group(\"Ammo_management_system\")
	ammo_system.game_started()
	
	%Start_birds.process_mode = Node.PROCESS_MODE_INHERIT
	
	#await get_tree().create_timer(7.0).timeout
	#
	#%Target_launcher_operator.process_mode = Node.PROCESS_MODE_INHERIT
	
	
func no_intro_sequence() -> void:
	%\"April 14\".queue_free()
	%Hostage_side_panel.init_sequence_no_intro()
	#var ammo_system = get_tree().get_first_node_in_group(\"Ammo_management_system\")
	#ammo_system.game_started()

	#%Target_launcher_operator.process_mode = Node.PROCESS_MODE_DISABLED
	await get_tree().create_timer(1.0).timeout
	%Start_birds.process_mode = Node.PROCESS_MODE_INHERIT
	
	#await get_tree().create_timer(5.0).timeout
	#
	#%Target_launcher_operator.process_mode = Node.PROCESS_MODE_INHERIT
"

[sub_resource type="GDScript" id="GDScript_smxn7"]
resource_name = "end_birds_flight_path"
script/source = "extends Node3D

@export var start_bird := false
@export var target_pos : Vector3 = Vector3(-152.0, 20.0, -50.0)
@export var flight_speed_curve : Curve 
var speed = Vector3.ZERO
var start_pos : Vector3 = Vector3(-152.0, 20.0, 706.0)

signal game_finished


@export var start_bird_duration := 25.0


func _ready() -> void:
	return
	if !start_bird:
		var level_control = get_tree().get_first_node_in_group(\"level_root\")
		if level_control:
			level_control.game_finished.connect(end_bird_flights)
	
	#global_position = start_pos

	if start_bird:
		start_flight()
	else:
		hide()
	

func start_flight() -> void:
	var dur : float = 25.0
	var flight_tween = create_tween().set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_CUBIC)
	flight_tween.tween_property(self, \"global_position\", target_pos, start_bird_duration * 10).as_relative()
	#flight_tween.tween_property(self, \"global_position:z\", 100.0, start_bird_duration).as_relative()
	await flight_tween.finished
	if self != null:
		self.queue_free()
	
	
func end_bird_flights() -> void:
	show()
	var dur : float = 15.0
	
	#look_at(target_pos, Vector3.UP, true)
	
	var bird_tween = create_tween().set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_CUBIC)
	bird_tween.tween_property(self, \"global_position:z\", -100.0, dur).as_relative()
	await bird_tween.finished
"

[sub_resource type="GDScript" id="GDScript_rrw3i"]
resource_name = "continue_sequence"
script/source = "extends CanvasLayer

const PISTOL_SFX = preload(\"res://400_sounds/00_sfx/Pistol_SFX.wav\")
const WIN_SOUND = preload(\"res://400_sounds/00_sfx/ES_sound_effects/ES_Music Charge - SFX Producer.wav\")
@export var next_scene: String

@export var divisible_amount = 5.0  # Change as needed

signal player_lost
signal reset_timer

func start_sequence() -> void:
	if check_hostage_health():
		player_survived()
	else:
		player_failed()

func player_survived() -> void:
	stop_player()
	stop_targets()
	stop_target_launcher()
	lower_the_music()
	all_bombs_hit_floor()
	await fade_to_black()
	display_options()

func check_hostage_health() -> bool:
	var hostage_health_side_panel_info = get_tree().get_first_node_in_group(\"Side_panel_of_hostage\")
	if hostage_health_side_panel_info.health_remaining > 0:
		return true
	else:
		return false

func stop_player() -> void:
	var player = get_tree().get_first_node_in_group('Player')
	if player:
		player.set_process(false)
		player.set_physics_process(false)
		player.set_process_input(false)

func stop_targets() -> void:
	var targets = get_tree().get_nodes_in_group('Moving_target')
	if targets.size() > 0:
		for target in targets:
			target.was_hit_tween()
			target.set_physics_process(false)
		
func stop_target_launcher() -> void:
	var target_launchers = get_tree().get_nodes_in_group('Target_launcher')
	if target_launchers.size() > 0:
		for target_launcher in target_launchers:
			target_launcher.stop_timer()
			target_launcher.process_mode = Node.PROCESS_MODE_DISABLED
			#get_parent().remove_child(target_launcher)
			#target_launcher.queue_free()
			var tween = create_tween().set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_CUBIC)
			tween.tween_property(self, \"global_position:y\", -10.0, 5.0)


func all_bombs_hit_floor() -> void:
	var bomb_container_array = get_tree().get_first_node_in_group(\"bomb_container_array\")
	
	while bomb_container_array.get_children().size() > 0:
		await get_tree().create_timer(0.1).timeout
	
	# All bombs are gone now, function will return
	return


func lower_the_music() -> void:
	var dur : float = 2.0
	var level_song : AudioStreamPlayer = get_tree().get_first_node_in_group(\"level_song\")
	if level_song:
		var tween = create_tween()
		#tween.tween_property(level_song, \"volume_db\", -80.0, 2.0)
		tween.tween_property(level_song, \"volume_db\", -8.0, 6.0).as_relative()
		await tween.finished
		#level_song.stop()
		#CommonCode.play_sound_instance(WIN_SOUND, -25.0)

func fade_to_black() -> void:
	var screen_fade = ColorRect.new()
	screen_fade.name = \"ScreenFade\"
	screen_fade.modulate = Color('00000000')  # Fully transparent
	screen_fade.size = get_viewport().size  # Full-screen size
	screen_fade.anchor_left = 0
	screen_fade.anchor_top = 0
	screen_fade.anchor_right = 1
	screen_fade.anchor_bottom = 1
	screen_fade.z_index = 1000
	add_child(screen_fade)
	move_child(screen_fade, 0)  # Ensure it's drawn on top

	var tween = create_tween().set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_CUBIC)
	tween.tween_property(screen_fade, \"modulate\", Color('00000030'), 2.0)  # Fade in over 2 seconds
	await tween.finished

	#screen_fade.queue_free()  # Remove the fade effect after it finishes

	
func player_failed() -> void:
	player_lost.emit()
	return
	
func player_gold_reward() -> void:
	return
	var score_canvas := get_node(\"ScoreCanvasLayer/ScoreScreen\")

	var stats = GlobalsPlayerStats
	var shots_fired = stats.shots_fired
	var time_remaining = stats.total_time_remaining
	var damage = stats.damage_to_cage
	var targets_hit = stats.targets_successfully_destroyed
	

	# 1. Calculate shot multiplier
	var shot_multiplier = 20.0
	for i in range(shots_fired):
		shot_multiplier /= 2.0

	# 2. Calculate bonuses
	var time_bonus = 100.0 - time_remaining  # Lower time = higher bonus
	var damage_bonus = damage * 5.0
	var target_bonus = targets_hit * 10.0

	# 3. Calculate final score
	var total_score = int((shot_multiplier + time_bonus + damage_bonus + target_bonus) / divisible_amount)
	
	# 4. Create labels for display
	var vbox = VBoxContainer.new()
	add_child(vbox)
	vbox.position = get_viewport().size / 2

	await _show_stat_line(vbox, \"Shot Multiplier Bonus\", int(shot_multiplier))
	await _show_stat_line(vbox, \"Time Bonus\", int(time_bonus))
	await _show_stat_line(vbox, \"Damage Bonus\", int(damage_bonus))
	await _show_stat_line(vbox, \"Targets Hit Bonus\", int(target_bonus))
	await _show_stat_line(vbox, \"Gold Earned\", total_score)

	# OPTIONAL: Store gold somewhere
	stats.player_gold += total_score


func _show_stat_line(vbox: VBoxContainer, label_text: String, final_value: int) -> void:
	var container = HBoxContainer.new()
	var label = Label.new()
	label.text = label_text + \": \"
	label.size_flags_horizontal = Control.SIZE_EXPAND_FILL

	var value_label = Label.new()
	value_label.text = \"0\"
	value_label.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	container.add_child(label)
	container.add_child(value_label)
	vbox.add_child(container)

	var tween = create_tween().set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_SINE)
	tween.tween_method(func(val): value_label.text = str(val), 0, final_value, 1.5)
	await tween.finished

	await get_tree().create_timer(0.2).timeout  # small delay before next stat


func display_options() -> void:
	# Make the mouse visible
	#await player_gold_reward()
	
	
	Input.set_mouse_mode(Input.MOUSE_MODE_VISIBLE)
	
	var canvas_layer = CanvasLayer.new()
	canvas_layer.name = \"ScoreCanvasLayer\"
	canvas_layer.layer = 10  # Ensure it's rendered on top
	add_child(canvas_layer)
	
	# Create the main UI container (500x500, centered)
	var control_node = Control.new()
	control_node.name = \"ScoreScreen\"
	control_node.set_size(Vector2(500, 500))
	control_node.pivot_offset = control_node.size / 2
	control_node.set_position((get_viewport().size / 2))  # Center on screen
	control_node.position = control_node.position - control_node.position / 2 + Vector2(250,0 )
	control_node.z_index = 1001
	canvas_layer.add_child(control_node)  # Attach to CanvasLayer

	# Create a full-screen ColorRect (background)
	var screen_fade = ColorRect.new()
	screen_fade.name = \"ScreenFade\"
	#screen_fade.color = Color(1, 1, 1, 0.05)  # Semi-transparent black
	screen_fade.color = Color('80808025')
	screen_fade.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	screen_fade.size.y = screen_fade.size.y / 2
	control_node.add_child(screen_fade)

	# Create a VBoxContainer to hold UI elements
	var vbox = VBoxContainer.new()
	vbox.anchor_left = 0
	vbox.anchor_top = 0
	vbox.anchor_right = 1
	vbox.anchor_bottom = 1
	vbox.size_flags_horizontal = Control.SIZE_FILL
	vbox.size_flags_vertical = Control.SIZE_FILL
	vbox.alignment = BoxContainer.ALIGNMENT_CENTER
	control_node.add_child(vbox)

	# Create \"PASS\" label
	var label = Label.new()
	label.text = \"PASS\"
	label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	label.add_theme_color_override(\"font_color\", Color('FFFFFF80'))
	# Set large font size (80px)
	var font = ThemeDB.fallback_font
	label.add_theme_font_override(\"font\", font)
	label.add_theme_font_size_override(\"font_size\", 60)
	vbox.add_child(label)

	# Create Retry Button
	var continue_button = Button.new()
	continue_button.text = \"Next Round?\"
	continue_button.add_theme_font_override(\"font\", font)
	continue_button.add_theme_font_size_override(\"font_size\", 20)
	continue_button.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	continue_button.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	continue_button.pressed.connect(continue_mission)
	vbox.add_child(continue_button)
	
	var exit_button = Button.new()
	exit_button.text = \"Exit\"
	exit_button.add_theme_font_override(\"font\", font)
	exit_button.add_theme_font_size_override(\"font_size\", 20)
	exit_button.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	exit_button.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	exit_button.pressed.connect(quit_mission)
	vbox.add_child(exit_button)
	
	control_node.add_to_group('temp_control')
	
	control_node.modulate = Color('FFFFFF00')
	var tween = create_tween().set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_CUBIC)
	tween.tween_property(control_node, \"modulate\", Color('FFFFFF'), 0.5)  # Fade in over 2 seconds
	await tween.finished
	
func quit_mission() -> void:
	get_tree().quit()
	
# Define the retry function
func continue_mission() -> void:
	var control_node = get_tree().get_first_node_in_group('temp_control')
	
	var tween = create_tween()
	tween.tween_property(control_node, \"modulate\", Color('FFFFFF00'), 0.25)  # Fade in over 2 seconds
	await tween.finished
	
	reset_player_control()
	reset_target_launchers()
	reset_timer.emit()
	
	
	
	var tween_2 = create_tween()
	tween_2.tween_property(control_node, \"modulate\", Color('FFFFFF00'), 0.25)
	await tween_2.finished
	
	var children = get_children()
	for i in children:
		i.queue_free()
	
	if control_node:
		control_node = null
	
	
	
func reset_player_control() -> void:
	var player = get_tree().get_first_node_in_group('Player')
	if player:
		player.set_process(true)
		player.set_physics_process(true)
		player.set_process_input(true)
		Input.set_mouse_mode(Input.MOUSE_MODE_CAPTURED)
	
func reset_target_launchers() -> void:
	var target_launchers = get_tree().get_nodes_in_group('Target_launcher')
	if target_launchers.size() > 0:
		for target_launcher in target_launchers:
			target_launcher.process_mode = Node.PROCESS_MODE_INHERIT
	
	%Bomb_container_array.start_checking_empty()
	
func next_mission() -> void:
	var control_node = get_tree().get_first_node_in_group('temp_control')
	var tween = create_tween()
	
	
	tween.tween_property(control_node, \"modulate\", Color('FFFFFF00'), 0.25)  # Fade in over 2 seconds
	await CommonCode.play_sound_instance_pitch_adjusted(PISTOL_SFX, -38.0, 2.75)
	get_tree().change_scene_to_file(next_scene)
"

[sub_resource type="GDScript" id="GDScript_jptyy"]
script/source = "extends Node


@export var screen_fade_in := false
@export var screen_fade_in_time := 2.0
@export var birds := false

@export var delay_until_launchers_start := 5.0


@onready var player: Node3D = %Player



func start() -> void:

	if screen_fade_in:
		var screen = $Godot_screen_fade_in
		screen.show()
		var tween = create_tween() #.set_trans(Tween.TRANS_CUBIC)
		tween.tween_property(screen, \"modulate\", Color('FFFFFF00'), screen_fade_in_time) #.set_ease(Tween.EASE_OUT)
		#tween.tween_property(screen, \"scale\", Vector2.ZERO, screen_fade_in_time) 
		
		tween.tween_property($black_fade_in, \"modulate\", Color('FFFFFF00'), 2.0).set_ease(Tween.EASE_IN)
		

func start_birds() -> void:
	var tween = create_tween()
	tween.tween_callback($Path3D/PathFollow3D.start_moving)
	tween.tween_interval(delay_until_launchers_start)
	#tween.tween_callback(%Target_launcher_operator.start_round_loop)
	await tween.finished
"

[sub_resource type="GDScript" id="GDScript_l7ic3"]
script/source = "extends Node3D

@onready var bonus_markers: Node3D = $Bonus_markers

func _choose_marker(threat_color: String) -> Dictionary:
	match threat_color:
		\"RED\":
			return {\"position\": choose_random_red_marker(), \"will_hit_cage\": true}
		\"GREY\":
			return {\"position\": choose_random_grey_marker(), \"will_hit_cage\": false}
		\"ORANGE\":
			return choose_random_orange_marker()
		_:
			return {\"position\": Vector3.ZERO, \"will_hit_cage\": false}


func choose_random_red_marker() -> Vector3:
	var options = get_children().filter(func(m): return m.is_in_cage == true)
	if options.is_empty():
		push_warning(\"No RED markers available\")
		return Vector3.ZERO
	return options[randi() % options.size()].global_transform.origin

func choose_random_grey_marker() -> Vector3:
	var options = get_children().filter(func(m): return m.is_in_cage == false)
	if options.is_empty():
		push_warning(\"No GREY markers available\")
		return Vector3.ZERO
	return options[randi() % options.size()].global_transform.origin
	
func choose_random_orange_marker() -> Dictionary:
	var options = get_children()
	if options.is_empty():
		push_warning(\"No markers available for ORANGE\")
		return {\"position\": Vector3.ZERO, \"will_hit_cage\": false}

	var chosen = options[randi() % options.size()]
	var is_in_cage = chosen.is_in_cage
	return {
		\"position\": chosen.global_transform.origin,
		\"will_hit_cage\": is_in_cage
	}
"

[sub_resource type="GDScript" id="GDScript_ctn7f"]
