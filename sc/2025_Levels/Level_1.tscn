[sub_resource type="GDScript" id="GDScript_1vxbm"]
script/source = "extends Node3D
@onready var mesh: MeshInstance3D = $MeshInstance3D

func _ready() -> void:
	EventBus.instance.next_round.connect(_next_round_update)
	
func _next_round_update(round_count : int) -> void:
	mesh.mesh.text = str(round_count)
"

