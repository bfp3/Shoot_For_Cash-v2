[sub_resource type="GDScript" id="GDScript_m768q"]
script/source = "extends Node3D

var tween : Tween = null

func _ready() -> void:
	await get_tree().create_timer(5.0).timeout
	activate()

func activate() -> void:

	tween = create_tween().set_trans(Tween.TRANS_SINE).set_loops()
	tween.tween_property(self, \"rotation_degrees:x\", 0.0, 0.5)
	tween.tween_interval(3.0)
	tween.tween_property(self, \"rotation_degrees:x\", 90.0, 1.5)
	tween.tween_interval(7.0)
"

