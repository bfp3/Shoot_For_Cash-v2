[sub_resource type="GDScript" id="GDScript_j63gk"]
script/source = "extends Node3D

@onready var rumble_sound: AudioStreamPlayer = $Rumble_sound
@onready var rumble_sound_2: AudioStreamPlayer = $Rumble_sound2


func rumble_effect_tween() -> void:
	rumble_sound.play()
	rumble_sound_2.play()
	for i in range(10):
		var tween = create_tween().set_ease(Tween.EASE_IN_OUT).set_trans(Tween.TRANS_CUBIC)
		tween.tween_property(self, \"rotation_degrees:y\", -2.2, 0.1)
		tween.tween_property(self, \"rotation_degrees:y\", 2.2, 0.1)
		#tween.tween_property(self, \"rotation_degrees:y\", 0.0, 0.1)
		await tween.finished

	var tween_2 = create_tween().set_ease(Tween.EASE_IN_OUT).set_trans(Tween.TRANS_CUBIC)
	tween_2.tween_property(self, \"rotation_degrees:y\", 0.0, 0.8)
	await tween_2.finished
"

[sub_resource type="GDScript" id="GDScript_fql6o"]
script/source = "extends CSGBox3D

func _ready() -> void:
	for i in get_children():
		i.hide()
		
func fade_in_graffiti() -> void:
	for i in get_children():
		i.show()
	
	var tween = create_tween().set_ease(Tween.EASE_IN)
	tween.tween_interval(5.0)
	tween.tween_property($Decal, \"modulate\", Color.WHITE, 20.0)
	tween.parallel().tween_property($Decal2, \"modulate\", Color.WHITE, 20.0)
	tween.parallel().tween_property($Decal3, \"modulate\", Color.WHITE, 20.0)
"

