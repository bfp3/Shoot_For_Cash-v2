[sub_resource type="GDScript" id="GDScript_4hj2f"]
script/source = "extends Control
@onready var egg_health_points: Control = %egg_health_points
@onready var king_eggs_face: Control = $King_eggs_face

@export var starting_health : int = 5

@export var await_time := 2.5
@export var fade_in_dur := 1.0

func _ready() -> void:
	EventBus.instance.main_egg_destroyed.connect(_hostage_killed)
	
	fade_in_tween()
	king_eggs_face.hide()

func _hostage_killed() -> void:
	var tween = create_tween()
	tween.tween_property(%Hostage_face, \"modulate\", Color.TRANSPARENT, 0.25).set_trans(Tween.TRANS_LINEAR)
	await tween.finished
	%Hostage_face.hide()

func fade_in_tween() -> void:
	modulate = Color.TRANSPARENT
	await get_tree().create_timer(await_time).timeout
	
	var tween = create_tween()
	tween.tween_property(self, \"modulate\", Color.WHITE, fade_in_dur)
	await tween.finished
	egg_health_points.start_up_tween()
	await get_tree().create_timer(2.5).timeout
	king_eggs_face.fade_in_king_egg_face()



	
	
func init_sequence_intro() -> void:
	await get_tree().create_timer(6.0).timeout
	%hostage_health_bar.initialise_health_bar()
	await get_tree().create_timer(2.0).timeout
	%Hostage_timer.initialise_timer()

func init_sequence_no_intro() -> void:
	%hostage_health_bar.initialise_health_bar()
	%Hostage_timer.initialise_timer()
"

[sub_resource type="GDScript" id="GDScript_j6j30"]
script/source = "extends Control

@onready var sub_control: Control = $Sub_root_control
@export var scale_amount := 5

@export var panel_border_colour := Color('FFFFFF')

var expanding := false
var orig_scale : Vector2
var orig_pos : Vector2

var radar_off := false

var radar_power_meter := 0.0


@export var await_time := 2.5
@export var fade_in_dur := 1.0


func fade_in_tween() -> void:
	modulate = Color.TRANSPARENT
	await get_tree().create_timer(await_time).timeout
	
	var tween = create_tween()
	tween.tween_property(self, \"modulate\", Color.WHITE, fade_in_dur)
	#tween.tween_property(self, \"modulate\", Color('ffffff77'), fade_in_dur)
	

func _ready() -> void:
	fade_in_tween()
	if $Control/Panel:
		$Control/Panel.modulate = panel_border_colour
	
	orig_scale = sub_control.scale
	orig_pos = sub_control.global_position

func expand_shrink() -> void:
	if radar_off:
		turn_on()
	else:
		turn_off()
