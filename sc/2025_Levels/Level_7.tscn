[sub_resource type="GDScript" id="GDScript_7nk6u"]
script/source = "extends Node3D

signal all_bombs_empty

var checking_for_empty := false

func start_checking_empty() -> void:
	if not checking_for_empty:
		checking_for_empty = true

func remove_everything() -> void:
	if get_children().size() > 0:
		for i in get_children():
			if i != null:
				if i.has_method('was_hit_tween'):
					i.was_hit_tween()
			
			#await get_tree().create_timer(0.1).timeout

func manually_check_if_empty() -> void:
	all_bombs_empty.emit()
	#print(get_child_count(), \" How many balls are left in bomb container\")
	#if checking_for_empty and get_child_count() == 0:
		#checking_for_empty = false
	#all_bombs_empty.emit()
#
	#if get_children().size() > 0:
		#for i in get_children():
			#if i != null:
				#i.queue_free()


func turn_off_checking() -> void:
	if checking_for_empty:
		checking_for_empty = false
		set_process(false)
	
"

[sub_resource type="GDScript" id="GDScript_uqeah"]
script/source = "extends Node

const STANDARD_CANNONBALL_STANDARD = preload(\"res://lib/Cannonball_System/Cannonballs/Standard_cannonball.tscn\")
const LEVEL_3_CANNONBALLS = preload('res://lib/Cannonball_System/Cannonballs/Inherited_Scenes/level_3_cannonballs.tscn')

@export var standard_cannonball := false
@export var level_3_cannonball := false

func _ready() -> void:
	if standard_cannonball:
		$'../Launcher_container'.STANDARD_CANNONBALL = STANDARD_CANNONBALL_STANDARD
		
	if level_3_cannonball:
		$'../Launcher_container'.STANDARD_CANNONBALL = LEVEL_3_CANNONBALLS

	else:
		$'../Launcher_container'.STANDARD_CANNONBALL = STANDARD_CANNONBALL_STANDARD
"

[sub_resource type="GDScript" id="GDScript_s7c0w"]
resource_name = "Launcher_container"
script/source = "extends Node3D


@export var STANDARD_CANNONBALL : PackedScene
@onready var list_of_cannonballs: Node = $'../List_of_cannonballs'

var total_of_cannons_in_level := 0

func _ready() -> void:
	
	if STANDARD_CANNONBALL == null:
		print('didnt set a cannonball')
	
	var children = get_children()
	total_of_cannons_in_level = get_parent().total_of_cannons_in_level
	
	
	while children.size() > total_of_cannons_in_level:
		var to_remove = children.back()
		children.pop_back()  # Remove from our local array
		to_remove.queue_free()
	
	
#func reduce_arc_trajectory() -> void:
	#var children = get_children()
	#for i in children:
		#i.arc_strength = i.arc_strength / 2
		#i.launch_speed = 1.0#i.launch_speed / 2
		#print('it worked')
"

[sub_resource type="GDScript" id="GDScript_lpwer"]
script/source = "extends AudioStreamPlayer

@onready var parent = get_parent()
@export var max_distance = 15.0
@export var max_volume_db = -24.0
@export var min_volume_db = -40.0

func play_sound() -> void:
	distance_from_player()
	if not playing:
		play()

func distance_from_player() -> void:
	var player = get_tree().get_first_node_in_group('Player')
	var distance = parent.global_position.distance_to(player.global_position)
	#print_debug(\"DISTANCE\", distance)
	distance = clamp(distance, 1.0, max_distance)
	var _vol = max_volume_db + (min_volume_db - max_volume_db) * (distance - 1) / (max_distance - 1)
	_vol = clamp(_vol, min_volume_db, max_volume_db)
	self.volume_db = _vol
"

