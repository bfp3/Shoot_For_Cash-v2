[sub_resource type="GDScript" id="GDScript_2svof"]
script/source = "extends MeshInstance3D
## Attach this to the quad MeshInstance3D that uses diagonal_band.gdshader.
## Make sure the mesh has a ShaderMaterial (using diagonal_band.gdshader)
## set as its material (either on the mesh surface or as material_override).

@export var default_color: Color = Color(1.0, 0.9, 0.0, 1.0) # yellow
@export var default_speed: float = 1.0       # sweeps/second: 1.0 = full sweep in 1 second
@export var default_thickness: float = 0.15
@export var default_skew: float = 0.4
@export var default_repeats: int = 1         # how many times the sweep plays. 0 = loop forever.
@export var default_repeat_delay: float = 0.0 # pause (seconds) between each sweep

var _tween: Tween

func _get_material() -> ShaderMaterial:
	if material_override:
		return material_override as ShaderMaterial
	return get_surface_override_material(0) as ShaderMaterial

func start() -> void:
	return
	play_band(default_color, default_speed, default_thickness, default_skew, 3)


func play_band(color = null, speed: float = -1.0, thickness: float = -1.0, skew: float = -100.0,
		repeats: int = -1, repeat_delay: float = -1.0) -> void:
	show()
	var mat := _get_material()
	if mat == null:
		push_warning(\"BandAnimator: no ShaderMaterial found on this mesh.\")
		return

	var c: Color = color if color != null else default_color
	var s: float = speed if speed > 0.0 else default_speed
	var t: float = thickness if thickness > 0.0 else default_thickness
	var k: float = skew if skew > -99.0 else default_skew
	var r: int = repeats if repeats >= 0 else default_repeats
	var rd: float = repeat_delay if repeat_delay >= 0.0 else default_repeat_delay

	mat.set_shader_parameter(\"band_color\", c)
	mat.set_shader_parameter(\"band_thickness\", t)
	mat.set_shader_parameter(\"skew\", k)

	# Kill any sweep already in progress so re-triggering restarts cleanly.
	if _tween and _tween.is_valid():
		_tween.kill()

	# Reset to the start position, then animate progress 0 -> 1, repeating r times.
	# Duration is driven directly by \"speed\": higher speed = shorter duration = faster sweep.
	mat.set_shader_parameter(\"progress\", 0.0)
	var duration: float = 1.0 / s

	_tween = create_tween()
	_tween.set_loops(r) # 0 means \"loop forever\" in Godot's Tween API

	_tween.tween_property(mat, \"shader_parameter/progress\", 1.0, duration) \\
		.set_trans(Tween.TRANS_LINEAR)
	if rd > 0.0:
		_tween.tween_interval(rd)
	# Reset instantly back to the start position before the next repeat (or before hiding).
	_tween.tween_callback(func(): mat.set_shader_parameter(\"progress\", 0.0))
	# Band stays fully swept-past (invisible) once progress hits 1.0 — this is the \"stop\".

	if r != 0:
		await _tween.finished
		hide()
	# Note: with r == 0 (infinite loop) the tween never finishes, so we don't await/hide here.
	# Call stop() if you need to cut an infinite loop short.

func stop() -> void:
	if _tween and _tween.is_valid():
		_tween.kill()
	var mat := _get_material()
	if mat:
		mat.set_shader_parameter(\"progress\", 0.0)
	hide()
"

