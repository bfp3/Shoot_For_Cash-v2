[sub_resource type="GDScript" id="GDScript_epet4"]
script/source = "extends PathFollow3D

var moving := false
@export var movement_speed := 0.01

func _ready() -> void:
	#var bomb_container = get_tree().get_first_node_in_group(\"bomb_container_array\")
	#if bomb_container:
		#bomb_container.all_bombs_empty.connect(start_moving)
		
	var bomb_launcher = get_tree().get_first_node_in_group(\"Target_launcher\")
	if bomb_launcher:
		bomb_launcher.bomb_launched.connect(stop_moving)

func start_moving() -> void:
	return
	await get_tree().create_timer(0.5).timeout
	await $Bunny_cage_scene.enlarge_head()
	moving = true
	
func stop_moving() -> void:
	return
	moving = false
	$Bunny_cage_scene.shrink_head()
	
func stop_moving_to_eat() -> void:
	return
	moving = false
	$Bunny_cage_scene.eating_food()
	
#func _process(delta: float) -> void:
	#if progress_ratio >= 1.0:
		#%level_completed_sequence.start_sequence()
		#set_process(false)
	#
	#if moving:
		#progress += movement_speed * delta
	#else:
		#pass
"

