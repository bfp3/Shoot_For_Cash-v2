[sub_resource type="GDScript" id="GDScript_q7kt8"]
resource_name = "trails_built_in"
script/source = "extends MeshInstance3D
#class_name Trail3D

const MAX_POINTS := 120  # (20 seconds ÷ 0.2s interval = 100, add margin)

var _points = []
var _widths = []
var _lifePoints = []

var _current_index := 0
var _time_since_last_point := 0.0
var _frame_counter := 0

@export var _trailEnabled : bool = true
@export var _fromWidth : float = 0.5
@export var _toWidth : float = 0.0
@export_range(0.5, 1.5) var _scaleAcceleration : float = 1.0
@export var _motionDelta : float = 0.1
@export var _lifespan : float = 20.0
@export var _startColor : Color = Color(1, 1, 1, 1)
@export var _endColor : Color = Color(1, 1, 1, 1)

var _oldPos : Vector3

func _ready() -> void:
	_oldPos = global_transform.origin
	mesh = ArrayMesh.new()

	# Pre-allocate
	_points.resize(MAX_POINTS)
	_widths.resize(MAX_POINTS)
	_lifePoints.resize(MAX_POINTS)
	for i in MAX_POINTS:
		_points[i] = Vector3.ZERO
		_widths[i] = [Vector3.ZERO, Vector3.ZERO, Vector3.ZERO]
		_lifePoints[i] = -1.0  # -1 means inactive

func _process(delta: float) -> void:
	if not _trailEnabled:
		return
	
	if get_global_transform().basis.determinant() == 0.0:
		print(\"⚠️ Warning: Non-invertible basis detected on \", self.name)

	
	# Update time and position
	_time_since_last_point += delta
	if (_oldPos - global_transform.origin).length() > _motionDelta and _time_since_last_point >= 0.2:
		_append_point()
		_time_since_last_point = 0.0
		_oldPos = global_transform.origin

	# Update lifetimes
	for i in MAX_POINTS:
		if _lifePoints[i] >= 0.0:
			_lifePoints[i] += delta
			if _lifePoints[i] > _lifespan:
				_lifePoints[i] = -1.0  # expire point

	# Throttle mesh updates
	_frame_counter += 1
	if _frame_counter % 2 == 0:
		_update_trail_mesh()

func _append_point() -> void:
	var pos = global_transform.origin
	var basis_x = global_transform.basis.x

	_points[_current_index] = pos
	_widths[_current_index] = [basis_x * _fromWidth, basis_x * _fromWidth, -basis_x * _toWidth]
	_lifePoints[_current_index] = 0.0

	_current_index = (_current_index + 1) % MAX_POINTS

func _update_trail_mesh() -> void:
	var st = SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLE_STRIP)

	var valid_indices := []
	for i in range(MAX_POINTS):
		if _lifePoints[i] >= 0.0:
			valid_indices.append(i)

	if valid_indices.size() < 2:
		mesh.clear_surfaces()
		return

	for order in range(valid_indices.size()):
		var i = valid_indices[order]
		var t = float(order) / (valid_indices.size() - 1.0)
		var curr_color = _startColor.lerp(_endColor, 1 - t)

		var base_width = _widths[i][0]
		var taper_width = _widths[i][1]
		var width = base_width

		if taper_width.is_finite() and base_width.is_finite():
			width -= pow(1.0 - t, _scaleAcceleration) * taper_width
		else:
			width = Vector3.ZERO  # fallback to avoid NaN

		var point_pos = _points[i]
	
		var local_pos1 = point_pos + width - global_transform.origin
		var local_pos2 = point_pos - width - global_transform.origin


		if local_pos1.is_finite() and local_pos2.is_finite():
			st.set_color(curr_color)
			st.set_uv(Vector2(t, 0))
			st.add_vertex(local_pos1)

			st.set_color(curr_color)
			st.set_uv(Vector2(t, 1))
			st.add_vertex(local_pos2)

		
		#st.set_color(curr_color)
		#st.set_uv(Vector2(t, 0))
		#st.add_vertex(to_local(point_pos + width))
#
		#st.set_color(curr_color)
		#st.set_uv(Vector2(t, 1))
		#st.add_vertex(to_local(point_pos - width))

	mesh.clear_surfaces()
	st.commit(mesh)
	
	
func detach_from_parent():
	# Stop appending new points
	_trailEnabled = false

	# Convert the trail's global transform to a world-space dummy
	var old_global = global_transform
	var parent = get_parent()

	if parent:
		parent.remove_child(self)

	# Add directly to the scene tree root
	get_tree().root.add_child(self)
	self.global_transform = old_global  # Critical: preserve world transform

	# Start fading and eventually remove
	fade_out_and_destroy_self()

func _reparent_trail(saved_transform: Transform3D) -> void:
	if not is_inside_tree():
		await ready  # Wait if not yet inside the scene tree

	# Add to root or any existing fallback node
	var scene_root = get_tree()
	scene_root.add_child(self)
	
	global_transform = saved_transform  # Restore world-space position

	fade_out_and_destroy_self()


func fade_out_and_destroy_self() -> void:
	await get_tree().create_timer(_lifespan).timeout
	get_parent().remove_child(self)
	if self != null:
		self.queue_free()
"

[sub_resource type="GDScript" id="GDScript_awb7n"]
resource_name = "target_launcher_container"
script/source = "extends Node3D

@export var time_between_rounds := 5.0
@export var stagger_time_between_launcher_rounds := 1.0

var launcher_nodes: Array = []
var total_launchers := 0
var first_round := true
var counter := 0
var is_pineapple_round := false

var next_batch: Array = []
var game_over := false

func _ready() -> void:
	GlobalsPlayerStats.current_round = 0

	launcher_nodes = get_children().filter(func(c): return c.has_method(\"assign_round_parameters\"))
	total_launchers = launcher_nodes.size()
	
	GlobalsPlayerStats.current_round = total_launchers

	# Randomize seed for randomness
	randomize()

func set_next_batch(batch: Array) -> void:
	if game_over:
		return
	next_batch = batch


#func run_round_new() -> void:
	#if next_batch.is_empty():
		#print(\"No batch provided!\")
		#return
#
	#var shots = next_batch.duplicate()
	#var shot_index := 0
#
	#for launcher in launcher_nodes:
		#if launcher.pineapple_launcher and is_pineapple_round:
			#launcher.pineapple_shot = true
			#launcher.assign_round_parameters(1, 0.0)
			#continue
		#elif is_pineapple_round:
			#continue
#
		#launcher.pineapple_shot = false
		#var assigned_shots := []
#
		#while shot_index < shots.size():
			#var shot_type = shots[shot_index]
			#var is_red = shot_type == \"RED\"
			#var shot_data = {
				#\"type\": shot_type,
				#\"target_is_going_to_hit_cage\": is_red
			#}
			#assigned_shots.append(shot_data)
			#shot_index += 1
#
			## Balance shots among launchers
			#if assigned_shots.size() >= ceil(float(shots.size()) / total_launchers):
				#break
#
		#launcher.assign_shot_batch(assigned_shots)
		#await get_tree().create_timer(stagger_time_between_launcher_rounds).timeout
#
	#$\"../Turtle_path/PathFollow3D\".stop_moving()
#

func start_round_loop() -> void:
	# Decide round type
	if GameManager.total_current_score >= GameManager.score_to_beat_for_the_level:
		is_pineapple_round = randf() < 0.8
	else:
		is_pineapple_round = false

	counter += 1
	if !first_round:
		GlobalsPlayerStats.current_round += 1

	run_round()
	await get_tree().create_timer(8.0).timeout
	
	%Bomb_container_array.start_checking_empty()
	first_round = false

func run_round() -> void:
	if next_batch.is_empty():
		push_warning(\"No shot batch provided.\")
		return

	var batch_index := 0
	var batch_size := next_batch.size()

	for launcher in launcher_nodes:
		if batch_index >= batch_size:
			break

		launcher.visual_fire()

		var shot_data: Dictionary = next_batch[batch_index]
		prepare_target_for_launch(launcher, shot_data)

		batch_index += 1
		await get_tree().create_timer(stagger_time_between_launcher_rounds).timeout

	$\"../Turtle_path/PathFollow3D\".stop_moving()


func prepare_target_for_launch(launcher: Node, shot_data: Dictionary) -> void:
	var target_instance = preload(\"res://300_assets/100_targets/Launching_target.tscn\").instantiate()

	# Set metadata from shot_data
	# After instantiation...
	#target_instance.target_position = target_instance.find_target_position(shot_data[\"type\"])
	target_instance
	target_instance.slow_travel_time = launcher.launch_speed * 2
	target_instance.fast_travel_time = launcher.launch_speed * 2
	target_instance.travel_time = launcher.launch_speed
	target_instance.arc_strength = launcher.arc_strength

	var bomb_container = get_tree().get_first_node_in_group(\"bomb_container_array\")
	bomb_container.add_child(target_instance)

	# Setup visual
	if launcher.pineapple_shot:
		target_instance.pineapple.show()
		target_instance.bomb_mesh.hide()
	else:
		target_instance.pineapple.hide()
		target_instance.bomb_mesh.show()

	target_instance.global_position = launcher.marker_3d.global_position
	launcher.play_launch_animation(target_instance)

	target_instance.target_launcher_fire(shot_data[\"type\"])


func send_in_the_pineapples() -> void:

	var pineapple_shots := 3
	var launchers_available := launcher_nodes.filter(func(l): return l.pineapple_launcher)
	
	if launchers_available.size() < pineapple_shots:
		push_warning(\"Not enough pineapple launchers available! Using all we have.\")
		pineapple_shots = launchers_available.size()

	for i in range(pineapple_shots):
		
		if i > 2:
			break
		
		var launcher = launchers_available[i]
		launcher.pineapple_shot = true
		launcher.visual_fire()

		var dummy_shot := {
			\"type\": \"GREY\"  # Pineapples act like high-threat shots
		}
		prepare_target_for_launch(launcher, dummy_shot)
		
		await get_tree().create_timer(stagger_time_between_launcher_rounds).timeout
	
	%Bomb_container_array.start_checking_empty()

func smoke_player_won_sequence() -> void:
	game_over = true
	var delay_time : float = 0.05
	for i in range(5):
		for launcher in launcher_nodes:
			launcher.smoke_up()
			await get_tree().create_timer(delay_time).timeout
			stagger_time_between_launcher_rounds += 0.05
		
"

[sub_resource type="GDScript" id="GDScript_0e1jt"]
script/source = "extends Node3D

signal all_bombs_empty

var checking_for_empty := false

func _ready() -> void:
	set_process(false)  # Don’t run _process until told to check

func start_checking_empty() -> void:
	
	
	if not checking_for_empty:
		checking_for_empty = true
		set_process(true)

func _process(delta: float) -> void:
	if checking_for_empty and get_child_count() == 0:
		checking_for_empty = false
		all_bombs_empty.emit()
		set_process(false)
"

[sub_resource type="GDScript" id="GDScript_cp8s7"]
script/source = "extends Node3D

@onready var rumble_sound: AudioStreamPlayer = $Rumble_sound
@onready var rumble_sound_2: AudioStreamPlayer = $Rumble_sound2


func rumble_effect_tween() -> void:
	rumble_sound.play()
	rumble_sound_2.play()
	for i in range(10):
		var tween = create_tween().set_ease(Tween.EASE_IN_OUT).set_trans(Tween.TRANS_CUBIC)
		tween.tween_property(self, \"rotation_degrees:y\", -2.2, 0.1)
		tween.tween_property(self, \"rotation_degrees:y\", 2.2, 0.1)
		#tween.tween_property(self, \"rotation_degrees:y\", 0.0, 0.1)
		await tween.finished

	var tween_2 = create_tween().set_ease(Tween.EASE_IN_OUT).set_trans(Tween.TRANS_CUBIC)
	tween_2.tween_property(self, \"rotation_degrees:y\", 0.0, 0.8)
	await tween_2.finished
"

