[sub_resource type="GDScript" id="GDScript_hcy87"]
script/source = "extends Node

const BASIC_THEME = preload(\"res://700_2D_nodes_UI/Fonts/Themes/Basic theme.tres\")
#@export_tool_button(\"Button Gen\") var create_buttons = show_restart_menu

@export var timer_mode := true # True for timer mode, False for countdown mode
@export var total_time_limit := 300 # Initial time in seconds (e.g., 300 seconds = 5 minutes)
@export var activated := true
@onready var label: Label = $Label

var time_elapsed: float = 0.0  # Custom time tracker, starts at 0
var time_remaining: float = 0.0

signal timed_out

func _ready() -> void:
	# pivot_offset = size / 2 # don't know why but it doesn't work
	label.pivot_offset = label.size / 2
	var level = get_tree().get_first_node_in_group(\"level_root\")
	if level:
		total_time_limit = level.timer_start_time
	tween()
	set_process(false)

func tween() -> void:
	if activated:
		time_remaining = total_time_limit
		update_label(time_remaining * 1000)  # Show time in milliseconds
	else:
		self.visible = false
	
	var tween = create_tween().set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_CUBIC)
	tween.tween_property(label, \"modulate\", Color('ffffff00'), 0.01)
	tween.tween_property(label, \"modulate\", Color('ffffff'), 1.5)
	tween.tween_property(label, \"position:y\", 10, 1.5).as_relative()
	tween.parallel().tween_property(label, \"scale\", Vector2(1, 1), 1.5)
	await tween.finished

	activated = true
	set_process(true)

func _process(_delta: float) -> void:
	if activated:
		time_elapsed += _delta  # Increment time_elapsed based on _delta
		var remaining_time = total_time_limit - time_elapsed  # Calculate remaining time

		if remaining_time <= 0:
			activated = false  # Stop when time runs out
			remaining_time = 0  # Ensure no negative time
			on_timer_end()

		update_countdown(remaining_time)  # Update with remaining time

func update_countdown(remaining_time: float) -> void:
	if remaining_time > 0:
		update_label(int(remaining_time * 1000))  # Update the label in milliseconds
	else:
		on_timer_end()

func update_label(current_time: int) -> void:
	var minutes = current_time / 1000 / 60
	var seconds = current_time / 1000 % 60
	var msec = current_time % 1000 / 10
	var minute_str = str(minutes).pad_zeros(2)
	var second_str = str(seconds).pad_zeros(2)
	var msec_str = str(msec).pad_zeros(2)
	label.text = minute_str + \":\" + second_str + \":\" + msec_str

func on_timer_end() -> void:
	set_process(false)
	timed_out.emit()  # Emit signal when time is up

func stop_timer_lose_condition() -> void:
	set_process(false)
	var tween = create_tween().set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_CUBIC)
	tween.tween_property(self, \"modulate\", Color('ffffff00'), 1.0)
	
"

[sub_resource type="GDScript" id="GDScript_a6bu3"]
script/source = "extends Control

@onready var health_unit: ColorRect = $health_unit
@onready var health_remaining_label: Label = $health_remaining_label
@onready var health_hbox_container: HBoxContainer = $Health_hbox_container
@onready var _2d_marker_pos: Marker2D = $\"2D_marker_pos\"

@onready var health_loading_sound: AudioStreamPlayer = $health_loading_sound
@onready var take_damage_sound: AudioStreamPlayer = $take_damage_sound

@export var starting_health := 3
var health_remaining := starting_health

signal out_of_health

func _ready() -> void:
	first_load()
	var bunny_cage = get_tree().get_first_node_in_group('Bunny_Cage_physical')
	bunny_cage.taken_a_hit_from_a_target.connect(taken_a_hit)

func first_load() -> void:
	clear_ui_elements()
	load_health(health_remaining)
	update_labels()
	update_hbox_positions()

func taken_a_hit(hits: int = 1) -> void:
	hits = min(hits, health_remaining)  # Ensure we don't remove more than we have
	if health_remaining > 0:
		health_remaining -= hits
		take_damage_sound.play()
		remove_health_units(hits)
		update_labels()
		
		if health_remaining == 0:
			out_of_health.emit()

func remove_health_units(count: int) -> void:
	for i in range(count):
		if health_hbox_container.get_children().size() == 0:
			return
		var last_health = health_hbox_container.get_children().back()
		if last_health:
			send_to_tween(last_health)

func load_health(count: int) -> void:
	clear_ammo()
	for _i in range(count):
		print(count)
		var new_health = health_unit.duplicate()
		health_hbox_container.add_child(new_health)
		new_health.show()
		health_loading_sound.play()
		await get_tree().create_timer(0.05).timeout

func send_to_tween(last_health: ColorRect) -> void:
	shake_viewport()
	var dur : float = 0.2
	var tween = create_tween().set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT)
	tween.tween_property(last_health, \"scale\", Vector2.ONE * 1.25, dur)
	tween.parallel().tween_property(last_health, \"modulate\", Color('FFFFFF00'), dur)
	tween.parallel().tween_property(last_health, \"position:y\", 50.0, dur).as_relative()
	tween.tween_callback(last_health.queue_free)
	await tween.finished

func shake_viewport() -> void:
	var viewport = $\"../SubViewportContainer\"
	var dur : float = 0.05
	for i in range(10):
		var tween = create_tween().set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT)
		tween.tween_property(viewport, \"rotation\", -0.02, dur)
		tween.tween_property(viewport, \"rotation\", 0.02, dur)
		tween.tween_property(viewport, \"rotation\", 0.0, dur)
		await tween.finished

func update_labels() -> void:
	health_remaining_label.text = str(health_remaining)

func update_hbox_positions() -> void:
	health_hbox_container.position = _2d_marker_pos.position
	health_remaining_label.position = health_hbox_container.position - Vector2(-2, 110)
	var tween = create_tween().set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT)
	tween.tween_property(health_hbox_container, \"position:x\", health_hbox_container.position.x - health_hbox_container.size.x / 2, 0.1)
	await tween.finished

func clear_ui_elements() -> void:
	clear_ammo()

func clear_ammo() -> void:
	for child in health_hbox_container.get_children():
		child.queue_free()
"

