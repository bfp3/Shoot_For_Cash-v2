[sub_resource type="GDScript" id="GDScript_p23d5"]
script/source = "extends Camera3D


@export var amount_of_shakes := 1
@export var shake_amount := 1.0
@export var move_speed := 0.1
@export var camera_shaking := false

var cam_shake_tween : Tween = null
var orig_pos : Vector3

func _ready() -> void:
	orig_pos = global_position

func shake_camera() -> void:
	if camera_shaking:
		if cam_shake_tween:
			cam_shake_tween.kill()
			#return
		global_position = orig_pos
		cam_shake_tween = create_tween().set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_CUBIC)
		for i in range(amount_of_shakes):
			cam_shake_tween.tween_property(self, \"global_position:z\", -shake_amount, move_speed).as_relative()
			cam_shake_tween.tween_property(self, \"global_position:z\", shake_amount, move_speed).as_relative()
		await cam_shake_tween.finished
		global_position = orig_pos
"

[sub_resource type="GDScript" id="GDScript_kyarp"]
script/source = "extends Control

@export var amount_of_shakes := 1
@export var shake_amount := 1.2
@export var move_speed := 0.1

var scope_tween : Tween = null
var inner_scope_tween : Tween = null
var orig_scale : Vector2
var inner_orig_scale : Vector2

func crosshair_shake() -> void:
	crosshair_inner_tween()
	var scope = $Large_outer_scope/center_container
	orig_scale = scale
	if scope_tween:
		scope_tween.kill()
		#return
	
	scope_tween = create_tween().set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_CUBIC)
	for i in range(amount_of_shakes):
		scope_tween.tween_property(scope, \"scale\", Vector2.ONE * shake_amount, move_speed)
		scope_tween.tween_property(scope, \"scale\", Vector2.ONE, move_speed)
	await scope_tween.finished
	scale = orig_scale
	
func crosshair_inner_tween() -> void:
	var scope = $Inner_scope/center_container
	if inner_scope_tween:
		inner_scope_tween.kill()
		#return
	
	inner_scope_tween = create_tween().set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_CUBIC)
	for i in range(amount_of_shakes):
		inner_scope_tween.tween_property(scope, \"scale\", Vector2.ONE * shake_amount, move_speed)
		inner_scope_tween.parallel().tween_property($Inner_scope, \"modulate\", Color('ffffff30'), move_speed)
		inner_scope_tween.tween_property(scope, \"scale\", Vector2.ONE, move_speed)
		inner_scope_tween.parallel().tween_property($Inner_scope, \"modulate\", Color('ffffff20'), move_speed)
		
	await inner_scope_tween.finished
	scale = orig_scale



func crosshair_shake_old() -> void:
	crosshair_inner_tween_old()
	var scope = $Large_outer_scope/center_container
	orig_scale = scale
	if scope_tween:
		scope_tween.kill()
		#return
	
	scope_tween = create_tween().set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_CUBIC)
	for i in range(amount_of_shakes):
		scope_tween.tween_property(scope, \"scale\", Vector2.ONE * shake_amount, move_speed)
		scope_tween.tween_property(scope, \"scale\", Vector2.ONE, move_speed)
	await scope_tween.finished
	scale = orig_scale
	
func crosshair_inner_tween_old() -> void:
	var scope = $Inner_scope/center_container
	if inner_scope_tween:
		inner_scope_tween.kill()
		#return
	
	inner_scope_tween = create_tween().set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_CUBIC)
	for i in range(amount_of_shakes):
		inner_scope_tween.tween_property(scope, \"scale\", Vector2.ONE * shake_amount, move_speed)
		inner_scope_tween.parallel().tween_property($Inner_scope, \"modulate\", Color('ffffff30'), move_speed)
		inner_scope_tween.tween_property(scope, \"scale\", Vector2.ONE, move_speed)
		inner_scope_tween.parallel().tween_property($Inner_scope, \"modulate\", Color('ffffff20'), move_speed)
		
	await inner_scope_tween.finished
	scale = orig_scale
"

