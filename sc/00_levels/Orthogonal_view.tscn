[sub_resource type="GDScript" id="GDScript_pq7i7"]
script/source = "extends Node3D



@onready var magnifying_camera: Camera3D = $Magnifying_zoom/SubViewportContainer/SubViewport/Pivot/Camera3D

@export var rotation_speed: float = 0.1
@export var clamp_up: float = 75.0
@export var clamp_down: float = -75.0

@export var pan_amount: float = 20.0  # How much the camera should pan
@export var panning_camera: bool = true  # New export variable to toggle panning camera

@onready var raycast: RayCast3D = $RayCast3D
@onready var cam: Camera3D = $Cam_pivot/Camera3D
@onready var crosshair: Control = $Crosshair
@onready var cam_pivot: Node3D = $Cam_pivot
@onready var camera_3d: Camera3D = $Cam_pivot/Camera3D


@export var crosshair_lerp_speed: float = 10.0  # Adjust for smoothness


var target_crosshair_position: Vector2 = Vector2(980, 540)

var rotation_x: float = 0.0


var bullet_orig_pos : Vector3
#var ammo_remaining := 6.0

@export var mouse_sensitivity = 0.1

@onready var magnify_ui: Control = $Magnifying_zoom
@onready var ammo: Control = $Ammo


func _ready() -> void:
	#$bullet.global_position = global_position
	#bullet_orig_pos = $bullet.global_position
	
	Input.mouse_mode = Input.MOUSE_MODE_CAPTURED
	#target_crosshair_position = Vector2.ZERO  # Initialize at (0,0)
	
func handle_pan_up_and_down(delta) -> void:
	var viewport_size = get_viewport().size
	var screen_height = viewport_size.y
	var crosshair_y = crosshair.position.y
	
	crosshair.position.y = clamp(crosshair.position.y, 0, screen_height - crosshair.size.y)
	
	if crosshair_y <= 70:
		cam_pivot.rotation_degrees.x += pan_amount * delta  # Apply a small pan to the left
		cam_pivot.rotation_degrees.x = clamp(cam_pivot.rotation_degrees.x, -5, 5)
		
	elif crosshair_y >= 1000:
		cam_pivot.rotation_degrees.x -= pan_amount * delta  # Apply a small pan to the left
		cam_pivot.rotation_degrees.x = clamp(cam_pivot.rotation_degrees.x, -5, 5)

func handle_pan_left_and_right(delta) -> void:
	var viewport_size = get_viewport().size
	var screen_width = viewport_size.x
	var crosshair_x = crosshair.position.x
	
	crosshair.position.x = clamp(crosshair.position.x, 0, screen_width - crosshair.size.x)
	
	if crosshair_x <= 200:
		cam_pivot.rotation_degrees.y += pan_amount * delta  # Apply a small pan to the left
		cam_pivot.rotation_degrees.y = clamp(cam_pivot.rotation_degrees.y, -5, 5)
	elif crosshair_x >= 1718:
		cam_pivot.rotation_degrees.y -= pan_amount * delta  # Apply a small pan to the left
		cam_pivot.rotation_degrees.y = clamp(cam_pivot.rotation_degrees.y, -5, 5)


func _process(delta: float) -> void:
	handle_pan_up_and_down(delta)
	handle_pan_left_and_right(delta)
	handle_raycast_movement(delta)
	handle_3D_crosshair()
	
func handle_3D_crosshair() -> void:
	
	var crosshair_2D = $Crosshair
	var crosshair_3D = $Crosshair_3D
	
	if not crosshair_2D or not crosshair_3D:
		return
	
	# Get the 2D screen position of the crosshair
	var crosshair_screen_pos = crosshair_2D.global_position

	# Convert the 2D position to a 3D ray from the camera
	var from = camera_3d.project_ray_origin(crosshair_screen_pos)
	var to = from + camera_3d.project_ray_normal(crosshair_screen_pos) * 1  # Adjust distance as needed
	
	# Perform a raycast to find the point in 3D space
	var space_state = get_world_3d().direct_space_state
	var query = PhysicsRayQueryParameters3D.create(from, to)
	var result = space_state.intersect_ray(query)

	#if result:
		#crosshair_3D.global_position = result.position
	#else:
	crosshair_3D.global_position = to  # Default if no hit

	
func handle_raycast_movement(delta : float) -> void:
	var space_state = get_world_3d().direct_space_state
	var start: Vector3
	var direction: Vector3

	var viewport = get_viewport()
	var screen_pos = crosshair.position
	var mouse_ray = camera_3d.project_ray_origin(screen_pos)
	var ray_dir = camera_3d.project_ray_normal(screen_pos)
		
	start = mouse_ray
	direction = ray_dir * 500  # You can adjust this distance as needed

	var end = start + direction
	var query = PhysicsRayQueryParameters3D.create(start, end)
	var result = space_state.intersect_ray(query)
	
	#if result:
		##var collider = result #.get_collider()
		#$Aim_decal.global_position = result.position
		#$Aim_decal.show()
	#else:
		#$Aim_decal.hide()

func _physics_process(delta) -> void:
	crosshair.position = target_crosshair_position #This controls the movement of crosshair 2D
	%Pivot.global_position = $Crosshair_3D/Camera_pos.global_position + Vector3(0,0,2)

	if Input.is_action_just_pressed(\"shootWeapon\"):
		if ammo.check_can_shoot():
			ammo.deduct_ammo()
			$Shoot_weapon_script.shoot_target()
		else:
			print(\"Cannot shoot: Out of ammo!\")
		

func reload_ammo() -> void:
	$Ammo.current_amount_of_cartridges_remaining = clamp($Ammo.current_amount_of_cartridges_remaining + 1, 0, $Ammo.max_number_of_cartridges)
	$Ammo.reload()

func _input(event) -> void:

	if event is InputEventMouseButton and event.pressed:
		var target_fov = camera_3d.fov
		
		if event.button_index == MOUSE_BUTTON_WHEEL_DOWN:
			target_fov = clamp(camera_3d.fov + 10, 20, 75)
		elif event.button_index == MOUSE_BUTTON_WHEEL_UP:
			target_fov = clamp(camera_3d.fov - 10, 20, 75)
		
		# Smooth transition using Tween
		var tween = create_tween()
		tween.tween_property(camera_3d, \"fov\", target_fov, 0.3).set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_SINE)

	if event is InputEventMouseMotion:
		target_crosshair_position += event.relative * mouse_sensitivity  # Store target position

	

	
	
	
	
	#var tween = create_tween().set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_CUBIC)
	#tween.tween_property(new_arrow, \"global_position\", target_pos, 1.0)

#func retrieve_bullet() -> void:
	#
	#$bullet.global_position = $Crosshair2.global_position
	#await get_tree().create_timer(0.01).timeout
	#$bullet.global_position = $Crosshair2.global_position  # Reset the bullet's position
	#$bullet.linear_velocity = Vector3.ZERO     # Reset bullet's velocity to stop movement
	#$bullet.hit_something = true              # Reset the hit status to false
	#await get_tree().create_timer(0.01).timeout
	#$bullet.global_position = $Crosshair2.global_position




#func spawn_bullet(target_pos: Vector3) -> void:
	#if firing_weapon:
		#return
	#firing_weapon = true
	#var gun_anim = $gun/animations
	##if !gun_anim.is_playing():
		##gun_anim.play(\"shoot\")
	#$gun/gunsfx.play()
	#
	#var bullet = BULLET.instantiate()
	#get_tree().get_current_scene().add_child(bullet)
	##bullet.global_position = global_position
	#bullet.global_position = $Crosshair2.global_position
	##bullet.shoot(cam.global_transform)		#used to just be transform, had to change it.
	#bullet.shoot(target_pos)
	##bullet.set_direction(target_pos)
#
	#bullet.shoot(target_pos)
	#await get_tree().create_timer(0.1).timeout
	#firing_weapon = false
	
#
#		$Head/Camera3D/Ammo_counter.bulletShot()	#reduces the bullet
#		gf_recoilCounter = RECOIL_RIGHT
"

[sub_resource type="GDScript" id="GDScript_f3vr7"]
script/source = "extends Node3D

const ARROW = preload(\"res://300_assets/Arrows/Arrow.tscn\")
const BULLET_RIGID = preload(\"res://200_characters/weapons/bullet_rigid.tscn\")
const BULLET = preload(\"res://200_characters/weapons/bullet_area3D.tscn\")

@onready var hand_marker: Marker3D = $\"../Cam_pivot/Hand/Marker3D\"
@onready var camera_3d: Camera3D = $\"../Cam_pivot/Camera3D\"
@export var view_limit := 30.0 #10.0

var firing_weapon := false
var bullet_speed := 0.0

func shoot_target() -> void:

	var space_state = get_world_3d().direct_space_state
	var start: Vector3
	var direction: Vector3

	# Calculate the direction from the crosshair position in the screen space
	var viewport = get_viewport()
	var screen_pos = $\"../Crosshair/Inner_scope/TextureRect\".global_position # crosshair.position
	var mouse_ray = camera_3d.project_ray_origin(screen_pos)
	var ray_dir = camera_3d.project_ray_normal(screen_pos)
	$\"../Crosshair/aim_texture\".position = screen_pos + Vector2(-14.0, -11.0)
	start = mouse_ray #$Crosshair2/Rail_position.global_position
	direction = ray_dir * view_limit  # You can adjust this distance as needed
	
	#print(direction, \" DIRECTION\")
	var end = start + direction
	var query = PhysicsRayQueryParameters3D.create(start, end)
	var result = space_state.intersect_ray(query)
	
	
	if result:
		print(result.collider.name)
		print(result.collider)
		if result.collider.is_in_group('Target'): # && !result.collider.target_hit:
			print(result.collider)
			var target = result.collider
			
			var future_target_position
			
			target.add_unique_marker(result.position)
			#if target.has_method('where'):
				#future_target_position = target.where(1.0)
			#var future_target_position = target.where(1.0)
			if target.has_method('spawn_my_arrow'):
				print('SPAWNING MY HONING ARROW')
				target.spawn_my_arrow()
				spawn_bullet_imaginary()
			#if global_position.distance_to(result.position) > 1.0:
				#spawn_bullet(future_target_position)
				#
			#else:
				#shoot_second_weapon(direction)
				
		elif result.collider.is_in_group('Ammo_crate'):
			spawn_bullet(result.position)
			
			#shoot_second_weapon(result.position)
			
		else:
			direction = result.position
			#spawn_bullet(direction)
			shoot_second_weapon(direction)
			print('shooting a rigid body arrow')
			
		
	else:
		spawn_bullet(direction)
		
		
		


func shoot_target_rigid() -> void:

	var space_state = get_world_3d().direct_space_state
	var start: Vector3
	var direction: Vector3

	# Calculate the direction from the crosshair position in the screen space
	var viewport = get_viewport()
	var screen_pos = $\"../Crosshair/Inner_scope/TextureRect\".global_position # crosshair.position
	var mouse_ray = camera_3d.project_ray_origin(screen_pos)
	var ray_dir = camera_3d.project_ray_normal(screen_pos)
	$\"../Crosshair/aim_texture\".position = screen_pos + Vector2(-14.0, -11.0)
	start = mouse_ray #$Crosshair2/Rail_position.global_position
	direction = ray_dir * view_limit  # You can adjust this distance as needed
	
	#print(direction, \" DIRECTION\")
	var end = start + direction
	var query = PhysicsRayQueryParameters3D.create(start, end)
	var result = space_state.intersect_ray(query)
	
	
	var marker
	
	
	if result:
		shoot_second_weapon(direction)
	else:
		shoot_second_weapon(direction)

func prepare_arrow(target_pos: Vector3):
	var new_arrow = ARROW.instantiate()
	get_tree().get_current_scene().add_child(new_arrow)
	new_arrow.set_direction(target_pos)
	new_arrow.global_position = hand_marker.global_position
	
func spawn_bullet_imaginary() -> void:
	
	if firing_weapon:
		return
		
	firing_weapon = true
	$\"../gun/gunsfx\".play(0.2)
	await get_tree().create_timer(0.05).timeout
	
	firing_weapon = false
	camera_3d.shake_camera()
	$\"../Crosshair_3D\".shake_gun()
	$\"../Crosshair\".crosshair_shake()
	$\"../Label\".hide()
	
func spawn_bullet(target_pos: Vector3) -> void:
	
	#await retrieve_bullet()
	$\"../Shot_landing_marker\".global_position = target_pos
	
	if firing_weapon:
		return
		
	firing_weapon = true
	
	#var bullet = $bullet
	var bullet = BULLET.instantiate()
	get_tree().get_current_scene().add_child(bullet)
	
	bullet.hit_something = false
	$\"../gun/gunsfx\".play(0.2)
	#$Shot_landing_marker.show()
	bullet.global_position = $\"../Crosshair_3D/Rail_position\".global_position #$Crosshair2.global_position - Vector3(0,0.05,0)
	await get_tree().create_timer(0.02).timeout
	#bullet.shoot(target_pos, bullet_speed) #RIGID BODY
	bullet.shoot(target_pos)
	
	await get_tree().create_timer(0.05).timeout
	
	firing_weapon = false
	camera_3d.shake_camera()
	$\"../Crosshair_3D\".shake_gun()
	$\"../Crosshair\".crosshair_shake()
	$\"../Label\".hide()
	bullet_speed = 0.0
	
	

func shoot_second_weapon(target_pos : Vector3) -> void:
	#$Shot_landing_marker.global_position = target_pos
	
	if firing_weapon:
		return
		
	firing_weapon = true
	
	#var bullet = $bullet
	var bullet = BULLET_RIGID.instantiate()
	get_tree().get_current_scene().add_child(bullet)
	
	bullet.hit_something = false
	$\"../gun/gunsfx\".play(0.2)
	#$Shot_landing_marker.show()
	bullet.global_position = $\"../Crosshair_3D/Rail_position\".global_position
	await get_tree().create_timer(0.02).timeout
	bullet.shoot(target_pos) #RIGID BODY
	
	
	await get_tree().create_timer(0.05).timeout
	
	firing_weapon = false
	camera_3d.shake_camera()
