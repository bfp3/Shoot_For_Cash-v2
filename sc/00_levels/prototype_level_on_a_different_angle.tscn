[sub_resource type="GDScript" id="GDScript_8p8aj"]
resource_name = "cherries_for_turtle"
script/source = "extends Node3D

var collected := false

func destroy_self() -> void:
	var tween = create_tween()
	tween.tween_property($mesh, \"transparency\", 1.0, 0.5)
	await tween.finished
	self.queue_free()

func _on_area_3d_area_entered(area: Area3D) -> void:
	if area.is_in_group('Turtle') && !collected:
		collected = true
		destroy_self()
"

[sub_resource type="GDScript" id="GDScript_56hwa"]
script/source = "extends Node3D

var collected := false



func destroy_self() -> void:
	var tween = create_tween()
	tween.tween_property($mesh, \"transparency\", 1.0, 0.5)
	await tween.finished
	self.queue_free()

func _on_area_3d_area_entered(area: Area3D) -> void:
	if area.is_in_group('Turtle') && !collected:
		collected = true
		area.get_parent().stop_moving_to_eat()
		#await get_tree().create_timer(1.0).timeout
		%Target_launcher_operator.pineapple_start_round_loop()
		await get_tree().create_timer(20.0).timeout
		area.get_parent().start_moving()
		destroy_self()
"

