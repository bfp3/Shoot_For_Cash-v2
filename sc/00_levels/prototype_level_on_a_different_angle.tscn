[sub_resource type="GDScript" id="GDScript_q7kt8"]
resource_name = "trails_built_in"
script/source = "extends MeshInstance3D
#class_name Trail3D

const MAX_POINTS := 120  # (20 seconds ÷ 0.2s interval = 100, add margin)

var _points = []
var _widths = []
var _lifePoints = []

var _current_index := 0
var _time_since_last_point := 0.0
var _frame_counter := 0

@export var _trailEnabled : bool = true
@export var _fromWidth : float = 0.5
@export var _toWidth : float = 0.0
@export_range(0.5, 1.5) var _scaleAcceleration : float = 1.0
@export var _motionDelta : float = 0.1
@export var _lifespan : float = 20.0
@export var _startColor : Color = Color(1, 1, 1, 1)
@export var _endColor : Color = Color(1, 1, 1, 1)

var _oldPos : Vector3

func _ready() -> void:
	_oldPos = global_transform.origin
	mesh = ArrayMesh.new()

	# Pre-allocate
	_points.resize(MAX_POINTS)
	_widths.resize(MAX_POINTS)
	_lifePoints.resize(MAX_POINTS)
	for i in MAX_POINTS:
		_points[i] = Vector3.ZERO
		_widths[i] = [Vector3.ZERO, Vector3.ZERO, Vector3.ZERO]
		_lifePoints[i] = -1.0  # -1 means inactive

func _process(delta: float) -> void:
	if not _trailEnabled:
		return
	
	if get_global_transform().basis.determinant() == 0.0:
		print(\"⚠️ Warning: Non-invertible basis detected on \", self.name)

	
	# Update time and position
	_time_since_last_point += delta
	if (_oldPos - global_transform.origin).length() > _motionDelta and _time_since_last_point >= 0.2:
		_append_point()
		_time_since_last_point = 0.0
		_oldPos = global_transform.origin

	# Update lifetimes
	for i in MAX_POINTS:
		if _lifePoints[i] >= 0.0:
			_lifePoints[i] += delta
			if _lifePoints[i] > _lifespan:
				_lifePoints[i] = -1.0  # expire point

	# Throttle mesh updates
	_frame_counter += 1
	if _frame_counter % 2 == 0:
		_update_trail_mesh()

func _append_point() -> void:
	var pos = global_transform.origin
	var basis_x = global_transform.basis.x

	_points[_current_index] = pos
	_widths[_current_index] = [basis_x * _fromWidth, basis_x * _fromWidth, -basis_x * _toWidth]
	_lifePoints[_current_index] = 0.0

	_current_index = (_current_index + 1) % MAX_POINTS

func _update_trail_mesh() -> void:
	var st = SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLE_STRIP)

	var valid_indices := []
	for i in range(MAX_POINTS):
		if _lifePoints[i] >= 0.0:
			valid_indices.append(i)

	if valid_indices.size() < 2:
		mesh.clear_surfaces()
		return

	for order in range(valid_indices.size()):
		var i = valid_indices[order]
		var t = float(order) / (valid_indices.size() - 1.0)
		var curr_color = _startColor.lerp(_endColor, 1 - t)

		var base_width = _widths[i][0]
		var taper_width = _widths[i][1]
		var width = base_width

		if taper_width.is_finite() and base_width.is_finite():
			width -= pow(1.0 - t, _scaleAcceleration) * taper_width
		else:
			width = Vector3.ZERO  # fallback to avoid NaN

		var point_pos = _points[i]
	
		var local_pos1 = point_pos + width - global_transform.origin
		var local_pos2 = point_pos - width - global_transform.origin


		if local_pos1.is_finite() and local_pos2.is_finite():
			st.set_color(curr_color)
			st.set_uv(Vector2(t, 0))
			st.add_vertex(local_pos1)

			st.set_color(curr_color)
			st.set_uv(Vector2(t, 1))
			st.add_vertex(local_pos2)

		
		#st.set_color(curr_color)
		#st.set_uv(Vector2(t, 0))
		#st.add_vertex(to_local(point_pos + width))
#
		#st.set_color(curr_color)
		#st.set_uv(Vector2(t, 1))
		#st.add_vertex(to_local(point_pos - width))

	mesh.clear_surfaces()
	st.commit(mesh)
	
	
func detach_from_parent():
	# Stop appending new points
	_trailEnabled = false

	# Convert the trail's global transform to a world-space dummy
	var old_global = global_transform
	var parent = get_parent()

	if parent:
		parent.remove_child(self)

	# Add directly to the scene tree root
	get_tree().root.add_child(self)
	self.global_transform = old_global  # Critical: preserve world transform

	# Start fading and eventually remove
	fade_out_and_destroy_self()

func _reparent_trail(saved_transform: Transform3D) -> void:
	if not is_inside_tree():
		await ready  # Wait if not yet inside the scene tree

	# Add to root or any existing fallback node
	var scene_root = get_tree()
	scene_root.add_child(self)
	
	global_transform = saved_transform  # Restore world-space position

	fade_out_and_destroy_self()


func fade_out_and_destroy_self() -> void:
	await get_tree().create_timer(_lifespan).timeout
	get_parent().remove_child(self)
	if self != null:
		self.queue_free()
"

