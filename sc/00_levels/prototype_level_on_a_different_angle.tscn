script/source = "extends PathFollow3D

@export var movement_speed := 20.0

var moving := false

func _ready() -> void:
	pass
	#$birds.bird_sfx.playing = false
	#$birds2.bird_sfx.playing = false
	
func start_moving() -> void:
	moving = true
	$birds/birdSFX.play()
	$birds2/birdSFX.play()

func _process(delta: float) -> void:
	if moving:
		progress += delta * movement_speed
"

