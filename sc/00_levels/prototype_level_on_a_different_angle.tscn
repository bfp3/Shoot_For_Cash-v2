[sub_resource type="GDScript" id="GDScript_awb7n"]
resource_name = "target_launcher_container"
script/source = "extends Node3D

@export var time_between_rounds := 5.0
@export var stagger_time_between_launcher_rounds := 1.0

var launcher_nodes: Array = []
var total_launchers := 0
var first_round := true

func _input(event: InputEvent) -> void:
	if Input.is_key_label_pressed(KEY_1):
		start_round_loop()

func _ready() -> void:
	GlobalsPlayerStats.current_round = 0 

	launcher_nodes = get_children().filter(func(c): return c.has_method(\"assign_round_parameters\"))
	total_launchers = launcher_nodes.size()

	GlobalsPlayerStats.current_round = total_launchers

	var bomb_container = get_tree().get_first_node_in_group(\"bomb_container_array\")
	if bomb_container:
		bomb_container.all_bombs_empty.connect(start_round_loop)

	#start_round_loop()

func start_round_loop() -> void:
	
	if !first_round:
		GlobalsPlayerStats.current_round += 1

	await get_tree().create_timer(time_between_rounds).timeout
	run_round()
	await get_tree().create_timer(6.0).timeout
	%Bomb_container_array.start_checking_empty()
	first_round = false
	
func pineapple_start_round_loop() -> void:
	
	if !first_round:
		GlobalsPlayerStats.current_round += 1


	run_round()
	await get_tree().create_timer(6.0).timeout
	%Bomb_container_array.start_checking_empty()
	first_round = false

func run_round() -> void:
	var total_shots = GlobalsPlayerStats.current_round
	var shots_per_launcher = total_shots / total_launchers
	var remainder = total_shots % total_launchers

	for i in range(total_launchers):
		var extra = 1 if i < remainder else 0
		var shots = shots_per_launcher + extra

		var launcher = launcher_nodes[i]
		launcher.assign_round_parameters(shots, 0.0)
		await get_tree().create_timer(stagger_time_between_launcher_rounds).timeout
	
	$\"../Turtle_path/PathFollow3D\".stop_moving()
"

