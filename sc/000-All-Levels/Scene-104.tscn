[sub_resource type="GDScript" id="GDScript_a6srw"]
script/source = "extends Node

const ROCK_PROJECTILE = preload('res://500_sequences/Cannonball_System/Cannonballs/Spotter_projectiles.tscn')
const THROW_SFX = preload('res://400_sounds/Enemy_sfx/enemy_popper_throw_rock.wav')


func start(batch: int, index: int, rock_spawn_pos : Vector3) -> void:
	var pitch_scale = randf_range(0.95,1.05)
	CommonCode.play_sound_instance_pitch_adjusted(THROW_SFX, -29.0, pitch_scale)
	var new_projectile : Standard_Cannonball = ROCK_PROJECTILE.instantiate()
	new_projectile.arc_strength = randf_range(0.12, 0.15) # overridden
	new_projectile.probability_of_special_bomb = 1.0
	new_projectile.travel_speed = 1.0
	
	var targ_colour = %Throwing_patterns.get_throw_target_colour(batch, index)

	if targ_colour == \"RED\":
		new_projectile.travel_speed = 1.0 #POSSIBLE PROBLEM
		new_projectile.arc_strength = 1.0 #1.0 #POSSIBLE PROBLEM
	
	else:
		new_projectile.travel_speed = 1.0 # 1.0 #POSSIBLE PROBLEM
		new_projectile.arc_strength = 1.0 # 1.0 #POSSIBLE PROBLEM
		
	new_projectile.travel_speed = randi_range(4.0, 15.0)
	new_projectile.arc_strength = randf_range(0.05, 0.20)
		
	get_tree().get_current_scene().add_child(new_projectile)
	new_projectile.global_position = rock_spawn_pos
	new_projectile.target_launcher_fire(targ_colour)
"

[sub_resource type="GDScript" id="GDScript_cwnwo"]
script/source = "extends Node

const SMOKESCREEN_ROUND = preload(\"res://200_characters/Enemy_rocks/smoke_bomb_rigidbody.tscn\")
const THROW_SFX = preload('res://400_sounds/Enemy_sfx/enemy_popper_throw_rock.wav')


func start(rock_spawn_pos : Vector3) -> void:
	var pitch_scale = randf_range(0.95,1.05)
	CommonCode.play_sound_instance_pitch_adjusted(THROW_SFX, -29.0, pitch_scale)
	
	var rotation_torque := -0.01
	var throw_speed_x:= 0.0
	var throw_speed_y := 8.5
	var throw_speed_z := -15.0
	var magnitude := 9.0 #10.0
	var aim_at_player := true
	
	var new_rock: RigidBody3D = SMOKESCREEN_ROUND.instantiate()
	get_tree().get_current_scene().add_child(new_rock)
	new_rock.global_position = rock_spawn_pos
	var player = get_tree().get_first_node_in_group('Player')
	var target_position = player.global_transform.origin #  if aim_at_player else egg.global_transform.origin

	var direction = (target_position - rock_spawn_pos).normalized()
	var impulse = direction.normalized() * magnitude
	new_rock.look_at(target_position, Vector3.UP, true)
	new_rock.linear_velocity = Vector3.UP * throw_speed_y
	new_rock.apply_central_impulse(impulse)
	new_rock.apply_torque_impulse(Vector3(rotation_torque, 0.0, 0.0) * magnitude)
	
	
	
#func other() :
	#var new_projectile : Standard_Cannonball = SMOKESCREEN_ROUND.instantiate()
	#new_projectile.arc_strength = randf_range(0.12, 0.15) # overridden
	#new_projectile.probability_of_special_bomb = 1.0
	#new_projectile.travel_speed = 1.0
	#
	#var targ_colour = %Throwing_patterns.get_throw_target_colour(batch, index)
#
	#if targ_colour == \"RED\":
		#new_projectile.travel_speed = 1.0 #POSSIBLE PROBLEM
		#new_projectile.arc_strength = 1.0 #1.0 #POSSIBLE PROBLEM
	#
	#else:
		#new_projectile.travel_speed = 1.0 # 1.0 #POSSIBLE PROBLEM
		#new_projectile.arc_strength = 1.0 # 1.0 #POSSIBLE PROBLEM
		#
	#new_projectile.travel_speed = randi_range(4.0, 15.0)
	#new_projectile.arc_strength = randf_range(0.05, 0.20)
		#
	#get_tree().get_current_scene().add_child(new_projectile)
	#new_projectile.global_position = rock_spawn_pos
	#new_projectile.target_launcher_fire(targ_colour)
"

[sub_resource type="GDScript" id="GDScript_gr7pb"]
script/source = "extends Node3D

@export var all_in_one_place := false
@onready var reference_pos: Marker3D = $Reference_marker

func _ready() -> void:
	if all_in_one_place:
		for i in get_children():
			i.global_position = reference_pos.global_position

func free_markers() -> void:
	for i in get_children():
		if i != Marker3D:
			return
		i.is_occupied = false
"

[sub_resource type="GDScript" id="GDScript_7nk6u"]
script/source = "extends Node3D

signal all_bombs_empty

var checking_for_empty := false

func start_checking_empty() -> void:
	if not checking_for_empty:
		checking_for_empty = true

func remove_everything() -> void:
	if get_children().size() > 0:
		for i in get_children():
			if i != null:
				if i.has_method('was_hit_tween'):
					i.was_hit_tween()
			
			#await get_tree().create_timer(0.1).timeout

func manually_check_if_empty() -> void:
	all_bombs_empty.emit()
	#print(get_child_count(), \" How many balls are left in bomb container\")
	#if checking_for_empty and get_child_count() == 0:
		#checking_for_empty = false
	#all_bombs_empty.emit()
#
	#if get_children().size() > 0:
		#for i in get_children():
			#if i != null:
				#i.queue_free()


func turn_off_checking() -> void:
	if checking_for_empty:
		checking_for_empty = false
		set_process(false)
	
"

[sub_resource type="GDScript" id="GDScript_uqeah"]
script/source = "extends Node

const STANDARD_CANNONBALL_STANDARD = preload(\"res://lib/Cannonball_System/Cannonballs/Standard_cannonball.tscn\")
const LEVEL_3_CANNONBALLS = preload('res://lib/Cannonball_System/Cannonballs/Inherited_Scenes/level_3_cannonballs.tscn')

@export var standard_cannonball := false
@export var level_3_cannonball := false

func _ready() -> void:
	if standard_cannonball:
		$'../Launcher_container'.STANDARD_CANNONBALL = STANDARD_CANNONBALL_STANDARD
		
	if level_3_cannonball:
		$'../Launcher_container'.STANDARD_CANNONBALL = LEVEL_3_CANNONBALLS

	else:
		$'../Launcher_container'.STANDARD_CANNONBALL = STANDARD_CANNONBALL_STANDARD
"

[sub_resource type="GDScript" id="GDScript_s7c0w"]
resource_name = "Launcher_container"
script/source = "extends Node3D


@export var STANDARD_CANNONBALL : PackedScene
@onready var list_of_cannonballs: Node = $'../List_of_cannonballs'

var total_of_cannons_in_level := 0

func _ready() -> void:
	
	if STANDARD_CANNONBALL == null:
		print('didnt set a cannonball')
	
	var children = get_children()
	total_of_cannons_in_level = get_parent().total_of_cannons_in_level
	
	
	while children.size() > total_of_cannons_in_level:
		var to_remove = children.back()
		children.pop_back()  # Remove from our local array
		to_remove.queue_free()
	
	
#func reduce_arc_trajectory() -> void:
	#var children = get_children()
	#for i in children:
		#i.arc_strength = i.arc_strength / 2
		#i.launch_speed = 1.0#i.launch_speed / 2
		#print('it worked')
"

[sub_resource type="GDScript" id="GDScript_lpwer"]
script/source = "extends AudioStreamPlayer

@onready var parent = get_parent()
@export var max_distance = 15.0
@export var max_volume_db = -24.0
@export var min_volume_db = -40.0

func play_sound() -> void:
	distance_from_player()
	if not playing:
		play()

func distance_from_player() -> void:
	var player = get_tree().get_first_node_in_group('Player')
	var distance = parent.global_position.distance_to(player.global_position)
	#print_debug(\"DISTANCE\", distance)
	distance = clamp(distance, 1.0, max_distance)
	var _vol = max_volume_db + (min_volume_db - max_volume_db) * (distance - 1) / (max_distance - 1)
	_vol = clamp(_vol, min_volume_db, max_volume_db)
	self.volume_db = _vol
"

