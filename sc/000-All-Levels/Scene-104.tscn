[sub_resource type="GDScript" id="GDScript_a6srw"]
script/source = "extends Node

const ROCK_PROJECTILE = preload('res://500_sequences/Cannonball_System/Cannonballs/Spotter_projectiles.tscn')
const THROW_SFX = preload('res://400_sounds/Enemy_sfx/enemy_popper_throw_rock.wav')


func start(batch: int, index: int, rock_spawn_pos : Vector3) -> void:
	var pitch_scale = randf_range(0.95,1.05)
	CommonCode.play_sound_instance_pitch_adjusted(THROW_SFX, -29.0, pitch_scale)
	var new_projectile : Standard_Cannonball = ROCK_PROJECTILE.instantiate()
	new_projectile.arc_strength = randf_range(0.12, 0.15) # overridden
	new_projectile.probability_of_special_bomb = 1.0
	new_projectile.travel_speed = 1.0
	
	var targ_colour = %Throwing_patterns.get_throw_target_colour(batch, index)

	if targ_colour == \"RED\":
		new_projectile.travel_speed = 1.0 #POSSIBLE PROBLEM
		new_projectile.arc_strength = 1.0 #1.0 #POSSIBLE PROBLEM
	
	else:
		new_projectile.travel_speed = 1.0 # 1.0 #POSSIBLE PROBLEM
		new_projectile.arc_strength = 1.0 # 1.0 #POSSIBLE PROBLEM
		
	new_projectile.travel_speed = randi_range(4.0, 15.0)
	new_projectile.arc_strength = randf_range(0.05, 0.20)
		
	get_tree().get_current_scene().add_child(new_projectile)
	new_projectile.global_position = rock_spawn_pos
	new_projectile.target_launcher_fire(targ_colour)
"

[sub_resource type="GDScript" id="GDScript_cwnwo"]
script/source = "extends Node

const SMOKESCREEN_ROUND = preload(\"res://200_characters/Enemy_rocks/smoke_bomb_rigidbody.tscn\")
const THROW_SFX = preload('res://400_sounds/Enemy_sfx/enemy_popper_throw_rock.wav')


func start(rock_spawn_pos : Vector3) -> void:
	var pitch_scale = randf_range(0.95,1.05)
	CommonCode.play_sound_instance_pitch_adjusted(THROW_SFX, -29.0, pitch_scale)
	
	var rotation_torque := -0.01
	var throw_speed_x:= 0.0
	var throw_speed_y := 8.5
	var throw_speed_z := -15.0
	var magnitude := 9.0 #10.0
	var aim_at_player := true
	
	var new_rock: RigidBody3D = SMOKESCREEN_ROUND.instantiate()
	get_tree().get_current_scene().add_child(new_rock)
	new_rock.global_position = rock_spawn_pos
	var player = get_tree().get_first_node_in_group('Player')
	var target_position = player.global_transform.origin #  if aim_at_player else egg.global_transform.origin

	var direction = (target_position - rock_spawn_pos).normalized()
	var impulse = direction.normalized() * magnitude
	new_rock.look_at(target_position, Vector3.UP, true)
	new_rock.linear_velocity = Vector3.UP * throw_speed_y
	new_rock.apply_central_impulse(impulse)
	new_rock.apply_torque_impulse(Vector3(rotation_torque, 0.0, 0.0) * magnitude)
	
	
	
#func other() :
	#var new_projectile : Standard_Cannonball = SMOKESCREEN_ROUND.instantiate()
	#new_projectile.arc_strength = randf_range(0.12, 0.15) # overridden
	#new_projectile.probability_of_special_bomb = 1.0
	#new_projectile.travel_speed = 1.0
	#
	#var targ_colour = %Throwing_patterns.get_throw_target_colour(batch, index)
#
	#if targ_colour == \"RED\":
		#new_projectile.travel_speed = 1.0 #POSSIBLE PROBLEM
		#new_projectile.arc_strength = 1.0 #1.0 #POSSIBLE PROBLEM
	#
	#else:
		#new_projectile.travel_speed = 1.0 # 1.0 #POSSIBLE PROBLEM
		#new_projectile.arc_strength = 1.0 # 1.0 #POSSIBLE PROBLEM
		#
	#new_projectile.travel_speed = randi_range(4.0, 15.0)
	#new_projectile.arc_strength = randf_range(0.05, 0.20)
		#
	#get_tree().get_current_scene().add_child(new_projectile)
	#new_projectile.global_position = rock_spawn_pos
	#new_projectile.target_launcher_fire(targ_colour)
"

[sub_resource type="GDScript" id="GDScript_gr7pb"]
script/source = "extends Node3D

@export var all_in_one_place := false
@onready var reference_pos: Marker3D = $Reference_marker

func _ready() -> void:
	if all_in_one_place:
		for i in get_children():
			i.global_position = reference_pos.global_position

func free_markers() -> void:
	for i in get_children():
		if i != Marker3D:
			return
		i.is_occupied = false
"

[sub_resource type="GDScript" id="GDScript_7few3"]
script/source = "extends Node3D

@onready var rumble_sound: AudioStreamPlayer = $Rumble_sound
@onready var rumble_sound_2: AudioStreamPlayer = $Rumble_sound2


func rumble_effect_tween() -> void:
	rumble_sound.play()
	rumble_sound_2.play()
	for i in range(10):
		var tween = create_tween().set_ease(Tween.EASE_IN_OUT).set_trans(Tween.TRANS_CUBIC)
		tween.tween_property(self, \"rotation_degrees:y\", -2.2, 0.1)
		tween.tween_property(self, \"rotation_degrees:y\", 2.2, 0.1)
		#tween.tween_property(self, \"rotation_degrees:y\", 0.0, 0.1)
		await tween.finished

	var tween_2 = create_tween().set_ease(Tween.EASE_IN_OUT).set_trans(Tween.TRANS_CUBIC)
	tween_2.tween_property(self, \"rotation_degrees:y\", 0.0, 0.8)
	await tween_2.finished
"

