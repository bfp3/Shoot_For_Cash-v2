[sub_resource type="GDScript" id="GDScript_jc3wt"]
script/source = "extends Node3D

@export var magnitude := 0.8
@onready var egg : Egg_Cage = get_tree().get_first_node_in_group(\"Egg_Cage\")

@export var full_range_pulse := false

func _ready() -> void:
	#pass
	EventBus.instance.egg_pulsed.connect(bounce_rocks)
	
func bounce_rocks() -> void:
	if full_range_pulse:
		full_range()
		return
	
	
	var egg_pos : Vector3 = egg.global_position
	var bodies = get_children()

	for body in bodies:
		if body is RigidBody3D:
			var body_x = body.global_position.x
			var egg_x := egg_pos.x

			# Check if body is within ±2 units on X axis from the egg
			if abs(body_x - egg_x) <= 2.0:
				var x_variation = randf_range(-1.0, 1.0)
				var z_variation = randf_range(-1.0, 1.0)
				var upward_force = randf_range(7.0, 10.0)
				var impulse = Vector3(x_variation, upward_force, z_variation) * magnitude
				body.apply_central_impulse(impulse)
				
func full_range() -> void:
	var bodies = get_children()
	for body in bodies:
		if body is RigidBody3D:
			var x_variation = randf_range(-1.0, 1.0)
			var z_variation = randf_range(-1.0, 1.0)
			var upward_force = randf_range(7.0, 10.0)
			var impulse = Vector3(x_variation, upward_force, z_variation) * magnitude
			body.apply_central_impulse(impulse)
"

