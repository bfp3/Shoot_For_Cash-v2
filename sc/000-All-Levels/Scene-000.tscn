[sub_resource type="GDScript" id="GDScript_s767m"]
script/source = "extends Control

@onready var anim: AnimatedSprite2D = $AnimatedSprite2D
@onready var bg_black: ColorRect = $BG_black

func _ready() -> void:
	anim.modulate = Color.TRANSPARENT
	bg_black.modulate = Color.TRANSPARENT
	anim.global_position = get_viewport_rect().get_center()
	var tween = create_tween()
	tween.tween_property(bg_black, \"modulate\", Color.WHITE, 0.25)

func bh_Activate(parent : Node3D, behaviour : String) -> void:
	var tokens = behaviour.strip_edges().split(\"-\", false)

	for token in tokens:
		var name = token.strip_edges().to_lower()
		match name:
			\"show_logo\":
				fade_in()
				
			\"hide_logo\":
				fade_out()
		
			_:
				push_error(\"Unknown behavior name: '%s'\" % name)
				
func fade_in() -> void:
	var tween = create_tween()
	tween.tween_interval(1.0)
	tween.tween_property(anim, \"modulate\", Color.WHITE, 0.75)
	await tween.finished
	
func fade_out() -> void:
	var tween = create_tween().set_parallel()
	tween.tween_property(anim, \"modulate\", Color.TRANSPARENT, 1.0)
	tween.tween_property($BG_black, \"modulate\", Color.TRANSPARENT, 1.0)
"

