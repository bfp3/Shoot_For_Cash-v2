[sub_resource type="GDScript" id="GDScript_cgnp6"]
script/source = "extends DirectionalLight3D

var tween_move : Tween = null

func bh_Activate(parent : Node3D, behaviour : String) -> void:
	var sun_instructions = behaviour.strip_edges().split(\"-\", false)
	match behaviour:
		\"lower\":
			var increment : float = 5.0
			tween_new_pos(increment)
		\"higher\":
			var increment : float = -5.0
			tween_new_pos(increment)
			
		\"horizon\":
			var increment : float = 0.0
			tween_sunset()

		_:
			print('I am freaking out')

func tween_new_pos(increment : float) -> void:
	if tween_move:
		tween_move.kill()
	
	tween_move = create_tween().set_ease(Tween.EASE_IN_OUT)
	tween_move.tween_property(self, \"rotation_degrees:x\", increment, 5.0).as_relative()
	
	
func tween_sunset() -> void:
	if tween_move:
		tween_move.kill()
	
	tween_move = create_tween().set_ease(Tween.EASE_IN_OUT)
	tween_move.tween_property(self, \"rotation_degrees:x\", 0.0, 5.0)
	tween_move.tween_property(self, \"light_energy\", 0.0, 5.0)
"

