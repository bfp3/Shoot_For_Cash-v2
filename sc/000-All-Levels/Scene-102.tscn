[sub_resource type="GDScript" id="GDScript_od3ce"]
script/source = "extends Node3D

@export var magnitude := 0.8
@export var weight := 2.0
@export var ripple_speed := 20.0 # Units per second - higher means faster ripple

@onready var egg : Egg_Cage = get_tree().get_first_node_in_group(\"Egg_Cage\")

func _ready() -> void:
	for body in get_children():
		if body is RigidBody3D:
			body.mass = weight
	EventBus.instance.egg_pulsed.connect(full_range)


func full_range() -> void:
	var distance = global_position.distance_to(egg.global_position)
	var delay = distance / ripple_speed
	
	await get_tree().create_timer(delay).timeout
	
	for body in get_children():
		if body is RigidBody3D:
			var x_variation = randf_range(-1.0, 1.0)
			var z_variation = randf_range(-1.0, 1.0)
			var upward_force = randf_range(7.0, 10.0)
			var impulse = Vector3(x_variation, upward_force, z_variation) * magnitude
			body.apply_central_impulse(impulse)
"

