[sub_resource type="GDScript" id="GDScript_nih03"]
script/source = "extends Node3D

@onready var animation_player: AnimationPlayer = $AnimationPlayer


func bh_Activate(parent : Node3D, behaviour : String) -> void:
	var tokens = behaviour.strip_edges().split(\"-\", false)

	for token in tokens:
		var name = token.strip_edges().to_lower()
		match name:
			\"slow\":
				animation_player.speed_scale = 0.2
			\"medium\":
				animation_player.speed_scale = 0.4
			\"fast\":
				animation_player.speed_scale = 1.0
			\"fastest\":
				animation_player.speed_scale = 5.0

			_:
				push_error(\"Unknown behavior name: '%s'\" % name)
"

