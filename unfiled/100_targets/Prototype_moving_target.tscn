[sub_resource type="GDScript" id="GDScript_tm76r"]
script/source = "extends Node3D

@export var start_marker : Marker3D
@export var end_marker : Marker3D
@export var move_speed := 0.5

func _ready() -> void:
	move_target()
	global_position = start_marker.global_position
	
func move_target() -> void:
	var tween = create_tween().set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_CUBIC)
	tween.tween_property(self, \"global_position\", end_marker.global_position, move_speed)
	#tween.parallel().tween_property(self, \"scale\", Vector3.ONE * 0.2, move_speed / 2)
	#tween.tween_property(self, \"global_position\", start_marker.global_position, move_speed)
	await tween.finished
	reset_target()
	
func reset_target() -> void:
	global_position = start_marker.global_position
	scale = Vector3.ONE
	move_target()
"

[sub_resource type="GDScript" id="GDScript_u3bs4"]
script/source = "extends Node3D

var hit := false
@export var rotation_amount := 360.0
@export var rotating_dur := 0.5

@export var point_value := 100.0

func player_hit_me() -> void:
	if !hit:
		hit = true
		was_shot_tween()
		update_score()

func was_shot_tween() -> void:
	var tween = create_tween().set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_CUBIC)
	tween.tween_property(self, \"rotation_degrees:x\", -rotation_amount, rotating_dur).as_relative()
	await tween.finished
	hit = false
 
func update_score() -> void:
	var score = get_tree().get_first_node_in_group(\"score_count\")
	score.update_score(point_value)

func _on_area_3d_area_entered(area: Area3D) -> void:
	if area.is_in_group('arrow'):
		player_hit_me()
		var parent = area.get_parent()
		if parent.has_method('destroy_self'):
			parent.destroy_self()
"

