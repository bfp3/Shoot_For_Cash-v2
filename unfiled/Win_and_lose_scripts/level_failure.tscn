script/source = "extends Control
#@onready var texture_rect: TextureRect = $Radar_view_panel/Sub_root_control/Radar_arm/TextureRect
#
#var shader_mat : ShaderMaterial
#var tween_node : Tween
#
#func _ready() -> void:
	#shader_mat = texture_rect.material
	#if shader_mat is ShaderMaterial:
		#shader_mat.set_shader_parameter(\"bg_color\", Color.TRANSPARENT) # Set starting value
		#shader_mat.set_shader_parameter(\"arm_color\", Color.TRANSPARENT) # Set starting value
		#shader_mat.set_shader_parameter(\"pulse_color\", Color.TRANSPARENT) # Set starting value
	#modulate =  Color('FFFFFF00')
	#fade_in()
	#
	#await get_tree().create_timer(3.0).timeout
	#$'../SFX/RandomSound1'.play()
	#
	#shader_fade_in(Color('b3b3b30a'), 3.0)
#
#
#func fade_in() -> void:
	#var tween = create_tween().set_trans(Tween.TRANS_LINEAR)
	##tween.tween_interval(2.0)
	#tween.tween_property(self, \"modulate\", Color('FFFFFF'), 2.0)
	#tween.parallel().tween_property($TextureRect, \"modulate\", Color('FFFFFF'), 2.0)
#
#
#func shader_fade_in(target_value: Color, duration : float) -> void:
		#
	#if shader_mat == null:
		#return
	#
	#tween_node = create_tween().set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT)
	#
	#var start_value = shader_mat.get_shader_parameter(\"bg_color\")
	#
	#tween_node.tween_method(
		#func(val):
			#shader_mat.set_shader_parameter(\"bg_color\", val), start_value, target_value, duration)
#
	#await tween_node.finished
"

