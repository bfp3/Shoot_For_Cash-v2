[sub_resource type="GDScript" id="GDScript_nhn7o"]
script/source = "extends Node3D

const LAUNCHING_TARGET = preload(\"res://300_assets/100_targets/Launching_target.tscn\")

@export var launch_speed: float = 5.0  # Controls how fast the target moves
@export var arc_strength: float = 0.5   # Controls the height of the launch arc

@export var original_launch_speed : float = 5.0
@export var pineapple_launcher := false
@export var is_active := false
@onready var mesh: Node3D = $mesh

@onready var smoke_particles_gpu: GPUParticles3D = $Smoke_quick2
var counter := 0
@onready var marker_3d: Marker3D = %Marker3D

signal bomb_launched

var target_position

var pineapple_shot := false

func _ready() -> void:
	
	original_launch_speed = launch_speed
	return
	#if !is_active:
		#$Timer.stop()
	#else:
		#$Timer.start(randi_range(1,2))
		
func visual_fire():
	mesh_launcher_tween()
	
func assign_round_parameters(shots: int, interval: float) -> void:

	for i in shots:
		prepare_target_for_launch()
		await get_tree().create_timer(0.5).timeout


func _on_round_timer_timeout() -> void:
	var shots_to_fire = get_meta(\"shots_to_fire\")
	if counter < shots_to_fire:
		_on_timer_timeout()
	else:
		$Timer.stop()


func _on_timer_timeout() -> void:
	#return
	counter +=1 
	if counter >= 4:
		return
		
	prepare_target_for_launch()
	
	launch_speed = original_launch_speed
	$Timer.start(1.0)

func stop_timer() -> void:
	$Timer.stop()


func prepare_target_for_launch() -> void:
	
	var target_instance = LAUNCHING_TARGET.instantiate()

	target_instance.slow_travel_time = launch_speed * 2
	target_instance.fast_travel_time = launch_speed * 2
	target_instance.travel_time = launch_speed
	target_instance.arc_strength = arc_strength
	
	var bomb_container_array = get_tree().get_first_node_in_group(\"bomb_container_array\")
	bomb_container_array.add_child(target_instance)
	
	if pineapple_shot:
		target_instance.pineapple.show()
		target_instance.bomb_mesh.hide()
		
	else:
		target_instance.pineapple.hide()
		target_instance.bomb_mesh.show()
	
	target_instance.global_position = %Marker3D.global_position
	await launching_tween(target_instance)
	
	target_instance.target_launcher_fire()

func play_launch_animation(target_instance: Node3D) -> void:
	launching_tween(target_instance)
	


func mesh_launcher_tween() -> void:
	var launcher_tween = create_tween().set_trans(Tween.TRANS_CUBIC)
	launcher_tween.tween_property(mesh, \"global_position:y\", -0.05, 0.75).as_relative().set_ease(Tween.EASE_IN)
	launcher_tween.tween_interval(0.15)
	launcher_tween.tween_property(mesh, \"global_position:y\", 0.05, 1.5).as_relative().set_ease(Tween.EASE_OUT)
	await launcher_tween.finished

func launching_tween(target_instance : Node3D) -> void:
	
	#mesh_launcher_tween()
	target_instance.scale = Vector3.ONE / 10
	#var SMOKE_LINGERING = load(\"res://800_3D_materials/Particles/Smoke_particles/Smoke_lingering.tscn\")
	#CommonCode.spawn_particles(SMOKE_LINGERING, 15.0, $Marker3D.global_position + Vector3(0,0.5,0), true)
	
	var tween = create_tween().set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_CUBIC)
	#tween.tween_interval(0.74)
	#smoke_particles_2()
	#smoke_particles()
	tween.tween_callback(smoke_particles)
	tween.tween_callback(smoke_particles_2)
	tween.tween_property(target_instance, \"scale\", Vector3.ONE / 2, 0.15)
	await tween.finished
	firing_sequence()
	
	#bomb_launched.emit()
	
func smoke_particles() -> void:
	#CommonCode.spawn_particles()
	var new_particles = $Smoke_quick2.duplicate()
	get_tree().get_current_scene().add_child(new_particles)
	new_particles.show()
	new_particles.global_position = %Marker3D.global_position + Vector3(0,0.5,0) # $Smoke_quick2.position 
	new_particles.emitting = true
	new_particles.duplicate_particles = true

func smoke_particles_2() -> void:
	#CommonCode.spawn_particles()
	var new_particles_2 = $Smoke_quick3.duplicate()
	get_tree().get_current_scene().add_child(new_particles_2)
	new_particles_2.show()
	new_particles_2.global_position =  %Marker3D.global_position + Vector3(0,0.5,0) #$Smoke_quick3.position
	new_particles_2.emitting = true
	new_particles_2.duplicate_particles = true

func firing_sequence() -> void:
	
	if $launch_sound:
		var launch_sound = $launch_sound #.play(0.15)
		CommonCode.play_sound_duplicate_instance(launch_sound, 0.15, launch_sound.volume_db)
		
func smoke_up() -> void:
	if $launch_sound:
		var launch_sound = $launch_sound
		var launch_sound_dup = preload(\"res://400_sounds/00_sfx/Arrow_release.wav\")
		#CommonCode.play_sound_duplicate_instance(launch_sound, 0.15, launch_sound.volume_db - 5.0)
		var pitch_fluc : float = randf_range(0.05,0.15)
		var vol_fluc =  randf_range(10.0, 15.0)
		CommonCode.play_sound_instance_pitch_adjusted(launch_sound_dup, launch_sound.volume_db - vol_fluc, pitch_fluc)
		smoke_particles_destruction()
		
func smoke_particles_destruction() -> void:
	var new_particles_2 = $Smoke_quick4.duplicate()
	get_tree().get_current_scene().add_child(new_particles_2)
	new_particles_2.show()
	new_particles_2.global_position =  %Marker3D.global_position + Vector3(0,0.5,0) #$Smoke_quick3.position
	new_particles_2.emitting = true
	new_particles_2.duplicate_particles = true
"

[sub_resource type="GDScript" id="GDScript_oowog"]
script/source = "extends AudioStreamPlayer

@onready var parent = get_parent()
@export var max_distance = 15.0
@export var max_volume_db = -24.0
@export var min_volume_db = -40.0

func play_sound() -> void:
	distance_from_player()
	if not playing:
		play()

func distance_from_player() -> void:
	var player = get_tree().get_first_node_in_group('Player')
	var distance = parent.global_position.distance_to(player.global_position)
	#print_debug(\"DISTANCE\", distance)
	distance = clamp(distance, 1.0, max_distance)
	var volume_db = max_volume_db + (min_volume_db - max_volume_db) * (distance - 1) / (max_distance - 1)
	volume_db = clamp(volume_db, min_volume_db, max_volume_db)
	self.volume_db = volume_db
"

