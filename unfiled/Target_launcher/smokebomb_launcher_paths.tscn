[gd_scene load_steps=5 format=3 uid="uid://dug413hyxbcov"]

[sub_resource type="GDScript" id="GDScript_xu3fl"]
script/source = "extends Node3D

const SMOKEBOMB = preload(\"res://500_sequences/Cannonball_System/Cannonballs/Spotter_projectiles_smokebomb.tscn\")
@onready var path_follow_template: PathFollow3D = $'../smokebomb_launcher/PathFollow3D'

func bh_Activate(parent: Node3D, behaviour: String) -> void:
	var tokens = behaviour.strip_edges().split(\"-\", false)

	for token in tokens:
		var name = token.strip_edges().to_lower()
		match name:
			\"detonate\":
				var path = pick_child()
				if path and path is Path3D:
					var new_path_follow = path_follow_template.duplicate() as PathFollow3D
					path.add_child(new_path_follow)
					new_path_follow.owner = get_tree().current_scene  # Ensure it's editable if needed

					var smoke_instance = SMOKEBOMB.instantiate()
					new_path_follow.add_child(smoke_instance)
					smoke_instance.owner = get_tree().current_scene
				else:
					push_error(\"No valid Path3D found to attach the PathFollow3D.\")
			_:
				push_error(\"Unknown behavior name: '%s'\" % name)

func pick_child() -> Node3D:
	var path_nodes = get_children().filter(func(child): return child is Path3D)
	if path_nodes.size() > 0:
		return path_nodes.pick_random()
	else:
		print(\"No Path3D nodes available.\")
		return null
"

