[sub_resource type="GDScript" id="GDScript_lsb76"]
script/source = "extends PathFollow3D


@export var speed := 2.0

func _ready() -> void:
	progress = 0.0

func _process(delta: float) -> void:
	speed += 0.01
	progress += speed * delta
"

