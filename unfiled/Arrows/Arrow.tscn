[sub_resource type="GDScript" id="GDScript_ko242"]
script/source = "extends Node3D

@export var speed: float = 150.0  # Speed at which the object moves
var direction: Vector3 = Vector3.ZERO  # Direction the object will travel in

func _process(delta: float) -> void:
	if direction != Vector3.ZERO:
		translate(direction.normalized() * speed * delta)  # Move the object
		$Arrow_mesh.look_at(global_transform.origin + direction, Vector3.UP, true)

func set_direction(new_direction: Vector3) -> void:
	direction = new_direction

func _on_area_3d_body_entered(body: Node3D) -> void:
	if body.is_in_group('target'):
		pass

func _on_area_3d_area_entered(area: Area3D) -> void:
	if area.is_in_group('target'):
		pass

func _on_timer_timeout() -> void:
	self.queue_free()

func destroy_self() -> void:
	self.queue_free()
"

