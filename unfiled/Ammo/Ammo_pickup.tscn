[sub_resource type="GDScript" id="GDScript_46f5i"]
script/source = "extends Area3D

var ammo_pickup_hit := false
#@export var respawn_time := 100
@export var odds := 1
@export var probability := 2
var contains_ammo := false

var parachuting_in := false

func _ready() -> void:
	# Run probability check
	
	#
	#if randi() % probability < odds:
		#contains_ammo = true
		#add_to_group(\"contains_ammo\")
		#$Ammo_indicator.show()
	#else:
		#add_to_group(\"dud_ammo\")
		#$Ammo_indicator.hide()
	
	if parachuting_in:
		parachute_tween()
	else:
		$Parachute.hide()
	
func _on_body_entered(body: Node3D) -> void:
	if body.is_in_group('bullet') && !ammo_pickup_hit:
		$CollisionShape3D.disabled = true
		ammo_pickup_hit = true
		if contains_ammo:
			increase_player_ammo()
		was_hit_tween()
		if body.has_method('cleanUp'):
			body.cleanUp()


func _on_area_entered(area: Area3D) -> void:
	if area.is_in_group('bullet') && !ammo_pickup_hit:
		increase_player_ammo()
		$CollisionShape3D.disabled = true
		ammo_pickup_hit = true
		#if contains_ammo:
			#increase_player_ammo()
		was_hit_tween()
		smoke_particles()
		if area.has_method('cleanUp'):
			area.cleanUp()

func increase_player_ammo() -> void:
	var ammo = get_tree().get_first_node_in_group('Ammo_management_system')
	if ammo:
		ammo.current_amount_of_cartridges_remaining = clamp(ammo.current_amount_of_cartridges_remaining + 1, 0, ammo.max_number_of_cartridges)
		ammo.current_amount_of_ammo_remaining = clamp(ammo.current_amount_of_ammo_remaining + 6, 0, ammo.total_bullets)
		ammo.reload()


func smoke_particles() -> void:
	var new_particles = $Smoke_quick.duplicate()
	get_tree().get_current_scene().add_child(new_particles)
	
	new_particles.global_position = global_position
	new_particles.emitting = true
	new_particles.duplicate_particles = true


func was_hit_tween() -> void:
	var tween = create_tween().set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_CUBIC)
	tween.tween_property($Mesh, \"scale\", Vector3.ONE * 1.2, 0.1)
	tween.tween_property($Mesh, \"scale\", Vector3.ZERO, 0.15)
	tween.tween_callback($hitSound.play_sound).set_delay(0.05)
	await tween.finished
	destroy_self()
	
func parachute_tween() -> void:
	var parachute = $Parachute
	var parachute_orig_scale : Vector3 = Vector3(1.12,0.355,0.845)
	parachute.scale =  Vector3(0.01, 0.01, 0.01)
	global_position.y = 20.0
	var tween = create_tween().set_trans(Tween.TRANS_CUBIC)
	tween.tween_property(self, \"global_position:y\", 4, 3.0).set_ease(Tween.EASE_IN)
	tween.tween_property(parachute, \"scale\", Vector3(1.12,1.355,0.845), 0.2).set_ease(Tween.EASE_OUT)
	tween.parallel().tween_property(self, \"global_position:y\", -1, 2.0).set_ease(Tween.EASE_IN).as_relative()
	tween.parallel().tween_callback(play_parachute_sound)
	#tween.tween_property(parachute, \"scale\", parachute_orig_scale, 0.15)
	tween.tween_property(self, \"global_position:y\", 0.15 / 2, 6.0).set_ease(Tween.EASE_OUT)
	tween.parallel().tween_callback(floating_tween)
	await tween.finished
	shrink_parachute()
	
func play_parachute_sound() -> void:
	$Ammo_indicator/MeshInstance3D.hide()
	$hitSound.pitch_scale = 0.25
	$hitSound.volume_db = -25.0
	$hitSound.play(0.15)
	
func floating_tween() -> void:
	return
	var tween = create_tween().set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_IN_OUT)
	tween.tween_property(self, \"rotation_degrees:z\", -25.0, 2.0)
	tween.tween_property(self, \"rotation_degrees:z\", 15.0, 2.0)
	tween.tween_property(self, \"rotation_degrees:z\", -45.0, 2.0)
	await tween.finished
		
func shrink_parachute() -> void:
	var parachute = $Parachute
	var tween = create_tween().set_trans(Tween.TRANS_CUBIC)
	#$Parachute/CSGCylinder3D, $Parachute/CSGCylinder3D2, $Parachute/CSGCylinder3D3, $Parachute/CSGCylinder3D4
	
	tween.tween_property($Parachute/CSGCylinder3D, \"transparency\", 1.0, 0.5)
	tween.parallel().tween_property($Parachute/CSGCylinder3D2, \"transparency\", 1.0, 0.5)
	tween.parallel().tween_property($Parachute/CSGCylinder3D3, \"transparency\", 1.0, 0.5)
	tween.parallel().tween_property($Parachute/CSGCylinder3D4, \"transparency\", 1.0, 0.5)
	tween.parallel().tween_property(parachute, \"global_position:y\", 10.0, 3.0).set_ease(Tween.EASE_IN).as_relative()
	#tween.tween_property(parachute, \"scale\", Vector3(0.01, 0.01, 0.01), 0.75).set_ease(Tween.EASE_IN)
	#tween.tween_property(parachute, \"transparency\", 1.0, 0.75).set_ease(Tween.EASE_IN)
	await tween.finished
	parachute.hide()
	
	#ammo_pickup_hit = false
func destroy_self() -> void:
	var parent = get_parent()
	if parent is RigidBody3D:
		parent.queue_free()
	else:
		self.queue_free()
"

