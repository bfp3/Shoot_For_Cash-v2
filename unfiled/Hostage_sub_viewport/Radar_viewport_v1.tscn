[gd_scene load_steps=4 format=3 uid="uid://bn03x4wr4kdbd"]

[sub_resource type="GDScript" id="GDScript_4hj2f"]
script/source = "extends Control

@onready var sub_viewport: SubViewport = $Sub_root_control/SubViewportContainer/SubViewport
@onready var sub_control: Control = $Sub_root_control

@export var sub_view_camera : Camera3D
@export var scale_amount := 5
var expanding := false

var orig_scale : Vector2
var orig_pos : Vector2
@export var expand_repos : Vector2 = Vector2(400, 200.0)

func _ready() -> void:
	expand_repos = $Marker2D.global_position
	orig_scale = sub_control.scale
	orig_pos = sub_control.global_position
	sub_view_camera.reparent(sub_viewport)


func _on_button_pressed() -> void:
	if expanding:
		return
	expanding = true
	
	#sub_viewport.size = sub_viewport.size 
	
	#return
	var dur : float = 0.5
	var tween = create_tween().set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_LINEAR)
	#tween.tween_property(sub_viewport, \"size\", sub_viewport.size * scale_amount, dur)
	tween.tween_property(sub_control, \"scale\", sub_control.scale * scale_amount, dur)
	#tween.parallel().tween_property(sub_control, \"global_position\", expand_repos, dur)
	tween.tween_interval(1.0)
	tween.tween_property(sub_control, \"scale\", Vector2.ONE, dur)
	#tween.tween_property(sub_viewport, \"size\", Vector2i(256,180), dur / 2)
	#tween.parallel().tween_property(sub_control, \"global_position\", orig_pos, dur / 2)
	await tween.finished
	
	expanding = false
"

