[sub_resource type="GDScript" id="GDScript_hcy87"]
script/source = "extends Control

const BASIC_THEME = preload(\"res://700_2D_nodes_UI/Fonts/Themes/Basic theme.tres\")

@export var timer_mode := true # True for timer mode, False for countdown mode
@export var total_time_limit := 300 # Initial time in seconds (e.g., 300 seconds = 5 minutes)
@export var activated := true
@onready var label: Label = $Label
var timer_stopped := false

var time_elapsed: float = 0.0  # Custom time tracker, starts at 0
var time_remaining: float = 0.0
var time_remainder: float = 0.0
@onready var tick_sound: AudioStreamPlayer = $tick_sound
const CLOCK_TICK = preload(\"res://400_sounds/Placeholder_SFX/Clock_tick.wav\")
const CLOCK_TICK_URGENT = preload(\"res://400_sounds/gun_sfx/timer_running_out_sfx.wav\")


signal timed_out
signal ammo_countdown_finished


var sfx_timer : Timer

func one_second_gone() -> void:
	if timer_stopped:
		return
	
	var volume = -49.0

	if time_remainder <= 20.0:
		$Label.label_settings.font_color =  Color(\"FFFFFF\")
		$Label.label_pulsing_tween()
		volume = -40.0
	if time_remainder <= 10.0:
		#$Label.modulate = Color.RED
		#$Label.label_settings.font_color = Color.DARK_RED
		#volume = -25.0
		volume = -38.0
		CommonCode.play_sound_instance(CLOCK_TICK_URGENT, volume)
		
	if time_remainder <= 5.0:
		#$Label.modulate = Color.DARK_RED
		volume = -36.0
		CommonCode.play_sound_instance(CLOCK_TICK_URGENT, volume)
		
	if time_remainder <= 3.0:
		#volume = -35.0
		CommonCode.play_sound_instance(CLOCK_TICK_URGENT, volume)
		
	else:
		CommonCode.play_sound_instance_pitch_adjusted(CLOCK_TICK, volume, 5.0)

func _ready() -> void:
	
	var continue_screen = get_tree().get_first_node_in_group(\"continue_screen\")
	if continue_screen:
		continue_screen.reset_timer.connect(reset_timer)
	hide()


func initialise_timer() -> void:
	if !activated:
		return
	label.pivot_offset = label.size / 2
	var level = get_tree().get_first_node_in_group(\"level_root\")
	if level:
		total_time_limit = level.timer_start_time
	tween()
	set_process(false)
	
	# Start a timer to call one_second_gone() every second
	sfx_timer = Timer.new()
	sfx_timer.wait_time = 1.0
	sfx_timer.one_shot = false
	sfx_timer.timeout.connect(one_second_gone)
	add_child(sfx_timer)

func tween() -> void:
	var dur : float = 3.0
	show()
	if activated:
		time_remaining = total_time_limit
		update_label(time_remaining * 1000)  # Show time in milliseconds
	else:
		self.visible = false
	
	var tween = create_tween().set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_CUBIC)
	tween.tween_property(label, \"modulate\", Color('ffffff00'), 0.01)
	tween.tween_property(label, \"modulate\", Color('ffffff'), dur)
	tween.tween_property(label, \"position:y\", 2, dur).as_relative()
	tween.parallel().tween_property(label, \"scale\", Vector2(1, 1), dur)
	await tween.finished

	activated = true
	if sfx_timer:
		sfx_timer.start(1.0)
		set_process(true)

func _process(_delta: float) -> void:
	if activated:
		time_elapsed += _delta  # Increment time_elapsed based on _delta
		var remaining_time = total_time_limit - time_elapsed  # Calculate remaining time
		time_remainder = remaining_time
		if remaining_time <= 0:
			activated = false  # Stop when time runs out
			remaining_time = 0  # Ensure no negative time
			on_timer_end()

		update_countdown(remaining_time)  # Update with remaining time

func update_countdown(remaining_time: float) -> void:
	if remaining_time > 0:
		update_label(int(remaining_time * 1000))  # Update the label in milliseconds
	else:
		on_timer_end()

func update_label(current_time: int) -> void:
	var minutes = current_time / 1000 / 60
	var seconds = current_time / 1000 % 60
	var msec = current_time % 1000 / 10
	var minute_str = str(minutes).pad_zeros(2)
	var second_str = str(seconds).pad_zeros(2)
	label.text = minute_str + \":\" + second_str

func on_timer_end() -> void:
	timer_stopped = true
	sfx_timer.stop()
	timed_out.emit()  # Emit signal when time is up
	ammo_countdown_finished.emit()
	set_process(false)
	$Label.stop_flashing()

func reset_timer() -> void:
	time_elapsed = 0.0
	time_remainder = total_time_limit
	timer_stopped = false
	activated = true

	update_label(int(time_remainder * 1000))
	$Label.label_settings.font_color = Color(\"FFFFFF\")
	$Label.stop_flashing()

	# Restart the sfx timer
	if sfx_timer == null:
		sfx_timer = Timer.new()
		sfx_timer.wait_time = 1.0
		sfx_timer.one_shot = false
		sfx_timer.timeout.connect(one_second_gone)
		add_child(sfx_timer)
	else:
		if not sfx_timer.is_stopped():
			sfx_timer.stop()
	sfx_timer.start()

	# Resume processing
	set_process(true)

	# Optionally show and reanimate the label
	show()

func stop_timer_lose_condition() -> void:
	
	if sfx_timer != null:
		sfx_timer.stop()
		sfx_timer.queue_free()
	set_process(false)
	var tween = create_tween().set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_CUBIC)
	tween.tween_property(self, \"modulate\", Color('ffffff00'), 1.0)
"

