[sub_resource type="GDScript" id="GDScript_lgvvv"]
script/source = "extends Label
@onready var panel: Panel = $\"../Panel\"

var started_to_pulse := false

var tween_flash : Tween = null

func _ready() -> void:
	panel.hide()

func label_pulsing_tween() -> void:
	if started_to_pulse:
		return
	
	var dur : float = 0.5
	panel.show()
	tween_flash = create_tween().set_loops()
	tween_flash.tween_property(panel, \"modulate\", Color('ffffff'), 0.15)
	tween_flash.tween_property(panel, \"modulate\", Color('ffffff20'), 0.85)
	#tween.tween_property(self, \"modulate\", Color('ffffff00'), dur)
	await tween_flash.finished

func stop_flashing() -> void:
	if started_to_pulse:
		if tween_flash:
			tween_flash.kill()
			tween_flash.stop()
"

