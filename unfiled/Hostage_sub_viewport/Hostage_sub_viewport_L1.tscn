const LOW_HEALTH = preload(\"res://400_sounds/Incidental_music/Metronome_SFX/Space_arp_80bpm - Theyre_coming.wav\")

func hostage_low_on_health() -> void:
	CommonCode.play_sound_instance(LOW_HEALTH, -5.0)
"

