script/source = "extends Control


func _ready() -> void:
	hide()
	
func fade_in_king_egg_face() -> void:
	modulate = Color.TRANSPARENT
	show()
	var tween = create_tween().set_ease(Tween.EASE_IN)
	tween.tween_property(self, \"modulate\", Color.WHITE, 0.5)
	await tween.finished
"

[sub_resource type="GDScript" id="GDScript_sn2bn"]
script/source = "extends Control

@onready var left_eye: TextureRect = $Eyes/left_eye
@onready var right_eye: TextureRect = $Eyes/right_eye
@onready var left_eyebrow: TextureRect = $Eyes/left_eyebrow
@onready var right_eyebrow: TextureRect = $Eyes/right_eyebrow

var left_eye_default_pos : Vector2 = Vector2(104.0, 74.0)
var right_eye_default_pos : Vector2 = Vector2(122.0, 74.0)

@export var y_limit_up := 68.0
@export var y_limit_down := 80.0

@export var left_eye_leftmost_side_limit := 96.0
@export var left_eye_rightmost_side_limit := 108.0

@export var eyebrow_move_up := 0.2
@export var eyebrow_move_down := 0.2

@export var eyebrow_rotation_min := 0.1  # Minimum rotation (in degrees)
@export var eyebrow_rotation_max := 0.2  # Maximum rotation (in degrees)

const EYE_X_DISTANCE := 10.0

func _ready():
	var orig_modulate = self.modulate
	self.modulate = Color('FFFFFF')
	
	var hostage_cage = get_tree().get_first_node_in_group(\"Egg_Cage\")
	if hostage_cage:
		hostage_cage.taken_a_hit_from_a_target.connect(shake_hostage_face_viewport)
	
	start_eye_animation()
	#var tween_modulate = create_tween().set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT)
	#tween_modulate.tween_property(self, \"modulate\", orig_modulate, 5.0).set_delay(1.0)
	

func start_eye_animation():
	randomize()
	look_around()

func look_around():
	var delay = randf_range(0.3, 1.5)

	# Pick a random position for the left eye within its limits
	var left_target_x = randf_range(left_eye_leftmost_side_limit, left_eye_rightmost_side_limit)
	
	# Calculate the right eye's X position based on the fixed distance
	var right_target_x = left_target_x + EYE_X_DISTANCE
	
	# Clamp the right eye position to its limits
	right_target_x = clamp(right_target_x, left_eye_rightmost_side_limit + EYE_X_DISTANCE, 588.816)  # Assuming the right side limit
	left_target_x = right_target_x - EYE_X_DISTANCE  # Recalculate left eye position

	# Pick a random position for the Y-axis
	var target_y = randf_range(y_limit_up, y_limit_down)
	
	# Choose a random speed for the animation
	var speed = randf_range(0.6, 1.5)

	# Create tweens for both eyes
	var tween_left = create_tween()
	var tween_right = create_tween()

	# Animate the left eye
	tween_left.tween_property(left_eye, \"position\", Vector2(left_target_x, target_y), speed).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
	
	# Animate the right eye
	tween_right.tween_property(right_eye, \"position\", Vector2(right_target_x, target_y), speed).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)

	# Call the look_around function again after a random delay
	tween_right.tween_callback(Callable(self, \"look_around\")).set_delay(delay)

	# Eyebrow animations
	move_eyebrows()

func move_eyebrows():
	# Randomize vertical movement and rotation
	var eyebrow_move_y = randf_range(-eyebrow_move_down, eyebrow_move_up)
	var eyebrow_rotation = randf_range(eyebrow_rotation_min, eyebrow_rotation_max)
	var speed = randf_range(0.6, 1.8)

	# Create tweens for both eyebrows
	var tween_left_eyebrow = create_tween()
	var tween_right_eyebrow = create_tween()

	# Animate the left eyebrow (vertical and rotation)
	tween_left_eyebrow.tween_property(left_eyebrow, \"position\", left_eyebrow.position + Vector2(0, eyebrow_move_y), speed).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
	tween_left_eyebrow.tween_property(left_eyebrow, \"rotation\", eyebrow_rotation, speed).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)

	# Animate the right eyebrow (vertical and rotation)
	tween_right_eyebrow.tween_property(right_eyebrow, \"position\", right_eyebrow.position + Vector2(0, eyebrow_move_y), speed).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
	tween_right_eyebrow.tween_property(right_eyebrow, \"rotation\", eyebrow_rotation, speed).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)


func shake_hostage_face_viewport() -> void:
	#%Scared.hide()
	#%Squinting.show()
	
	var viewport = get_parent().get_parent()
	var dur : float = 0.05
	for i in range(8):
		var tween = create_tween().set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT)
		tween.tween_property(viewport, \"rotation\", -0.02, dur)
		tween.tween_property(viewport, \"rotation\", 0.02, dur)
		tween.tween_property(viewport, \"rotation\", 0.0, dur)
		await tween.finished
	
	#%Scared.show()
	#%Squinting.hide()
"

