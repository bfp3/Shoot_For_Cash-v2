[sub_resource type="GDScript" id="GDScript_r570y"]
script/source = "#@tool
extends Control

#@export_tool_button('Present') var start_intro = play_intro
#@export_tool_button('Reset') var reset_intro = reset_intro_func
@onready var incidental_music: AudioStreamPlayer = $incidental_music

@export var _volume := -5.0

var reset := true

signal intro_finished

func play_intro() -> void:
	$incidental_music.volume_db = _volume
	if !reset:
		return
		
	reset = false
	$dateCard.visible = true
	incidental_music.play()
	
	var tween = create_tween().set_ease(Tween.EASE_OUT)
	tween.tween_interval(6.0)
	tween.tween_property($black_panel_covering_title, \"modulate\", Color('FFFFFF00'), 5.0).set_ease(Tween.EASE_IN)
	tween.tween_interval(2.0)
	#tween.tween_property($black_panel_covering_title, \"modulate\", Color('FFFFFF'), 1.0)
	tween.tween_property($dateCard, \"modulate\", Color('FFFFFF00'), 6.0)
	#tween.parallel().tween_property($black_panel_covering_title, \"modulate\", Color('FFFFFF00'), 3.0)
	
	tween.parallel().tween_property(self, \"modulate\", Color('FFFFFF00'), 6.0)
	await tween.finished
	intro_finished.emit()



func reset_intro_func() -> void: 
	incidental_music.stop()
	reset = true
	modulate = Color('FFFFFF')
	$dateCard.visible = false
"

