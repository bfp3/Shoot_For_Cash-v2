[sub_resource type="GDScript" id="GDScript_la35k"]
script/source = "extends Node3D

func _ready() -> void:
	#$Flag_particles.emitting = true
	$Yellow_particles.emitting = true
	
func _on_flag_particles_finished() -> void:
	$Flag_particles.queue_free()

func _on_yellow_particles_finished() -> void:
	$Yellow_particles.queue_free()

func _on_timer_timeout() -> void:
	self.queue_free()
"

