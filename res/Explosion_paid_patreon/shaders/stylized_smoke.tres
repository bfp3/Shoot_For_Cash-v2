[gd_resource type="Shader" format=3 uid="uid://dvtjy1mbusnag"]

[resource]
code = "shader_type spatial;
render_mode blend_mix,depth_draw_opaque,cull_back,diffuse_burley,specular_schlick_ggx,unshaded;

uniform sampler2D texture_albedo : source_color,filter_linear_mipmap,repeat_enable;
uniform vec4 albedo : source_color;

uniform vec3 uv1_offset;
uniform vec3 uv1_scale;
uniform vec3 uv2_scale;
uniform vec3 uv2_offset;

uniform sampler2D depth_texture : hint_depth_texture, repeat_disable, filter_nearest;
uniform float proximity_fade_distance;

uniform sampler2D noise;
uniform sampler2D noise_offset_curve;
uniform sampler2D smoothstep_curve;
uniform sampler2D fresnel_color;
uniform sampler2D color_curve;

varying float lifetime_percent;

void vertex() {
	lifetime_percent = INSTANCE_CUSTOM.y;
	UV = UV * uv1_scale.xy + uv1_offset.xy;
}

float fresnel(float amount, vec3 normal, vec3 view)
{
	return pow((1.0 - clamp(dot(normalize(normal), normalize(view)), 0.0, 1.0 )), amount);
}

void fragment() {
	vec2 base_uv = UV;
	
	// Main Albedo
	vec4 albedo_tex = texture(texture_albedo, base_uv);
	albedo_tex *= COLOR;
	ALBEDO = albedo.rgb * albedo_tex.rgb;
	//
	
	// Depth Fade
	float depth_tex = textureLod(depth_texture, SCREEN_UV, 0.0).r;
	vec4 world_pos = INV_PROJECTION_MATRIX * vec4(SCREEN_UV * 2.0-1.0, depth_tex, 1.0);
	world_pos.xyz /= world_pos.w;
	
	float depth_fade = clamp(1.0-smoothstep(world_pos.z+proximity_fade_distance,world_pos.z,VERTEX.z),0.0,1.0);
	//
	
	float fresnel_value = fresnel(1, NORMAL, VIEW);
	fresnel_value = pow(fresnel_value, 2);
	//fresnel_value = step(0.3, fresnel_value);
	
	vec3 fresnel_color_value = fresnel_value * texture(fresnel_color, vec2(0.0, 0.0)).rgb;
	//ALBEDO = clamp(mix(ALBEDO, fresnel_color_value, fresnel_value), 0, 1);
	
	ALBEDO *= texture(color_curve, vec2(lifetime_percent)).rgb; 
	
	float noise_offset_y = texture(noise_offset_curve, vec2(lifetime_percent)).r;
	noise_offset_y *= 2.0;
	vec3 noise_tex = texture(noise, base_uv + vec2(0.0, noise_offset_y)).rgb;
	//noise_tex += pow(1.0 - UV.g, 3.0);
	
	float smoothstep_min = texture(smoothstep_curve, vec2(lifetime_percent)).r;
	float smoothstep_max = smoothstep_min + 0.2;
	
	ALPHA = smoothstep(smoothstep_min, smoothstep_max, noise_tex).r;
	ALPHA *= (1.0 - fresnel_value);
	ALPHA *= depth_fade;
	ALPHA *= 1.0 - lifetime_percent;
}"
