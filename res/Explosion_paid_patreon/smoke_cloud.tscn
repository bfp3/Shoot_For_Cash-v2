[sub_resource type="Shader" id="Shader_uxllw"]
code = "// NOTE: Shader automatically converted from Godot Engine 4.2.dev's CanvasItemMaterial.

shader_type canvas_item;
render_mode blend_mix;

void fragment()
{
	vec4 tex = texture(TEXTURE, UV);
	float grayscale = clamp((tex.r + tex.g + tex.b) * 0.3333f, 0.0, 1.0);
	float step_val = step(0.75, 1.0 - grayscale);
	
	COLOR = vec4(vec3(step_val), 1.0);
}"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_1cyss"]
