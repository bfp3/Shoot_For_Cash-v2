[sub_resource type="GDScript" id="GDScript_3fk7o"]
script/source = "extends Node3D


var amount_of_hits_taken := 0

func _ready() -> void:
	var egg_cage = get_tree().get_first_node_in_group('Egg_Cage')
	egg_cage.taken_a_hit_from_a_target.connect(taken_a_hit)
	
func taken_a_hit() -> void:
	amount_of_hits_taken += 1

func reduce_health_star() -> void:
	var children = get_children()
	children.reverse()
	
	if amount_of_hits_taken > 0:
		for damage in range(amount_of_hits_taken):
			for i in children:
				if i.modulate == Color('FFFFFF'):
					remove_star(i)
					
					break
			
				else:
					pass
					
			await get_tree().create_timer(2.0).timeout
	
	amount_of_hits_taken = 0
	children.reverse()

func remove_star(decal : Decal) -> void:
	var dur : float = 2.0
	var tween = create_tween().set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT)
	tween.tween_property(decal, \"modulate\", Color('FFFFFF00'), dur)
	tween.parallel().tween_property(decal, \"global_position:y\", -0.1, dur).as_relative()
	await tween.finished
	
	decal.hide()
"

