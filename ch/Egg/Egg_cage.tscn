[sub_resource type="GDScript" id="GDScript_xadgt"]
script/source = "extends Node

@onready var decals: Array[Decal] = [
	$\"../Egg_shape/Decal_Container/Decal\", 
	$\"../Egg_shape/Decal_Container/Decal2\", 
	$\"../Egg_shape/Decal_Container/Decal3\", 
	$\"../Egg_shape/Decal_Container/Decal4\", 
	$\"../Egg_shape/Decal_Container/Decal5\"
]

var decal_index := 0

func _ready() -> void:
	for decal in decals:
		decal.visible = false
		decal.modulate.a = 0.0  # fully transparent

func taken_damage() -> void:
	if decal_index >= decals.size():
		return

	var count = min(2, decals.size() - decal_index)
	for i in range(count):
		var current_decal := decals[decal_index]
		current_decal.visible = true

		var tween := create_tween()
		tween.tween_property(current_decal, \"modulate:a\", 1.0, 0.2)

		decal_index += 1
"

