script/source = "extends StaticBody3D

const ARROW_AREA_3D = preload(\"res://ch/weapons/bullet_area3D.tscn\")

@export var arrow_speed := 25.0

#var spawned_arrows: Array[Area3D] = []
var spawned_my_own_arrow := false
var new_arrow = null

var shield_damage := 3
#
#func _ready() -> void:
	#add_to_group('Target')
#
##func add_unique_marker(pos: Vector3) -> void:
	##$Unique_marker.global_position = pos
#
#func spawn_my_arrow() -> void:
	#new_arrow = ARROW_AREA_3D.instantiate()
	#var player_gun = get_tree().get_first_node_in_group(\"player_gun\")
	#
	#new_arrow.global_position = player_gun.get_barrel_position()
	#get_tree().get_current_scene().add_child(new_arrow)
	#
	#spawned_my_own_arrow = true
	#
#func _physics_process(delta: float) -> void:
	#var target = $Power_up.global_position
	#
	#if spawned_my_own_arrow && new_arrow:
		#var direction = (target - new_arrow.global_position).normalized()
		#new_arrow.global_position += direction * arrow_speed * delta
		#new_arrow.look_at(target, Vector3.UP, true)
		#
#
#func _on_power_up_area_entered(area: Area3D) -> void:
	#if area.is_in_group('bullet'):
		#if $'../CSGBox3D'.visible:
			#return
		#$Power_up.hide()
		#area.queue_free()
		#if area.has_method('cleanUp'):
			#area.cleanUp()
		#
		#$'../CSGBox3D'.show()
		#$'../Area3D'.monitoring = false
		#$'../Area3D'.monitorable = false
		#print('this shouldnt happen')
#
#func shield_broken() -> void:
	#$'../CSGBox3D'.hide()
	#$'../Area3D'.monitoring = true
	#$'../Area3D'.monitorable = true
	#spawned_my_own_arrow = false
#
#
#func _on_area_3d_2_body_entered(body: Node3D) -> void:
	#if $'../CSGBox3D'.visible && body.is_in_group('cannonball'):
		#shield_damage -= 1
		#if shield_damage <= 0:
			#shield_broken()
			#
"

