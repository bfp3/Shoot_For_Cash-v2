[sub_resource type="GDScript" id="GDScript_rt7tu"]
script/source = "extends Decal

@export var dur := 10.0

func _ready() -> void:
	
	var tween = create_tween().set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_CUBIC).set_loops()
	tween.tween_property(self, \"scale\", Vector3.ONE, 0.01)
	tween.tween_property(self, \"modulate\", Color('FFFFFF20'), 0.25)
	tween.tween_property(self, \"scale\", Vector3(5.0, 1.0, 5.0), dur)
	tween.parallel().tween_property(self, \"modulate\", Color.TRANSPARENT, dur)
	await tween.finished
"

