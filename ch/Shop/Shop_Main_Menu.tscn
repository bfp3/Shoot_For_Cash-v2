[sub_resource type="GDScript" id="GDScript_hi3s5"]
script/source = "extends RichTextLabel

var grand_total : int = 0
var subtitle := 'Winnings '.to_upper()

func _ready() -> void:
	text = \"[i]\" + subtitle + \"[color=#c70102]$0[/color][/i]\"

func add_to_total() -> void:
	var round_bonus := int(gl_DataSet.get_value(\"reward_perfect_round\"))
	var round_winnings := int(gl_PlayerState.dataset.bonus_cash - gl_PlayerState.dataset.fines + round_bonus)

	gl_PlayerState.update_total_winnings(round_winnings)
	grand_total = gl_PlayerState.dataset.total_winnings

	text = \"[i]\" + subtitle + \"[color=#c70102]$\" + str(grand_total) + \"[/color][/i]\"

func restart() -> void:
	grand_total = 0
	text = \"[i]\" + subtitle + \"[color=#c70102]$0[/color][/i]\"
"

