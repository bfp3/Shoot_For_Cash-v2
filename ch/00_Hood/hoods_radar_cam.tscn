[gd_scene format=3 uid="uid://b8wsqilwdafne"]

[ext_resource type="AudioStream" uid="uid://mhsf5awldcrd" path="res://sfx/opt_3_fade.wav" id="1_6cyma"]


[sub_resource type="GDScript" id="GDScript_dpvnf"]
script/source = "extends Node3D
const GUN_SFX_ATTEMPT_2 = preload(\"res://400_sounds/gun_sfx/Gun_SFX_attempt_2.wav\")
var active := false

func _ready() -> void:
	send_radar_cam()
	
func send_radar_cam() -> void:
	if active:
		return
		
	CommonCode.play_sound_duplicate_instance($shoot_radar_drone, 0.0, -20.0)
	var radar_marker_pos = get_tree().get_first_node_in_group('radar_marker_pos')
	$propeller/AnimationPlayer.play('idle')
	active = true
	show()
	scale = Vector3.ZERO
	var tween = create_tween().set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT)
	tween.tween_property(self, \"scale\", Vector3.ONE, 1.5)
	tween.parallel().tween_property(self, \"global_position\", radar_marker_pos.global_position, 5.0)
	await tween.finished
	var radar_view = get_tree().get_first_node_in_group('radar_subviewport')
	if radar_view:
		radar_view.modulate = Color('FFFFFF00')
		radar_view.show()
		var tween_2 = create_tween().set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT)
		tween_2.tween_property(radar_view, \"modulate\", Color('FFFFFF'), 3.0)
		await tween_2.finished

func destroy_self() -> void:
	print_debug('hit something, going down')
	get_parent().remove_child(self)
	self.queue_free()

func _on_area_3d_body_entered(body: Node3D) -> void:
	if body.is_in_group('bullet'):
		destroy_self()
		
	if body.is_in_group('Target'):
		destroy_self()


func _on_area_3d_area_entered(area: Area3D) -> void:
	destroy_self()
"

