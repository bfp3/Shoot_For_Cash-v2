[sub_resource type="GDScript" id="GDScript_f3vr7"]
script/source = "extends Node

const RELOAD_SFX = preload(\"res://400_sounds/00_sfx/gunLocked.wav\")

@export var max_number_of_bullets_per_cartridge: int = 6
@export var max_number_of_cartridges: int = 3
var current_amount_of_cartridges_remaining: int = max_number_of_cartridges
var current_amount_of_ammo_remaining: int = max_number_of_cartridges * max_number_of_bullets_per_cartridge
var reloading: bool = false
var out_of_ammo: bool = false
@export var out_of_ammo_duration: float = 5.00  # Time before player gets backup ammo
@onready var reload_sound: AudioStreamPlayer = $reload_sound

var total_bullets: int = max_number_of_cartridges * max_number_of_bullets_per_cartridge  # 18 max bullets
var ammo_remaining: int = total_bullets  # Current ammo

@export var start_amount_bullets := 6.0
@onready var visual_component = $visual_component

var dev_mode := false

func _ready() -> void:
	if dev_mode:
		ammo_remaining = 1000
	else:
		pass
	
	#await get_tree().create_timer(0.05).timeout
	#visual_component.update_ammo_display(current_amount_of_ammo_remaining, current_amount_of_cartridges_remaining)

func game_started() -> void:
	current_amount_of_ammo_remaining = start_amount_bullets
	
	visual_component.game_started_update()
	set_process(true)  # Start processing for auto-reload

#func _process(delta: float) -> void:
	
	#if reloading_active:
		#reload_progress += (delta / reload_duration) * 100
		#ammo_auto_reload.value = reload_progress
		#
		#if reload_progress >= 100:
			#gain_extra_bullet()


#func gain_extra_bullet() -> void:
	#
	#current_amount_of_ammo_remaining = clamp(current_amount_of_ammo_remaining + 1, 0, max_number_of_bullets_per_cartridge)
	#reload_progress = 0  # Reset progress
	#reload_duration = max(0.5, reload_duration - 0.5)  # Reduce duration each cycle
	#reload_duration = clamp(reload_duration, 5.0, 100.0)
	##visual_component.update_ammo_display(current_amount_of_ammo_remaining, current_amount_of_cartridges_remaining)
	#visual_component.gain_an_ammo()
	#CommonCode.play_sound_instance_await_time(RELOAD_SFX, -30.0, 0.05, 0.76)
	#GlobalsPlayerStats.player_gold += 1
	
func check_can_shoot() -> bool:
	
	if dev_mode:
		current_amount_of_ammo_remaining += 1
		return true
	
	if current_amount_of_ammo_remaining > 0 || !out_of_ammo:
		$ProgressBar.reset_current_progress()
		#reload_progress = 0  # Reset reload progress on shooting
		#ammo_auto_reload.value = 0
		return true  # Ammo available, can shoot
	else:
		$out_of_ammo_sound.play()
		visual_component.show_out_of_ammo_effect()
		return false  # Cannot shoot

		
func deduct_ammo() -> void:
	if out_of_ammo:
		return
	current_amount_of_ammo_remaining = clamp(current_amount_of_ammo_remaining - 1, 0, max_number_of_bullets_per_cartridge)
	if current_amount_of_ammo_remaining == 0:
		if current_amount_of_cartridges_remaining > 0:
			visual_component.update_ammo_display(current_amount_of_ammo_remaining, current_amount_of_cartridges_remaining)
			current_amount_of_cartridges_remaining -= 1
			current_amount_of_ammo_remaining = max_number_of_bullets_per_cartridge
			return
		else:
			out_of_ammo = true
			enter_out_of_ammo_mode()

	visual_component.update_ammo_display(current_amount_of_ammo_remaining, current_amount_of_cartridges_remaining)

func enter_out_of_ammo_mode() -> void:
	visual_component.reload_ammo(current_amount_of_ammo_remaining)
	out_of_ammo = true
	visual_component.show_out_of_ammo_effect()
	await get_tree().create_timer(out_of_ammo_duration).timeout
	current_amount_of_ammo_remaining = 0 # 3  # After waiting, player gets 3 bullets
	#visual_component.update_ammo_display(current_amount_of_ammo_remaining, current_amount_of_cartridges_remaining)
	visual_component.reload_ammo(current_amount_of_ammo_remaining)
	visual_component.reload_cartridges(current_amount_of_cartridges_remaining)
	out_of_ammo = false

func reload() -> void:
	visual_component.update_ammo_display(current_amount_of_ammo_remaining, current_amount_of_cartridges_remaining)
	print(current_amount_of_ammo_remaining)
	return
	#if reloading:
		#return
	#reloading = true
	#
	#var missing_bullets = total_bullets - ammo_remaining
	#if missing_bullets == 0:
		#reloading = false
		#return  # Already full
#
	#var bullets_to_reload = min(max_number_of_bullets_per_cartridge, missing_bullets)
	#ammo_remaining += bullets_to_reload
#
	#visual_component.update_ammo_display(current_amount_of_ammo_remaining, current_amount_of_cartridges_remaining)
	#reloading = false

func add_cartridge() -> void:
	
	var missing_bullets = total_bullets - ammo_remaining
	if missing_bullets > 0:
		var bullets_to_add = min(max_number_of_bullets_per_cartridge, missing_bullets)
		ammo_remaining += bullets_to_add
		visual_component.update_ammo_display(current_amount_of_ammo_remaining, current_amount_of_cartridges_remaining)
"

[sub_resource type="GDScript" id="GDScript_el5ri"]
script/source = "extends Control

const RELOAD_SOUND = preload(\"res://400_sounds/Placeholder_SFX/Target_shot_out_of_device_7.wav\")

@onready var ammo_container_hbox: HBoxContainer = $Ammo_container
@onready var cartridge_amount_container: HBoxContainer = $Cartridge_amount_container
@onready var ammo_single_unit: Panel = $ammo_unit
@onready var cartridge_unit: Panel = $cartridge_unit

@onready var reload_sound: AudioStreamPlayer = $\"../reload_sound\"

@onready var cartridge_label: Label = $cartridge_label
@onready var ammo_label: Label = $ammo_label

var ammo_remaining := 0
var cartridge_remaining := 0
var first_reload_completed := false

func _ready() -> void:
	#await get_tree().create_timer(0.05).timeout
	pass
	
func game_started_update() -> void:
	ammo_remaining = get_parent().current_amount_of_ammo_remaining
	cartridge_remaining = get_parent().current_amount_of_cartridges_remaining

	first_load()
	await get_tree().create_timer(5.0).timeout
	$\"../reload_sound\".volume_db = -27.0

func first_load() -> void:
	$\"../reload_sound\".volume_db = -80.0
	clear_ui_elements()
	reload_ammo(ammo_remaining)
	reload_cartridges(cartridge_remaining)
	update_labels()
	update_hbox_positions()
	first_reload_completed = true
	
func update_ammo_display(ammo_count: int, cartridge_count: int) -> void:
	ammo_remaining = ammo_count
	cartridge_remaining = cartridge_count

	if ammo_remaining == 0 and cartridge_remaining > 0:
		reload_from_cartridge()
	elif ammo_remaining == 0:
		show_out_of_ammo_effect()
	else:
		remove_last_ammo()

	update_labels()
	update_hbox_positions()
	
func gain_an_ammo() -> void:
	ammo_remaining = clamp(ammo_remaining + 1, 0, get_parent().max_number_of_bullets_per_cartridge)
	if ammo_remaining >= 6:
		if cartridge_remaining >= 3:
			#reload_fast(ammo_remaining)
			update_labels()
			return
		else:
			add_cartrige()
	else:
		reload_fast(ammo_remaining)
		update_labels()
	#var new_ammo = ammo_container_hbox.get_children().back().duplicate()
	#ammo_container_hbox.add_child(new_ammo)

func add_cartrige() -> void:
	pass

func reload_from_cartridge() -> void:
	cartridge_remaining -= 1
	ammo_remaining = 6
	reload_ammo(6)
	reload_cartridges(cartridge_remaining)

func remove_last_ammo() -> void:
	var last_ammo = ammo_container_hbox.get_children().back()
	if last_ammo:
		send_to_tween(last_ammo)

func reload_ammo(count: int) -> void:
	clear_ammo()
	var volume = -80.0
	if first_reload_completed:
		volume = -27.0
	
	await get_tree().create_timer(0.5).timeout
	for _i in range(count):
		var new_ammo = ammo_single_unit.duplicate()
		ammo_container_hbox.add_child(new_ammo)
		new_ammo.show()
		#reload_sound.play()
		CommonCode.play_sound_instance_pitch_adjusted(RELOAD_SOUND, volume, 1.5)
		await get_tree().create_timer(0.1).timeout
	

func reload_fast(count: int) -> void:
	clear_ammo()
	for _i in range(count):
		var new_ammo = ammo_single_unit.duplicate()
		ammo_container_hbox.add_child(new_ammo)
		new_ammo.show()
		reload_sound.play()
		await get_tree().create_timer(0.05).timeout

func reload_cartridges(count: int) -> void:
	clear_cartridges()
	for _i in range(count):
		var new_cartridge = cartridge_unit.duplicate()
		cartridge_amount_container.add_child(new_cartridge)
		new_cartridge.show()
		reload_sound.play()
		await get_tree().create_timer(0.05).timeout

func send_to_tween(last_ammo: Panel) -> void:
	var dur : float = 0.5
	var tween = create_tween().set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT)
	tween.tween_property(last_ammo, \"scale\", Vector2.ONE * 1.25, dur)
	tween.parallel().tween_property(last_ammo, \"modulate\", Color('FFFFFF00'), dur)
	tween.parallel().tween_property(last_ammo, \"position:x\", 50.0, dur).as_relative()
	#tween.parallel().tween_property(last_ammo, \"position:y\", -50.0, dur).as_relative()
	#tween.parallel().tween_property(last_ammo, \"position:y\", -50.0, dur).as_relative()
	tween.tween_callback(last_ammo.queue_free)
	await tween.finished

func show_out_of_ammo_effect() -> void:
	modulate = Color.RED
	await get_tree().create_timer(0.5).timeout
	modulate = Color.WHITE

func update_labels() -> void:
	#ammo_label.text = \"0\" + str(ammo_remaining)
	$ammo_label2.text = \"0\" + str(ammo_remaining)
	cartridge_label.text = str(cartridge_remaining)

func update_hbox_positions() -> void:
	
	ammo_container_hbox.position = $\"../Ammo_marker\".position
	ammo_label.position = ammo_container_hbox.position - Vector2(-2, 110)
	cartridge_amount_container.position = $\"../Cartridge_marker\".position
	cartridge_label.position = cartridge_amount_container.position - Vector2(10, 35)

func clear_ui_elements() -> void:
	clear_ammo()
	clear_cartridges()

func clear_ammo() -> void:
	for child in ammo_container_hbox.get_children():
		child.queue_free()

func clear_cartridges() -> void:
	for child in cartridge_amount_container.get_children():
		child.queue_free()
"

