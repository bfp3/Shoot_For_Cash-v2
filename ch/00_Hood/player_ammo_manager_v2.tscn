[sub_resource type="GDScript" id="GDScript_lqmfg"]
resource_name = "progress_bar_script"
script/source = "extends ProgressBar

@onready var ammo_auto_reload := self

@export var reload_duration: float = 20.0  # Initial duration to reach 100
var reload_progress: float = 0.0
var reloading_active: bool = true

func _ready() -> void:
	ammo_auto_reload.value = 0
	
func _process(delta: float) -> void:
	$ammo_label.text = \"x\" + str(GlobalsPlayerStats.player_progress_bar_multi)
	if reloading_active:
		reload_progress += (delta / reload_duration) * 100
		ammo_auto_reload.value = reload_progress
		
		if reload_progress >= 100:
			increase_multiplier()

func reset_current_progress() -> void: 
	reload_progress = 0
	ammo_auto_reload.value = 0

func increase_multiplier() -> void:
	reload_progress = 0  # Reset progress
	reload_duration = max(0.5, reload_duration - 0.5)  # Reduce duration each cycle
	reload_duration = clamp(reload_duration, 5.0, 100.0)
	#visual_component.update_ammo_display(current_amount_of_ammo_remaining, current_amount_of_cartridges_remaining)
	#CommonCode.play_sound_instance_await_time(RELOAD_SFX, -30.0, 0.05, 0.76)
	GlobalsPlayerStats.player_progress_bar_multi += 1
"

