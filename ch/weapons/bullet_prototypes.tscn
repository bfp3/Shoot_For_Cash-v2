script/source = "extends Area3D

@export var speed: float = 0.3	  # Base speed of the projectile
@export var arc_strength: float = 0.1 # Controls how high the arc goes

@export var total_time: float = 2.0

var target_pos: Vector3
var velocity: Vector3
var travel_time: float  # Time to reach target
var start_pos: Vector3
var hit_something: bool = false

var points: Array = []
var num_points: int = 50

var tween : Tween = null
@export var constant_speed := false

func shoot(target : Vector3):
	start_pos = global_position
	
	target_pos = target
	var distance = start_pos.distance_to(target_pos)
	# Adjust total_time dynamically if constant_speed is enabled
	if constant_speed:
		var reference_distance = 17.5  # Midpoint of 15-20
		var reference_time = 2.0
		total_time = max(0.3, (distance / reference_distance) * reference_time)  # Prevents time from going too low
	
	await points_array_setup(start_pos, target_pos)
	# Calculate distance and required travel time
	#var distance = start_pos.distance_to(target_pos)
	#travel_time = distance / speed  / 10 # Estimate time based on speed
	#print(travel_time)
	## Calculate initial velocity to reach target at the right time
	#velocity = (target_pos - start_pos) / travel_time
	#
	## Add an arc (adjust Y velocity to create a curve)
	#velocity.y = (4 * arc_strength * distance) / travel_time
	#
	## Rotate to face movement direction
	
	tween_shot()

func points_array_setup(start_pos: Vector3, end_pos: Vector3) -> Array:
	var distance = start_pos.distance_to(end_pos)
	var h_max = distance * arc_strength 

	for i in range(1, num_points):
		var t = float(i) / num_points  
		var x = lerp(start_pos.x, end_pos.x, t)
		var z = lerp(start_pos.z, end_pos.z, t)
		var y = lerp(start_pos.y, end_pos.y, t) + h_max * (1 - (2 * t - 1) ** 2)
		points.append(Vector3(x, y, z))
	
	points.append(end_pos)
	return points
	

func tween_shot() -> void:
	if points.is_empty():
		print(\"EMPTY\")
		return
	
	  # 3 seconds duration
	var step_time: float = total_time / num_points
	
	tween = create_tween()
	tween.set_trans(Tween.TRANS_LINEAR)
	tween.set_ease(Tween.EASE_IN_OUT)
	
	for i in range(points.size()):
		if hit_something:
			break
		
		#print(step_time)
		step_time = clamp(step_time, 0.0, 0.03)
		if i > 26 && i < 42:
			step_time = step_time - 0.0015
			
			#print(step_time)
		tween.tween_property($Marker3D, \"global_position\", points[i], 0.001)
		tween.tween_property(self, \"global_position\", points[i], step_time)
	
	await tween.finished
	expand_area()
	
	
func expand_area() -> void:
	var tweeny = create_tween()
	tweeny.tween_property($CollisionShape3D2, \"scale\", Vector3.ONE * 3, 0.1)
	await tweeny.finished
	cleanUp()
	
func _physics_process(delta: float):
	#if hit_something:
		#return
#
	## Apply gravity effect over time
	#velocity.y -= (arc_strength * 9.8) * delta
#
	## Move the projectile
	#global_position += velocity * delta
#
	## Check collisions
	if $Mesh.global_position != $Marker3D.global_position:
		$Mesh.look_at($Marker3D.global_position, Vector3.UP, true)


func _on_body_entered(body: Node):
	hit_something = true
	queue_free()  # Destroy the projectile


func _on_timer_timeout() -> void:
	if tween:
		tween.kill()
	$Mesh.hide()
	hide()
	await get_tree().create_timer(1.0).timeout
	queue_free()
	
	
func cleanUp() -> void:
	trails_reparent()
	$CollisionShape3D2.call_deferred(\"set_disable_mode\", true)
	$Mesh.hide()
	hide()
	
	await get_tree().create_timer(1.0).timeout
	queue_free()

	
func trails_reparent() -> void:
	if $Trails:
		$Trails.connect_signal()
"

