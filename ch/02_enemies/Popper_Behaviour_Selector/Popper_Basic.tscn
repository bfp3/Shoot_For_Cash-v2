[sub_resource type="GDScript" id="GDScript_e1c4i"]
script/source = "extends Node3D

var current_tween: Tween = null

func _ready() -> void:
	EventBus.instance.egg_pulsed.connect(stop_tween)

func stop_tween() -> void:
	if current_tween and current_tween.is_running():
		current_tween.kill()
		rotation_degrees.x = 0.0





#func throw_projectile():
	#current_tween = create_tween()
	#current_tween.tween_property(self, \"rotation_degrees:x\", 133.0, 1.0).set_ease(Tween.EASE_OUT_IN)
#
	#current_tween.tween_interval(0.25)
	#current_tween.tween_property(rock, \"visible\", true, 0.01)
	#current_tween.tween_interval(0.25)
	#current_tween.tween_property(self, \"rotation_degrees:x\", 195.5, 0.1).set_ease(Tween.EASE_OUT)
	#current_tween.tween_property(self, \"rotation_degrees:x\", 25.0, 0.3).set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_BACK)
	#current_tween.tween_property(rock, \"visible\", false, 0.01)
	#await current_tween.finished
#
	#rotation_degrees.x = 0.0
	#current_tween = null
	#return
"

