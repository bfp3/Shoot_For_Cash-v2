[sub_resource type="GDScript" id="GDScript_yfid5"]
script/source = "extends Node3D

@onready var rigidbody_doppleganger: RigidBody3D = $Rigidbody_doppleganger
@onready var stunned: Node3D = $'..'

func start(parent : StaticBody3D) -> void:
	%Mesh.hide()


func _on_finished() -> void:
	stunned._on_finished()
"

