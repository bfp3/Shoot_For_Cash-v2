[sub_resource type="GDScript" id="GDScript_0ewlc"]
script/source = "extends Node

func pick_turn_rot() -> Vector3:
	
	var rand_num : int = randi_range(0,1)
	
	if rand_num == 0:
		return Vector3(0.0, randf_range(-15.0,-45.0), 0.0)
		
	elif rand_num == 1:
		#return Vector3(45.0, 0.0, 0.0)
		return Vector3(0.0, randf_range(15.0,45.0), 0.0)
		
	else:
		return Vector3(0.0, randf_range(-15.0,-45.0), 0.0)


func head_turn_original() -> Vector3:
	var orig_rot : Vector3 = get_parent().rotation_degrees
	var target_rot : float
	var rand_num : int = randi_range(0,4)
	
	if rand_num == 0:
		return Vector3.ZERO
		
	elif rand_num == 1:
		#return Vector3(45.0, 0.0, 0.0)
		return Vector3(0.0, 45.0, 0.0)
		
	elif rand_num == 2:
		#return Vector3(45.0, 0.0, 0.0)
		return Vector3(0.0, -45.0, 0.0)
		
	elif rand_num == 3:
		return Vector3(0.0, 45.0, 0.0)
		
	elif rand_num == 4:
		return Vector3(0.0, -45.0, 0.0)
		
	else:
		return Vector3(0.0, 45.0, 0.0)
"

