[sub_resource type="GDScript" id="GDScript_p23d5"]
script/source = "extends Camera3D


@export var shake_amount := 3
@export var move_speed := 0.1

var cam_shake_tween : Tween = null
var orig_pos : Vector3

func _ready() -> void:
	orig_pos = global_position

func shake_camera() -> void:
	if cam_shake_tween:
		cam_shake_tween.kill()
		#return
	global_position = orig_pos
	cam_shake_tween = create_tween().set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_CUBIC)
	for i in range(shake_amount):
		cam_shake_tween.tween_property(self, \"global_position:z\", -1, move_speed).as_relative()
		cam_shake_tween.tween_property(self, \"global_position:z\", 1, move_speed).as_relative()
	await cam_shake_tween.finished
	global_position = orig_pos
"

