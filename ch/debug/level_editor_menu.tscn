[node name="RulesList" type="RichTextLabel" parent="Center/Cluster/RulesPanel/RulesVBox" unique_id=1888002104]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
bbcode_enabled = true
text = "[color=#C70102]COMMANDS[/color]
[color=#C70102]rock[/color]  basic rock

[color=#C70102]rock-black[/color] black rock / hazard

[color=#C70102]rock-pigeon[/color] / [color=#C70102]rock-pigeon 1 A8[/color]
flies into the distance (fan aim)

[color=#C70102]rock-avoider[/color] / [color=#C70102]rock-avoider 4 A3[/color]
chases the crosshair — keep the reticle off it or take a strike

[color=#C70102]rock-chaser[/color] / [color=#C70102]rock-chaser 3 A2[/color]
flees the reticle — hold aim on it for 2s, then shoot

[color=#C70102]rock-juggle[/color] / [color=#C70102]rock-juggle 4 B3[/color]
independent tank rock (100 HP) — does not block wait / wait-until-clear and ignores splash miss

[color=#C70102]smokecan[/color] / [color=#C70102]smokecan 3 A4[/color]
smoke can obstacle

[color=#C70102]crate[/color] / [color=#C70102]crate 2 A4[/color]
crate rock — crate mesh and crate burst particles

[color=#C70102]wait[/color]
hold the next command until live rocks / pineapples / balloon-checks are gone (oranges and balloons ignored)

[color=#C70102]wait 200[/color]
delay that many milliseconds before the next rock

[color=#C70102]balloon-check[/color] / [color=#C70102]balloon-check A4[/color]
appears until shot — optional cell uses the balloon grid (A1–C8); bare uses the default centre. Saves progress so a strike-out resumes from here (does not start a new round, does not send balloons away)

[color=#C70102]ammo[/color] / [color=#C70102]ammo 16[/color] / [color=#C70102]ammo 69 $100[/color] / [color=#C70102]ammo C8 16 99[/color]
ammo balloon (default C6). Shoot it to buy ammo. Amount/price default from power_ammo / price_ammo

[color=#C70102]clear ammo[/color]
pop leftover ammo balloons with no ammo and no charge

[color=#C70102]clear[/color]
send leftover balloons away (+$10 each)

[color=#C70102]clear balloon A4[/color]
send away the balloon at that cell if one is there (+$10)

[color=#C70102]repeat[/color] / [color=#C70102]repeat 3[/color]
section = N separate waves
(bare/1/2 = 2, else N)
multiple repeats = more waves

[color=#C70102]balloon[/color] / [color=#C70102]balloon A1[/color] / [color=#C70102]balloon ?[/color]
place a balloon (bare = random)

[color=#C70102]no-lives[/color] no strikes this round

[color=#C70102]pineapples[/color]
no-strike last rock starts a pineapple bonus before balloon-check

[color=#C70102]pace-slowest[/color] gravity 0.25
[color=#C70102]pace-slow[/color] gravity 0.5
[color=#C70102]pace-normal[/color] gravity 1.0
[color=#C70102]pace-fast[/color] gravity 1.5
[color=#C70102]pace-fastest[/color] gravity 2.25 (old difficulty-expert)
[color=#C70102]pace-impossible[/color] gravity 3.0
from that line on, later rocks use that speed

[color=#C70102]shuffle[/color] randomise columns on later waves

[color=#C70102]surprise-me[/color] generate a random test round

[color=#C70102]bonus-type1[/color] bonus target round (no strikes)

[color=#C70102]bonus-target[/color] / [color=#C70102]bonus-target a4 a8 c1[/color]
one target per line (bare = still)

[color=#C70102]PARAMETERS[/color]
[color=#C70102]?[/color] = leave to the game (random)

[color=#C70102]rock[/color] = [color=#C70102]rock ? ?[/color]
random column, aim row A + random column

[color=#C70102]rock 2[/color] = [color=#C70102]rock 2 ?[/color]
column 2, aim row A + random column

[color=#C70102]rock ? A4[/color]
random column, aim A4
(not [color=#C70102]rock A4[/color] — needs ?)

[color=#C70102]rock 2 A8[/color]
column 2, aimed at A8

[color=#C70102]balloon[/color] / [color=#C70102]balloon ?[/color]
random cell

[color=#C70102]AIM CELLS A / B / C[/color]
row letter + column 1–8
e.g. A1, B4, C8













"
fit_content = true

