[node name="RulesList" type="RichTextLabel" parent="Center/Cluster/RulesPanel/RulesVBox" unique_id=1888002104]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
bbcode_enabled = true
text = "[color=#C70102]COMMANDS[/color]
[color=#C70102]rock[/color]  basic rock

[color=#C70102]rock-black[/color] black rock / hazard

[color=#C70102]rock-pigeon[/color] rock that flies into the distance

[color=#C70102]wait[/color] / [color=#C70102]wait 200[/color] delay before next action default 100ms

[color=#C70102]repeat[/color] / [color=#C70102]repeat 3[/color] how many waves in the round default 3

[color=#C70102]balloon[/color] / [color=#C70102]balloon A1[/color] place a balloon default A1

[color=#C70102]PARAMETERS[/color]
[color=#C70102]rock 2[/color]
spawn at column 2
(omit number = random column)

[color=#C70102]rock 2 A8[/color]
column 2, aimed at cell A8

[color=#C70102]rock A8[/color]
aim only — spawn defaults to column 1

[color=#C70102]AIM CELLS A / B / C[/color]
row letter + column 1–8
e.g. A1, B4, C8"
fit_content = true

