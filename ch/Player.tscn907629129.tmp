[sub_resource type="GDScript" id="GDScript_phc0d"]
script/source = "extends GPUParticles3D

var duplicate_particles := true

func _ready():
	await get_tree().create_timer(0.1).timeout
	emitting = true
	one_shot = true
	await finished
	_on_finished()

func _on_finished() -> void:
	if duplicate_particles:
		self.queue_free()
"

