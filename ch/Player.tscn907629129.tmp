[sub_resource type="GDScript" id="GDScript_1lfbp"]
script/source = "extends Control
#
#@onready var bullets_remaining_label: Label = $bullets_remaining/bullets_remaining_label
#@onready var current_ammo_label: Label = $ammo_label
#@onready var ammo_container: HBoxContainer = $visual_component/PanelContainer/MarginContainer/Ammo_container
#@onready var ammo_unit: Panel = $visual_component/ammo_unit
#@onready var bonus_ammo_sfx: AudioStreamPlayer = $bonus_ammo
#@onready var visual_component: Control = $visual_component
#
#@onready var reload_sound: AudioStreamPlayer = $reload_sound
#@onready var deload_sound: AudioStreamPlayer = $deload_sound
#@onready var out_of_ammo_sound: AudioStreamPlayer = $out_of_ammo_sound
#
#@export var max_loaded_bullets: int = 6
#@export var total_reserve_bullets: int = 24
#
#@export var dev_mode := false
#
#@export var new_ammo_container : Control
#@onready var new_ammo_display = new_ammo_container.get_script()
#
#
#var orig_pos : Vector2
#
#var first_reload := true
#var free_ammo_mode := false
#
#var bonus_ammo_amount := 1
#var current_loaded_bullets: int = 0
#var reserve_bullets: int = total_reserve_bullets
#var label_orig_colour : Color
#var loading := true
#
#func _free_ammo_mode_start() -> void:
	#free_ammo_mode = true
	#$'../Ammo_panel_3D'._free_ammo_mode_start()
	#
#func _free_ammo_mode_finished() -> void:
	#$'../Ammo_panel_3D'._free_ammo_mode_finished()
	#free_ammo_mode = false
	#
#func update_global_ammo() -> void:
