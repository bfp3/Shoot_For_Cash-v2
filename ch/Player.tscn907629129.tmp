[sub_resource type="GDScript" id="GDScript_lfemk"]
script/source = "extends Node3D

@export var shake_amount := 1.0
@export var move_speed := 0.1

var shake_tween : Tween = null


func shake_gun() -> void:
	if shake_tween:
		shake_tween.kill()


	shake_tween = create_tween().set_trans(Tween.TRANS_CUBIC)
	shake_tween.tween_property($Rail_position, \"rotation_degrees:x\", shake_amount, 0.05).as_relative()
	shake_tween.tween_property($Rail_position, \"rotation_degrees:x\", 0.0, 0.15)
	await shake_tween.finished


func _process(delta: float) -> void:
	$Rail_position.global_position.y = 0.36
	$Rail_position.global_position.z = -0.36
"

