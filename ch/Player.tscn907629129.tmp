[sub_resource type="GDScript" id="GDScript_kbm6s"]
resource_name = "HUD_lamp"
script/source = "extends Control

@onready var hud_light_control: Control = $HUD_Light_Control

@export var lamp_off : Color = Color('ffffff15')
@export var lamp_on_brightest : Color = Color('ffffff')


@onready var new_light_flasher: TextureRect = $'../Ammo_panel_3D/Big_light/flashing_light'

var tween_pulse : Tween = null
var hud_light_on := false

func silence_phase_blinking() -> void:
	new_light_flasher.silence_phase_blinking()
	
	var tween = create_tween()
	tween.tween_interval(0.5)
	tween.tween_property(hud_light_control, \"modulate\", lamp_on_brightest, 0.1)
	tween.tween_property(hud_light_control, \"modulate\", lamp_off, 0.075)
	tween.tween_property(hud_light_control, \"modulate\", lamp_on_brightest, 0.3)
	tween.tween_property(hud_light_control, \"modulate\", lamp_off, 0.075 * 3)
	await tween.finished

func hud_lamp_on_phase():
	new_light_flasher.hud_lamp_on_phase()
	
	hud_light_on = true
	var tween = create_tween()
	tween.tween_interval(0.5)
	tween.tween_property(hud_light_control, \"modulate\", Color('FFFFFF'), 0.1)
	tween.tween_property(hud_light_control, \"modulate\", lamp_off, 0.075)
	tween.tween_property(hud_light_control, \"modulate\", Color('FFFFFF'), 0.3)
	tween.tween_property(hud_light_control, \"modulate\", lamp_off, 0.075 * 3)
	tween.tween_property(hud_light_control, \"modulate\", Color('FFFFFF'), 0.5)
	tween.tween_callback(pulse_ring)
	await tween.finished
	
	return

func pulse_ring() -> void:

	if !hud_light_on:
		return
	var new_pulse = $HUD_Light_Control/Pulse.duplicate()
	$HUD_Light_Control.add_child(new_pulse)
	new_pulse.modulate = Color('8a8a8a8a')
	
	tween_pulse = create_tween().set_ease(Tween.EASE_IN)
	tween_pulse.tween_property(new_pulse, \"modulate\", Color('FFFFFF00'), 1.5)
	tween_pulse.parallel().tween_property(new_pulse, \"scale\", Vector2.ONE * 2.0, 2.5)
	tween_pulse.tween_callback(new_pulse.queue_free)
	await tween_pulse.finished
	pulse_ring()

func hud_lamp_off_phase() -> void:
	if tween_pulse:
		tween_pulse.stop()
		tween_pulse.kill()
	if $HUD_Light_Control.get_children().size() > 4:
		$HUD_Light_Control.get_children().back().queue_free()
	hud_light_on = false
	
	var tween = create_tween().set_ease(Tween.EASE_OUT)
	tween.tween_property(hud_light_control, \"modulate\", lamp_off, 0.5)
	await tween.finished
	
func hud_lamp_settle_phase() -> void:
	new_light_flasher.silence_phase_blinking()
	
	var tween = create_tween()
	tween.tween_interval(0.5)
	tween.tween_property(hud_light_control, \"modulate\", Color('FFFFFF'), 0.1)
	tween.tween_property(hud_light_control, \"modulate\", lamp_off, 0.075)
	tween.tween_property(hud_light_control, \"modulate\", Color('FFFFFF'), 0.3)
	tween.tween_property(hud_light_control, \"modulate\", lamp_off, 0.075 * 3)
	await tween.finished
"

[sub_resource type="GDScript" id="GDScript_4g2aa"]
resource_name = "HUD_lamp_mini"
script/source = "extends Control

@onready var hud_light_control: Control = $HUD_Light_Control
@export var lamp_off : Color = Color('ffffff15')
@export var lamp_on_brightest : Color = Color('ffffff')



func shot_hit_blinking() -> void:
	var tween = create_tween()
	#tween.tween_interval(0.5)
	tween.tween_callback(pulse_ring)
	tween.tween_property(hud_light_control, \"modulate\", lamp_on_brightest, 0.1)
	tween.tween_property(hud_light_control, \"modulate\", lamp_off, 0.075)
	tween.tween_interval(0.1)
	tween.tween_callback(pulse_ring)
	tween.tween_property(hud_light_control, \"modulate\", lamp_on_brightest, 0.1)
	tween.tween_property(hud_light_control, \"modulate\", lamp_off, 0.075)
	tween.tween_interval(0.1)
	tween.tween_callback(pulse_ring)
	tween.tween_property(hud_light_control, \"modulate\", lamp_on_brightest, 0.3)
	tween.tween_property(hud_light_control, \"modulate\", lamp_off, 0.075 * 3)
	await tween.finished

func hud_lamp_on_phase():
	var tween = create_tween()
	tween.tween_interval(0.5)
	tween.tween_property(hud_light_control, \"modulate\", Color('FFFFFF'), 0.1)
	tween.tween_property(hud_light_control, \"modulate\", lamp_off, 0.075)
	tween.tween_property(hud_light_control, \"modulate\", Color('FFFFFF'), 0.3)
	tween.tween_property(hud_light_control, \"modulate\", lamp_off, 0.075 * 3)
	tween.tween_property(hud_light_control, \"modulate\", Color('FFFFFF'), 0.5)
	await tween.finished
	return	
	
func pulse_ring() -> void:
	var new_pulse = $HUD_Light_Control/Light2.duplicate()
	$HUD_Light_Control.add_child(new_pulse)
	new_pulse.modulate = Color('8a8a8a8a')
	
	var tween = create_tween().set_ease(Tween.EASE_IN)
	tween.tween_property(new_pulse, \"modulate\", Color('FFFFFF00'), 1.5)
	tween.parallel().tween_property(new_pulse, \"scale\", Vector2.ONE * 2.0, 2.5)
	await tween.finished
	if new_pulse:
		new_pulse.queue_free()

func hud_lamp_off_phase() -> void:
	var tween = create_tween().set_ease(Tween.EASE_OUT)
	tween.tween_property(hud_light_control, \"modulate\", lamp_off, 0.5)
	await tween.finished
	
func hud_lamp_settle_phase() -> void:
	var tween = create_tween()
	tween.tween_interval(0.5)
	tween.tween_property(hud_light_control, \"modulate\", Color('FFFFFF'), 0.1)
	tween.tween_property(hud_light_control, \"modulate\", lamp_off, 0.075)
	tween.tween_property(hud_light_control, \"modulate\", Color('FFFFFF'), 0.3)
	tween.tween_property(hud_light_control, \"modulate\", lamp_off, 0.075 * 3)
	await tween.finished
"

